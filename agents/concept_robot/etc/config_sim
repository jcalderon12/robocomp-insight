# This property is used by the clients to connect to IceStorm.
Proxies.TopicManager = "IceStorm/TopicManager:default -p 9999"

# Proxies for required interfaces
Proxies.CameraRGBDSimple = "camerargbdsimple:tcp -h localhost -p 10096"
Proxies.IMU = "imu:tcp -h localhost -p 10007"
Proxies.Lidar3D = "lidar3d:tcp -h localhost -p 11988"
Proxies.OmniRobot = "omnirobot:tcp -h localhost -p 10004"
Proxies.Webots2Robocomp = "webots2robocomp:tcp -h localhost -p 10006"

# Endpoints for subscriptions interfaces
Endpoints.FullPoseEstimationPubTopic = "tcp -p 0"
Endpoints.FullPoseEstimationPubPrefix = "base"


# --- Common Agent Data ---
Agent.id = 3
Agent.name = "concept_robot"

# --- Single Instance Configuration ---
# Use this if you only have one graph.
Agent.configFile = ""
Agent.domain = 0
Agent.tree = false
Agent.graph = false
Agent.2d = false
Agent.3d = false

# --- Multiple Instance Template ---
# If you define sub-instances, the single instance config above will be ignored.
# Agent.instance_name.configFile = ""
# Agent.instance_name.domain = 1
# Agent.instance_name.tree = true
# Agent.instance_name.graph = true
# Agent.instance_name.2d = true
# Agent.instance_name.3d = true


Period.Compute = 16
Period.Emergency = 500

Component.Debug.Verbose = true

Ice.Warn.Connections = "0"
Ice.Trace.Network = "0"
Ice.Trace.Protocol = "0"
Ice.MessageSizeMax = "20004800"

Simulated = True
print_extra_info = false
Desired_distance = 1000.0

# Fin de follow_person: segundos seguidos a la distancia deseada
Follow_hold_seconds = 3.0

# Misión de fotos (concept_robot::photo_spin()): el giro y las paradas. La captura y el
# etiquetado los hace el agente del concepto, que dispara en cada parada.
Photo_approach_distance = 2200.0
Verify_timeout_seconds = 30.0
# Si es true, una verificacion negativa no aborta: se hace el giro y las fotos igual (pruebas del clasificador).
Force_photos = false
Photo_angular_step = 5.0
Photo_settle_seconds = 0.7
Photo_spin_speed_factor = 0.1

# Lidar (helios + bpearl del puente, solo simulacion): sus puntos entran como obstaculos en el DWA
# y en el freno de seguridad. Se quedan los que estan entre Lidar_min_height (por debajo, suelo y
# baches, que los lleva el DSR) y Lidar_max_height, entre Lidar_self_radius (el propio robot) y
# Lidar_max_range, y fuera de Lidar_target_exclusion alrededor del objetivo. Metros.
Lidar_enabled = true
Lidar_debug = true
Lidar_max_range = 3.0
Lidar_min_height = 0.20
Lidar_max_height = 1.80
Lidar_self_radius = 0.40
Lidar_target_exclusion = 0.7
# Freno de seguridad: anula el avance si el arco mandado lleva el robot (radio 0.40 m, sin margen)
# contra un punto en Brake_time segundos mas Brake_margin metros. El giro se mantiene.
Brake_time = 0.5
Brake_margin = 0.10

# Ventana de depuracion de la navegacion: arcos del DWA (gris claro choca, naranja no frena, gris valido,
# verde elegido), puntos del lidar por tramo (rojo el muro que se rodea), meta/submeta y objetivo.
# Nav_debug_save_dir no vacio: guarda cada imagen (10 Hz) en ese directorio.
Nav_debug_view = true
Nav_debug_save_dir = ""

# DWA (concept_robot::navigate_to()): muestreo, pesos del coste y holgura. Sin la clave, valor por defecto.
# Arcos: Nav_v_samples avances en [0, max] x Nav_w_samples giros a +-Nav_w_window rad/s del actual.
Nav_v_samples = 11
Nav_w_samples = 21
Nav_w_window = 1.0
# Pesos: rumbo final a la meta, distancia final, holgura, velocidad, espacio libre delante,
# cambiar de lado al pasar un obstaculo, cambio de giro (suavidad / mantener el rumbo).
Nav_w_heading = 1.0
Nav_w_dist = 1.0
Nav_w_clearance = 3.0
Nav_w_speed = 1.0
Nav_w_free = 1.5
Nav_w_side = 1.5
Nav_w_smooth = 1.5
# Metros desde el borde del robot a partir de los que la holgura no penaliza (antes 0.5).
Nav_safe_clearance = 0.7
# Metros del rayo de espacio libre al final del arco.
Nav_free_ahead = 1.5
