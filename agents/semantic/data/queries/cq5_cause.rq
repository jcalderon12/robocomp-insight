# CQ5. Which explanation did simulation support, for which observation, and with which unresolved alternatives?
# Reads: the explanation, selected hypothesis and simulation runs. Anchors are hypothetical; legacy filename retained.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#>
PREFIX soma: <http://www.ease-crc.org/ont/SOMA.owl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX insight: <http://insight.local/ontology#>
PREFIX inst: <http://insight.local/instances#>

SELECT DISTINCT ?case ?explanation ?hypothesis ?mechanism ?anchor ?observation ?repetitions ?effect_rate ?mistimed ?median_error_s
                ?nominal_repetitions ?nominal_effect_rate ?unresolved_alternatives WHERE {
  ?case_iri a inst:AnomalyCase ; rdfs:label ?case ; inst:explainedBy ?c ; dul:isSettingFor ?nominal .
  ?c a insight:SimulationSupportedExplanation ; rdfs:label ?explanation ;
     insight:explainsObservation ?observed ; dul:isDescribedBy ?m ;
     insight:selectedHypothesis ?h ; insight:supportedBySimulation ?run .
  ?h insight:hypothesisId ?hypothesis .
  ?m a insight:Mechanism ; insight:mechanismId ?mechanism .
  ?observed a insight:ObservedAnomaly ; rdfs:label ?observation .
  OPTIONAL { ?h insight:anchoredTo ?where . ?where a insight:PathSegment ; rdfs:label ?anchor }
  OPTIONAL { ?h insight:anchoredTo ?when . ?when a dul:TimeInterval ; rdfs:label ?anchor }
  ?run insight:repetitions ?repetitions ; insight:effectRate ?effect_rate .
  OPTIONAL { ?run insight:mistimedEffects ?mistimed }
  OPTIONAL { ?run insight:medianTimingErrorS ?median_error_s }
  ?nominal insight:isNominal true ; insight:repetitions ?nominal_repetitions ; insight:effectRate ?nominal_effect_rate .
  OPTIONAL {
    SELECT ?c (GROUP_CONCAT(DISTINCT ?alternative_id; separator=", ") AS ?unresolved_alternatives) WHERE {
      ?c insight:hasUnresolvedAlternative ?alternative . ?alternative insight:hypothesisId ?alternative_id .
    } GROUP BY ?c
  }
}
ORDER BY ?case
