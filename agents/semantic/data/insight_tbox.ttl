@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix insight: <http://insight.local/ontology#> .
@prefix inst: <http://insight.local/instances#> .
@prefix ocra: <http://www.iri.upc.edu/groups/perception/OCRA/ont/ocra.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix soma: <http://www.ease-crc.org/ont/SOMA.owl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inst:Intention a owl:Class ;
    rdfs:label "intention"@en ;
    rdfs:comment "An intention node of the working memory (DSR), such as 'unexplained'."@en ;
    rdfs:subClassOf dul:Description .

inst:Sensor_BaseCommand a sosa:Sensor ;
    rdfs:label "base command"@en ;
    rdfs:comment "robot_ref_adv_speed and robot_ref_rot_speed of the robot node: what the base was ordered to do."@en ;
    sosa:observes insight:reaction_onset,
        insight:setpoint_step,
        insight:speed_ratio,
        insight:yaw_change .

inst:Sensor_BottleTracker a sosa:Sensor ;
    rdfs:label "bottle tracker"@en ;
    rdfs:comment "RT edge robot -> bottle of the DSR; its deletion is the observed effect (t_obs)."@en ;
    sosa:observes insight:bottle_reacquired .

inst:Sensor_IMU a sosa:Sensor ;
    rdfs:label "IMU (WT901B AHRS)"@en ;
    rdfs:comment "Node 'imu' of the DSR: accelerometer with gravity and gyroscope; x lateral, y forward, z up."@en ;
    sosa:observes insight:lateral_accel_peak,
        insight:longitudinal_accel_peak,
        insight:max_sustained_horizontal_accel,
        insight:pitch_rate_peak,
        insight:vertical_accel_peak,
        insight:yaw_rate_peak .

inst:Sensor_Localization a sosa:Sensor ;
    rdfs:label "localization"@en ;
    rdfs:comment "RT edge room -> robot of the DSR: the robot pose in the room frame."@en ;
    sosa:observes insight:speed_ratio,
        insight:yaw_change .

inst:Sensor_PersonTracker a sosa:Sensor ;
    rdfs:label "person tracker"@en ;
    rdfs:comment "RT edge robot -> person of the DSR."@en ;
    sosa:observes insight:person_distance_min .

inst:concernsEvent a owl:ObjectProperty ;
    rdfs:label "concerns event"@en ;
    rdfs:comment "Links an anomaly case to the observed effect (e.g. the bottle leaving the robot)."@en ;
    rdfs:subPropertyOf dul:isSettingFor .

inst:explainedBy a owl:ObjectProperty ;
    rdfs:label "explained by"@en ;
    rdfs:comment "Links an anomaly case to the event accepted as its cause."@en ;
    rdfs:subPropertyOf dul:associatedWith .

inst:hasIntention a owl:ObjectProperty ;
    rdfs:label "has intention"@en ;
    rdfs:subPropertyOf dul:associatedWith .

<http://insight.local/ontology> a owl:Ontology ;
    rdfs:label "INSIGHT TBox"@en ;
    rdfs:comment "Generated by build_insight_tbox.py; do not edit by hand. Sources (sha256): T_op.owl 1192e20acc1d; DUL.owl 73a225445be6; SOMA.owl.rdf 16b42de8e253; sosa.ttl c70b0d1c843c; ssn-dul.ttl 8371c416178d; insight_layer.ttl ab23c368432a"@en ;
    owl:versionInfo "0.1" .

insight:Kind_direction_any a insight:Kind ;
    rdfs:label "direction: any"@en ;
    insight:kindValue "any" ;
    insight:ofParameter insight:param_push_direction .

insight:Kind_direction_backward a insight:Kind ;
    rdfs:label "direction: backward"@en ;
    insight:kindValue "backward" ;
    insight:ofParameter insight:param_push_direction .

insight:Kind_direction_forward a insight:Kind ;
    rdfs:label "direction: forward"@en ;
    insight:kindValue "forward" ;
    insight:ofParameter insight:param_push_direction .

insight:Kind_direction_left a insight:Kind ;
    rdfs:label "direction: left"@en ;
    insight:kindValue "left" ;
    insight:ofParameter insight:param_push_direction .

insight:Kind_direction_right a insight:Kind ;
    rdfs:label "direction: right"@en ;
    insight:kindValue "right" ;
    insight:ofParameter insight:param_push_direction .

insight:Kind_kind_brake a insight:Kind ;
    rdfs:label "kind: brake"@en ;
    insight:kindValue "brake" ;
    insight:ofParameter insight:param_motion_kind .

insight:Kind_kind_jerk a insight:Kind ;
    rdfs:label "kind: jerk"@en ;
    insight:kindValue "jerk" ;
    insight:ofParameter insight:param_motion_kind .

insight:Kind_shape_bump a insight:Kind ;
    rdfs:label "shape: bump"@en ;
    insight:kindValue "bump" ;
    insight:ofParameter insight:param_obstacle_shape .

insight:Kind_shape_cable a insight:Kind ;
    rdfs:label "shape: cable"@en ;
    insight:kindValue "cable" ;
    insight:ofParameter insight:param_obstacle_shape .

insight:Kind_side_left a insight:Kind ;
    rdfs:label "side: left"@en ;
    insight:kindValue "left" ;
    insight:ofParameter insight:param_wheel_side .

insight:Kind_side_right a insight:Kind ;
    rdfs:label "side: right"@en ;
    insight:kindValue "right" ;
    insight:ofParameter insight:param_wheel_side .

insight:Kind_side_unknown a insight:Kind ;
    rdfs:label "side: unknown"@en ;
    insight:kindValue "unknown" ;
    insight:ofParameter insight:param_wheel_side .

insight:Mechanism_BottlePush a insight:Mechanism ;
    rdfs:label "push on the bottle"@en ;
    insight:admitsParameter insight:param_push_direction ;
    insight:costInSimulations 1 ;
    insight:family "external" ;
    insight:inOldCatalog true ;
    insight:mechanismId "bottle_push" ;
    insight:promptDescription "Something (the followed person, an object, a gust) pushes the bottle off the tray; the robot itself feels no jolt." ;
    insight:realizedBy insight:Intervention_apply_external_force ;
    insight:requires insight:pre_bottle_supported ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "Push on the bottle during {interval}" ;
    rdfs:seeAlso soma:ForceInteraction .

insight:Mechanism_BottleRemovedByPerson a insight:Mechanism ;
    rdfs:label "bottle removed by a person"@en ;
    insight:costInSimulations 0 ;
    insight:entailsObservation insight:person_distance_min ;
    insight:family "external" ;
    insight:hasContrastRule insight:rule_person_within_reach ;
    insight:inOldCatalog false ;
    insight:mechanismId "bottle_removed_by_person" ;
    insight:notSimulableBecause "Not physical: it is checked against the recording, not simulated." ;
    insight:promptDescription "A person takes the bottle off the tray; there is no jolt and the person is within reach." ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "A person removed the bottle during {interval}" .

insight:Mechanism_CommandedSpeedChange a insight:Mechanism ;
    rdfs:label "commanded brake or acceleration"@en ;
    insight:costInSimulations 0 ;
    insight:entailsObservation insight:setpoint_step ;
    insight:family "internal" ;
    insight:hasContrastRule insight:rule_setpoint_step ;
    insight:inOldCatalog false ;
    insight:mechanismId "commanded_speed_change" ;
    insight:promptDescription "The robot itself was ordered to brake or accelerate sharply; the order is in the recorded setpoint." ;
    insight:realizedBy insight:Intervention_nominal_replay ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "Commanded speed change during {interval}" .

insight:Mechanism_ObstacleTraversed a insight:Mechanism ;
    rdfs:label "undetected obstacle driven over"@en ;
    insight:admitsParameter insight:param_obstacle_shape ;
    insight:costInSimulations 1 ;
    insight:entailsObservation insight:pitch_rate_peak,
        insight:vertical_accel_peak ;
    insight:family "external" ;
    insight:hasContrastRule insight:rule_obstacle_jolt ;
    insight:inOldCatalog true ;
    insight:mechanismId "obstacle_traversed" ;
    insight:promptDescription "The robot drives over a low object on the floor (a bump or a cable) that it did not detect; the jolt tips the bottle." ;
    insight:realizedBy insight:Intervention_spawn_scaled_dome,
        insight:Intervention_spawn_static_object ;
    insight:requires insight:pre_moving_on_segment ;
    insight:requiresAnchor insight:SegmentAnchor ;
    insight:titleTemplate "Undetected {shape} on {segment}" ;
    rdfs:comment "A bump is simulated with a dome of unknown size, whose repetitions draw its diameter and height over the range the catalog simulates (spawn_scaled_dome); with a catalog that has no such dome, with every bump asset, one compiled cause each. A cable, with the cable asset."@en ;
    rdfs:seeAlso soma:Collision .

insight:Mechanism_PerceptionFailure a insight:Mechanism ;
    rdfs:label "perception failure"@en ;
    insight:costInSimulations 0 ;
    insight:entailsObservation insight:bottle_reacquired ;
    insight:family "internal" ;
    insight:hasContrastRule insight:rule_bottle_reacquired ;
    insight:inOldCatalog false ;
    insight:mechanismId "perception_failure" ;
    insight:notSimulableBecause "Not physical: the bottle did not fall; it is checked against the recording." ;
    insight:promptDescription "The bottle did not fall: perception lost it; there is no jolt and the bottle is detected again." ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "False loss of the bottle during {interval}" ;
    rdfs:seeAlso soma:SoftwareDiagnosis .

insight:Mechanism_RobotPush a insight:Mechanism ;
    rdfs:label "push on the robot"@en ;
    insight:admitsParameter insight:param_push_direction ;
    insight:costInSimulations 1 ;
    insight:entailsObservation insight:lateral_accel_peak,
        insight:speed_ratio,
        insight:yaw_change ;
    insight:family "external" ;
    insight:hasContrastRule insight:rule_robot_jolt ;
    insight:inOldCatalog true ;
    insight:mechanismId "robot_push" ;
    insight:promptDescription "Something pushes the robot; the jolt or the deviation tips the bottle." ;
    insight:realizedBy insight:Intervention_apply_external_force ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "Push on the robot during {interval}" ;
    rdfs:seeAlso soma:ForceInteraction .

insight:Mechanism_SlipperyFloor a insight:Mechanism ;
    rdfs:label "slippery floor"@en ;
    insight:costInSimulations 1 ;
    insight:entailsObservation insight:max_sustained_horizontal_accel,
        insight:speed_ratio ;
    insight:family "external" ;
    insight:hasContrastRule insight:rule_traction_vs_friction ;
    insight:inOldCatalog true ;
    insight:mechanismId "slippery_floor" ;
    insight:promptDescription "The whole floor is slippery; the wheels slip and the bottle is displaced." ;
    insight:realizedBy insight:Intervention_set_friction ;
    insight:titleTemplate "Slippery floor in the whole room" ;
    rdfs:seeAlso soma:FrictionAttribute .

insight:Mechanism_SuspensionFailure a insight:Mechanism ;
    rdfs:label "suspension failure"@en ;
    insight:costInSimulations 0 ;
    insight:family "internal" ;
    insight:inOldCatalog false ;
    insight:mechanismId "suspension_failure" ;
    insight:notSimulableBecause "The PyBullet URDF has no suspension." ;
    insight:promptDescription "The suspension fails or vibrates and shakes the bottle off." ;
    insight:titleTemplate "Suspension failure" ;
    rdfs:seeAlso soma:HardwareDiagnosis .

insight:Mechanism_UncommandedMotion a insight:Mechanism ;
    rdfs:label "uncommanded motion"@en ;
    insight:admitsParameter insight:param_motion_kind ;
    insight:costInSimulations 1 ;
    insight:entailsObservation insight:longitudinal_accel_peak,
        insight:speed_ratio ;
    insight:family "internal" ;
    insight:hasContrastRule insight:rule_speed_ratio_and_jolt ;
    insight:inOldCatalog false ;
    insight:mechanismId "uncommanded_motion" ;
    insight:promptDescription "The base did not do what it was ordered: a brake or a jerk that is not in the setpoint (driver or power fault)." ;
    insight:realizedBy insight:Intervention_override_setpoint ;
    insight:requires insight:pre_moving_in_interval ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "Uncommanded {kind} during {interval}" ;
    rdfs:seeAlso soma:HardwareDiagnosis .

insight:Mechanism_WheelFailure a insight:Mechanism ;
    rdfs:label "drive wheel failure"@en ;
    insight:admitsParameter insight:param_wheel_side ;
    insight:costInSimulations 1 ;
    insight:entailsObservation insight:speed_ratio,
        insight:yaw_change,
        insight:yaw_rate_peak ;
    insight:family "internal" ;
    insight:hasContrastRule insight:rule_turn_vs_command ;
    insight:inOldCatalog true ;
    insight:mechanismId "wheel_failure" ;
    insight:promptDescription "One of the two drive wheels stops and stays braked; the robot turns without being ordered to." ;
    insight:realizedBy insight:Intervention_disable_wheel ;
    insight:requires insight:pre_moving_in_interval ;
    insight:requiresAnchor insight:IntervalAnchor ;
    insight:titleTemplate "{side} drive wheel blocked during {interval}" ;
    rdfs:comment "Side 'unknown' simulates both sides and costs 2."@en ;
    rdfs:seeAlso soma:HardwareDiagnosis .

insight:Status_checked_not_simulable a insight:HypothesisStatus ;
    insight:statusId "checked_not_simulable" ;
    rdfs:comment "Survives the contrast, but is not physical: what could be checked was checked against the recording."@en .

insight:Status_discarded a insight:HypothesisStatus ;
    insight:statusId "discarded" ;
    rdfs:comment "A contrast rule finds the recording contradicts it."@en .

insight:Status_explained_by_memory a insight:HypothesisStatus ;
    insight:statusId "explained_by_memory" ;
    rdfs:comment "The recording already explains it (a commanded brake); the nominal run, always simulated, must reproduce the effect."@en .

insight:Status_incoherent a insight:HypothesisStatus ;
    insight:statusId "incoherent" ;
    rdfs:comment "An anchor that does not exist in the episode, or a precondition that fails."@en .

insight:Status_not_simulable a insight:HypothesisStatus ;
    insight:statusId "not_simulable" ;
    rdfs:comment "No realization here (no suspension in the URDF, an experimental intervention, a cable parallel to the path) or a 'new' mechanism."@en .

insight:Status_over_budget a insight:HypothesisStatus ;
    insight:statusId "over_budget" ;
    rdfs:comment "As to_simulate, but the budget ran out (only with a budget k)."@en .

insight:Status_to_simulate a insight:HypothesisStatus ;
    insight:statusId "to_simulate" ;
    rdfs:comment "Passes coherence and contrast, has a realization and fits the budget: it is simulated."@en .

insight:SystemReaction a owl:Class ;
    rdfs:label "system reaction"@en ;
    rdfs:comment "What the system did after it perceived the anomaly, such as stopping. It is never a cause, and no contrast rule reads it."@en ;
    rdfs:subClassOf dul:Event .

insight:abstentionReason a owl:DatatypeProperty ;
    rdfs:label "abstention reason"@en ;
    rdfs:comment "Why the verdict accepted no hypothesis (e.g. the nominal run already reproduces the effect)."@en ;
    rdfs:domain inst:AnomalyCase ;
    rdfs:range xsd:string .

insight:acceptedBySimulation a owl:DatatypeProperty ;
    rdfs:label "accepted by simulation"@en ;
    rdfs:comment "True for the one run whose hypothesis the verdict accepted."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:boolean .

insight:admitsParameter a owl:ObjectProperty ;
    rdfs:label "admits parameter"@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range insight:QualitativeParameter .

insight:allowedValue a owl:DatatypeProperty ;
    rdfs:label "allowed value"@en ;
    rdfs:domain insight:QualitativeParameter ;
    rdfs:range xsd:string .

insight:anchoredTo a owl:ObjectProperty ;
    rdfs:label "anchored to"@en ;
    rdfs:comment "An individual of the episode the hypothesis names: a path segment or a time interval. The grounding turns it into the numbers the simulator needs."@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:subPropertyOf dul:isSettingFor .

insight:appliesCheck a owl:ObjectProperty ;
    rdfs:label "applies check"@en ;
    rdfs:comment "The check whose description frames this outcome; its verdict says what it concluded."@en ;
    rdfs:domain insight:CheckOutcome ;
    rdfs:range insight:EpisodeCheck ;
    rdfs:subPropertyOf dul:satisfies .

insight:atTimeS a owl:DatatypeProperty ;
    rdfs:label "at time (s)"@en ;
    rdfs:comment "Instant of the peak, in seconds from the episode time origin."@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:decimal .

insight:baselineValue a owl:DatatypeProperty ;
    rdfs:label "baseline value"@en ;
    rdfs:comment "The same property measured in Interval_baseline (free motion), to compare peaks with."@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:decimal .

insight:batchPath a owl:DatatypeProperty ;
    rdfs:label "batch path"@en ;
    rdfs:comment "The published batch (contract 3b) the hypotheses come from."@en ;
    rdfs:domain insight:HypothesisGeneration ;
    rdfs:range xsd:anyURI .

insight:batchStatus a owl:DatatypeProperty ;
    rdfs:label "batch status"@en ;
    rdfs:comment "success, or error when no attempt passed the schema: the batch then has no hypotheses."@en ;
    rdfs:domain insight:HypothesisGeneration ;
    rdfs:range xsd:string .

insight:catalogId a owl:DatatypeProperty ;
    rdfs:label "catalog id"@en ;
    rdfs:comment "Key of the intervention in etc/intervention_catalog.json."@en ;
    rdfs:domain insight:SimulationIntervention ;
    rdfs:range xsd:string .

insight:causeName a owl:DatatypeProperty ;
    rdfs:label "cause name"@en ;
    rdfs:comment "The compiled cause the simulator ran (e.g. bump_scaled, external_force; none for the nominal)."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:string .

insight:checkVerdict a owl:DatatypeProperty ;
    rdfs:label "check verdict"@en ;
    rdfs:comment "holds or fails (a precondition); discards or survives (a rule that discards); explains (a rule that explains or discards); trace_seen or no_trace (a rule that informs); undetermined; not_applicable."@en ;
    rdfs:domain insight:CheckOutcome ;
    rdfs:range xsd:string .

insight:checkedBy a owl:ObjectProperty ;
    rdfs:label "checked by"@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:range insight:CheckOutcome ;
    rdfs:subPropertyOf dul:hasSetting .

insight:checksProperty a owl:ObjectProperty ;
    rdfs:label "checks property"@en ;
    rdfs:domain insight:EpisodeCheck ;
    rdfs:range sosa:ObservableProperty .

insight:commandedValue a owl:DatatypeProperty ;
    rdfs:label "commanded value"@en ;
    rdfs:comment "What the base command alone gives for the same property over the same interval. For yaw_change, -integral of robot_ref_rot_speed (deg), which the turn_vs_command rule, scaled by the episode's own clock, compares with the recorded change."@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:decimal .

insight:costInSimulations a owl:DatatypeProperty ;
    rdfs:label "cost in simulations"@en ;
    rdfs:comment "Compiled causes each simulated variant takes from the budget (the nominal run is free). An intervention that runs more repetitions than one cause costs what it runs (the dome of unknown size, 4); a wheel of unknown side is one variant per side."@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range xsd:nonNegativeInteger .

insight:effectRate a owl:DatatypeProperty ;
    rdfs:label "effect rate"@en ;
    rdfs:comment "Fraction of the repetitions in which the bottle falls when the recording saw it fall (within the verdict's span around t_obs)."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:decimal .

insight:endS a owl:DatatypeProperty ;
    rdfs:label "end (s)"@en ;
    rdfs:comment "End of the interval, in seconds from the episode time origin."@en ;
    rdfs:domain dul:TimeInterval ;
    rdfs:range xsd:decimal .

insight:ends a owl:ObjectProperty ;
    rdfs:label "ends"@en ;
    rdfs:comment "The event ends this state: the accident ends the support of the bottle."@en ;
    rdfs:domain dul:Event ;
    rdfs:range soma:State .

insight:entailsObservation a owl:ObjectProperty ;
    rdfs:label "entails observation"@en ;
    rdfs:comment "An observable property on which the mechanism leaves a trace in the recording."@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range sosa:ObservableProperty .

insight:family a owl:DatatypeProperty ;
    rdfs:label "family"@en ;
    rdfs:comment "internal or external; kept for compatibility with the previous batches."@en ;
    rdfs:range xsd:string .

insight:fromX a owl:DatatypeProperty ;
    rdfs:label "from x (m)"@en ;
    rdfs:range xsd:decimal .

insight:fromY a owl:DatatypeProperty ;
    rdfs:label "from y (m)"@en ;
    rdfs:range xsd:decimal .

insight:hasContrastRule a owl:ObjectProperty ;
    rdfs:label "has contrast rule"@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range insight:ContrastRule .

insight:headingDeg a owl:DatatypeProperty ;
    rdfs:label "heading (deg)"@en ;
    rdfs:comment "Heading in the room frame, 0 = +x, counter-clockwise (DSR yaw + 90 deg)."@en ;
    rdfs:range xsd:decimal .

insight:hypothesisId a owl:DatatypeProperty ;
    rdfs:label "hypothesis id"@en ;
    rdfs:comment "Id of a hypothesis in the published batch (contract 3), on the hypothesis and on the verified cause it became."@en ;
    rdfs:range xsd:string .

insight:inOldCatalog a owl:DatatypeProperty ;
    rdfs:label "in old catalog"@en ;
    rdfs:comment "Whether the four-primitive catalog could already express it."@en ;
    rdfs:range xsd:boolean .

insight:isExperimental a owl:DatatypeProperty ;
    rdfs:label "is experimental"@en ;
    rdfs:comment "Only in experiments/, not in the production simulator."@en ;
    rdfs:domain insight:SimulationIntervention ;
    rdfs:range xsd:boolean .

insight:isNominal a owl:DatatypeProperty ;
    rdfs:label "is nominal"@en ;
    rdfs:comment "True for the replay of the recorded setpoints without any cause: the null hypothesis, always simulated."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:boolean .

insight:isSystemReaction a owl:DatatypeProperty ;
    rdfs:label "is system reaction"@en ;
    rdfs:comment "True for observations taken during the system reaction; contrast rules ignore them."@en ;
    rdfs:range xsd:boolean .

insight:kindValue a owl:DatatypeProperty ;
    rdfs:label "kind value"@en ;
    rdfs:domain insight:Kind ;
    rdfs:range xsd:string .

insight:lengthM a owl:DatatypeProperty ;
    rdfs:label "length (m)"@en ;
    rdfs:range xsd:decimal .

insight:llmAttempts a owl:DatatypeProperty ;
    rdfs:label "LLM attempts"@en ;
    rdfs:comment "Requests to the LLM until a list passed the schema, or all of them if none did."@en ;
    rdfs:domain insight:HypothesisGeneration ;
    rdfs:range xsd:nonNegativeInteger .

insight:llmModel a owl:DatatypeProperty ;
    rdfs:label "LLM model"@en ;
    rdfs:domain insight:HypothesisGeneration ;
    rdfs:range xsd:string .

insight:llmRationale a owl:DatatypeProperty ;
    rdfs:label "LLM rationale"@en ;
    rdfs:comment "Why the LLM proposed it, in its words. Kept as provenance: no check reads it."@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:range xsd:string .

insight:meanSpeedMps a owl:DatatypeProperty ;
    rdfs:label "mean speed (m/s)"@en ;
    rdfs:range xsd:decimal .

insight:mechanismId a owl:DatatypeProperty ;
    rdfs:label "mechanism id"@en ;
    rdfs:comment "Short id used in the JSON contracts (e.g. obstacle_traversed)."@en ;
    rdfs:range xsd:string .

insight:medianTimingErrorS a owl:DatatypeProperty ;
    rdfs:label "median timing error (s)"@en ;
    rdfs:comment "Median |simulated fall - t_obs| over the repetitions that reproduce the effect."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:decimal .

insight:mistimedEffects a owl:DatatypeProperty ;
    rdfs:label "mistimed effects"@en ;
    rdfs:comment "Repetitions in which the bottle falls, but outside that span: they do not count."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:nonNegativeInteger .

insight:motionKind a owl:DatatypeProperty ;
    rdfs:label "motion kind"@en ;
    rdfs:comment "Kind of motion of a phase: stopped, advance_straight or turn."@en ;
    rdfs:range xsd:string .

insight:newMechanismDescription a owl:DatatypeProperty ;
    rdfs:label "new mechanism description"@en ;
    rdfs:comment "The LLM's description of a mechanism the TBox does not have ('new')."@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:range xsd:string .

insight:notSimulableBecause a owl:DatatypeProperty ;
    rdfs:label "not simulable because"@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range xsd:string .

insight:ofParameter a owl:ObjectProperty ;
    rdfs:label "of parameter"@en ;
    rdfs:domain insight:Kind ;
    rdfs:range insight:QualitativeParameter .

insight:orderBackFromFall a owl:DatatypeProperty ;
    rdfs:label "order back from the fall"@en ;
    rdfs:comment "1 for Segment_final, 2 for the metre before, and so on."@en ;
    rdfs:domain insight:PathSegment ;
    rdfs:range xsd:positiveInteger .

insight:parameterName a owl:DatatypeProperty ;
    rdfs:label "parameter name"@en ;
    rdfs:domain insight:QualitativeParameter ;
    rdfs:range xsd:string .

insight:passesRule a owl:DatatypeProperty ;
    rdfs:label "passes rule"@en ;
    rdfs:comment "Whether the run passes the verdict's decision rule (it reproduces the effect better than the nominal)."@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:boolean .

insight:promptDescription a owl:DatatypeProperty ;
    rdfs:label "prompt description"@en ;
    rdfs:comment "One sentence shown to the LLM."@en ;
    rdfs:range xsd:string .

insight:proposedIn a owl:ObjectProperty ;
    rdfs:label "proposed in"@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:range insight:HypothesisGeneration ;
    rdfs:subPropertyOf dul:associatedWith .

insight:quantityName a owl:DatatypeProperty ;
    rdfs:label "quantity name"@en ;
    rdfs:comment "What a sampled value measures, as the simulator names it (e.g. diameter_m, height_m, x_m, force_x_n)."@en ;
    rdfs:domain insight:SampledValue ;
    rdfs:range xsd:string .

insight:rank a owl:DatatypeProperty ;
    rdfs:label "rank"@en ;
    rdfs:comment "Position in the LLM's list, its order of plausibility."@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:range xsd:positiveInteger .

insight:readsObservation a owl:ObjectProperty ;
    rdfs:label "reads observation"@en ;
    rdfs:domain insight:CheckOutcome ;
    rdfs:range sosa:Observation ;
    rdfs:subPropertyOf dul:isSettingFor .

insight:realizedBy a owl:ObjectProperty ;
    rdfs:label "realized by"@en ;
    rdfs:comment "An intervention that simulates the mechanism; a mechanism may have one per kind (the obstacle: a dome of unknown size for a bump, a fixed asset for a cable). What is simulated is what the hypothesis says."@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range insight:SimulationIntervention .

insight:recordedIn a owl:DatatypeProperty ;
    rdfs:label "recorded in"@en ;
    rdfs:comment "The episodic-memory recording the episode was abstracted from. The semantic memory keeps the meaning; the signals stay in that recording."@en ;
    rdfs:domain insight:Episode ;
    rdfs:range xsd:anyURI .

insight:repetitions a owl:DatatypeProperty ;
    rdfs:label "repetitions"@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range xsd:nonNegativeInteger .

insight:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range insight:Precondition .

insight:requiresAnchor a owl:ObjectProperty ;
    rdfs:label "requires anchor"@en ;
    rdfs:domain insight:Mechanism ;
    rdfs:range insight:AnchorKind .

insight:ruleEffect a owl:DatatypeProperty ;
    rdfs:label "rule effect"@en ;
    rdfs:comment "incoherent (precondition), discard, explain_or_discard, or inform."@en ;
    rdfs:domain insight:EpisodeCheck ;
    rdfs:range xsd:string .

insight:ruleId a owl:DatatypeProperty ;
    rdfs:label "rule id"@en ;
    rdfs:domain insight:EpisodeCheck ;
    rdfs:range xsd:string .

insight:ruleStatus a owl:DatatypeProperty ;
    rdfs:label "rule status"@en ;
    rdfs:comment "fixed (physics or geometry) or to_calibrate (provisional threshold, set in the contrast task)."@en ;
    rdfs:domain insight:EpisodeCheck ;
    rdfs:range xsd:string .

insight:startS a owl:DatatypeProperty ;
    rdfs:label "start (s)"@en ;
    rdfs:comment "Start of the interval, in seconds from the episode time origin."@en ;
    rdfs:domain dul:TimeInterval ;
    rdfs:range xsd:decimal .

insight:statusId a owl:DatatypeProperty ;
    rdfs:label "status id"@en ;
    rdfs:comment "The status as written in the published batch."@en ;
    rdfs:domain insight:HypothesisStatus ;
    rdfs:range xsd:string .

insight:statusReason a owl:DatatypeProperty ;
    rdfs:label "status reason"@en ;
    rdfs:comment "Why the hypothesis is not simulated, in words (the batch's untestable_reason): the check that discarded it, or why it has no realization here."@en ;
    rdfs:domain insight:Hypothesis ;
    rdfs:range xsd:string .

insight:testsHypothesis a owl:ObjectProperty ;
    rdfs:label "tests hypothesis"@en ;
    rdfs:domain insight:SimulationRun ;
    rdfs:range insight:Hypothesis ;
    rdfs:subPropertyOf dul:associatedWith .

insight:timeOriginNs a owl:DatatypeProperty ;
    rdfs:label "time origin (ns)"@en ;
    rdfs:comment "Timestamp in nanoseconds of the first IMU event: time zero of the episode, as for the simulator and the verdict."@en ;
    rdfs:domain insight:Episode ;
    rdfs:range xsd:integer .

insight:timeS a owl:DatatypeProperty ;
    rdfs:label "time (s)"@en ;
    rdfs:comment "Instant of an event, in seconds from the episode time origin (for the accident, t_obs)."@en ;
    rdfs:range xsd:decimal .

insight:titleTemplate a owl:DatatypeProperty ;
    rdfs:label "title template"@en ;
    rdfs:comment "Title of a hypothesis, written from the mechanism and its anchors instead of the LLM title."@en ;
    rdfs:range xsd:string .

insight:toX a owl:DatatypeProperty ;
    rdfs:label "to x (m)"@en ;
    rdfs:range xsd:decimal .

insight:toY a owl:DatatypeProperty ;
    rdfs:label "to y (m)"@en ;
    rdfs:range xsd:decimal .

insight:traversedDuring a owl:ObjectProperty ;
    rdfs:label "traversed during"@en ;
    rdfs:domain insight:PathSegment ;
    rdfs:range dul:TimeInterval .

insight:unit a owl:DatatypeProperty ;
    rdfs:label "unit"@en ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string .

insight:verdictPath a owl:DatatypeProperty ;
    rdfs:label "verdict path"@en ;
    rdfs:comment "The inner simulator's verdict on the case."@en ;
    rdfs:domain inst:AnomalyCase ;
    rdfs:range xsd:anyURI .

insight:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verified by"@en ;
    rdfs:domain insight:VerifiedCause ;
    rdfs:range insight:SimulationRun ;
    rdfs:subPropertyOf dul:associatedWith .

insight:xMax a owl:DatatypeProperty ;
    rdfs:label "bounding box x max (m)"@en ;
    rdfs:range xsd:decimal .

insight:xMin a owl:DatatypeProperty ;
    rdfs:label "bounding box x min (m)"@en ;
    rdfs:range xsd:decimal .

insight:yMax a owl:DatatypeProperty ;
    rdfs:label "bounding box y max (m)"@en ;
    rdfs:range xsd:decimal .

insight:yMin a owl:DatatypeProperty ;
    rdfs:label "bounding box y min (m)"@en ;
    rdfs:range xsd:decimal .

soma:Accident a owl:Class ;
    rdfs:comment """An Event for which causes are unknown and/or considered irrelevant. This is true also for "final causes" (that is, intentions) of Agents participating in the Accident: it is not the intentions of these Agents to bring about the Accident.

Note a distinction between this definition and some informal, everyday uses of "accident" which require a causal structure and responsibility to be ascertained. An accident, in the informal sense, may require an explanation as to who made a mistake in bringing about the event; a "traffic accident", where we want to know who's responsible, is an example of this.

Such an event does NOT fall under the definition of Accident here. An example of Accident would be a fair coin landing Heads: the causal chain for why this exact face landed is not important, all that matters is the brute fact that the coin landed Heads.""",
        "also think about \"mistakes\": (Mihai:) yes, but consider whether those might qualify as Situations. Likewise for Accidents, actually." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:Event .

soma:DesignedComponent a owl:Class ;
    rdfs:label "Designed component" ;
    rdfs:comment "An object designed to be part or element of a larger whole." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:FunctionalPart,
        dul:DesignedArtifact .

soma:FailWFNoContinuation a soma:StatusFailure,
        owl:NamedIndividual ;
    rdfs:comment "A particular kind of failure: the workflow fails because there is no way to continue it, and the normal exit has not been reached." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-WF.owl> .

soma:FailWFNondeterministicContinuation a soma:StatusFailure,
        owl:NamedIndividual ;
    rdfs:comment "A particular kind of failure: it is not clear how to continue a workflow because several possibilities exist." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-WF.owl> .

soma:FailWFUninterpretableTask a soma:StatusFailure,
        owl:NamedIndividual ;
    rdfs:comment "A particular kind of failure: a task is not recognized and not associated to anything that could execute it, nor to a workflow that could detail its structure into simpler structure." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-WF.owl> .

soma:Feature a owl:Class ;
    rdfs:comment "Features are 'parasitic' entities that only exist insofar their host exists. Typical examples are holes, bumps, boundaries, or spots of color." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:Object .

soma:Locomotion a owl:Class ;
    rdfs:comment """Conceptually related to Navigation, but distinguishable from it because of the profile, ie. the focus of the task.

Navigation is about reaching some goal.

Locomotion is concerned more with the actual motion.""",
        "The Agent repositions their body in the environment." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:BodyMovement,
        soma:DirectedMotion .

soma:NonmanifestedSituation a owl:Class ;
    rdfs:label "Nonmanifested situation"@en ;
    rdfs:comment """A Situation which does not manifest in any event.

The main use case for this is to represent expectations that are not met, e.g. unfulfilled post-conditions of an action. An action with unmet postconditions is then a failure.

Because of open world semantics of DL, the default assumption for a Situation individual with no "manifests in" relations is simply that we don't know yet whether that Situation is manifested and if so by what Event.

As such, an explicit assertion is needed to make a Situation a nonmanifested one: either declare that individual's type NonmanifestedSituation, or assert that it has 0 manifestsIn relations.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:subClassOf dul:Situation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dul:Situation [ a owl:Restriction ;
                        owl:onClass dul:Event ;
                        owl:onProperty <http://www.ease-crc.org/ont/SOMA.owl/manifestsIn> ;
                        owl:qualifiedCardinality "0"^^xsd:nonNegativeInteger ] ) ] .

soma:RDFType a soma:Reification,
        owl:NamedIndividual ;
    soma:isReificationOf "http://www.w3.org/2001/XMLSchema#type"^^xsd:anyURI ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> .

soma:SupportState a owl:Class ;
    rdfs:label "Support state"@en ;
    rdfs:comment "Classifies States in which an object is not able to move under gravity because of its placement relative to some other object." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:FunctionalControl .

soma:SupportedObject a owl:Class ;
    rdfs:label "Supported object"@en ;
    rdfs:comment "An object that is supported by some supporter." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:ConnectedObject .

soma:Supporter a owl:Class ;
    rdfs:comment "A role classifying an object used to support others." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:Restrictor .

soma:UsageGuideline a owl:AnnotationProperty .

soma:causesTransition a owl:ObjectProperty ;
    rdfs:label "causes transition" ;
    rdfs:comment "A Transition between two Situations is always the result of some Event, and the causesTransition relation should be used to record the causal relation from the Event to the Transition." ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:range dul:Transition ;
    rdfs:subPropertyOf dul:isEventIncludedIn ;
    owl:inverseOf soma:isCausedByEvent .

soma:directlyCauses a owl:ObjectProperty ;
    rdfs:label "directly causes"@en ;
    rdfs:comment "Non-transitive version of \"causes\"."@en ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf soma:causes ;
    owl:inverseOf soma:isDirectReactionTo .

dul:PhysicalAgent a owl:Class ;
    rdfs:label "Physical agent"@en,
        "Agente fisico"@it ;
    rdfs:comment """A PhysicalObject that is capable of self-representing (conceptualizing) a Description in order to plan an Action. 
A PhysicalAgent is a substrate for (actsFor) a Social Agent""" ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Agent,
        dul:PhysicalObject .

dul:PlanExecution a owl:Class ;
    rdfs:label "Plan execution"@en ;
    rdfs:comment "Plan executions are situations that proactively satisfy a plan. Subplan executions are proper parts of the whole plan execution." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Situation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom dul:Plan ] .

dul:SpaceRegion a owl:Class ;
    rdfs:label "Space region"@en,
        "Regione di spazio"@it ;
    rdfs:comment "Any Region in a dimensional space that is used to localize an Entity ; i.e., it is not used to represent some characteristic (e.g. it excludes time intervals, colors, size values, judgment values, etc.). Differently from a Place , a space region has a specific dimensional space." ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Region .

dul:TimeIndexedRelation a owl:Class ;
    rdfs:label "Time-indexed relation"@en ;
    rdfs:comment "A Situation that includes a time indexing in its setting, so allowing to order any binary relation (property) with time." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Situation ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dul:Situation [ a owl:Restriction ;
                        owl:onProperty dul:isSettingFor ;
                        owl:someValuesFrom dul:TimeInterval ] ) ] .

dul:defines a owl:ObjectProperty ;
    rdfs:label "defines"@en ;
    rdfs:comment "A relation between a Description and a Concept, e.g. a Workflow for a governmental Organization defines the Role 'officer', or 'the Italian Traffic Law defines the role Vehicle'." ;
    rdfs:domain dul:Description ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Concept ;
    rdfs:subPropertyOf dul:usesConcept ;
    owl:inverseOf dul:isDefinedIn .

dul:expresses a owl:ObjectProperty ;
    rdfs:label "expresses"@en ;
    rdfs:comment """A relation between an InformationObject and a 'meaning', generalized here as a 'SocialObject'. For example: 'A Beehive is a structure in which bees are kept, typically in the form of a dome or box.' (Oxford dictionary)'; 'the term Beehive expresses the concept Beehive in my apiculture ontology'.
The intuition for 'meaning' is intended to be very broad. A separate, large comment is included for those who want to investigate more on what kind of meaning can be represented in what form.""",
        """This is a large comment field for those who want to investigate the different uses of the 'expresses' relation for modeling different approaches to meaning characterization and modeling.
For example, in all these cases, some aspect of meaning is involved:

- Beehive means "a structure in which bees are kept, typically in the form of a dome or box." (Oxford dictionary)
- 'Beehive' is a synonym in noun synset 09218159 "beehive|hive" (WordNet)
- 'the term Beehive can be interpreted as the fact of 'being a beehive', i.e. a relation that holds for concepts such as Bee, Honey, Hosting, etc.'
- 'the text of Italian apiculture regulation expresses a rule by which beehives should be kept at least one kilometer away from inhabited areas'
- 'the term Beehive expresses the concept Beehive'
- ''Beehive' for apiculturists does not express the same meaning as for, say, fishermen'
- 'Your meaning of 'Beautiful' does not seem to fit mine'
- ''Beehive' is formally interpreted as the set of all beehives'
- 'from the term 'Beehive', we can build a vector space of statistically significant cooccurring terms in the documents that contain it'
- the lexeme 'Belly' expresses the role 'Body_Part' in the frame 'ObservableBodyParts' (FrameNet)

As the examples suggest, the 'meaning of meaning' is dependent on the background approach/theory that one assumes. One can hardly make a summary of the too many approaches and theories of meaning, therefore this relation is maybe the most controversial and difficult to explain; normally, in such cases it would be better to give up formalizing. 
However, the usefulness of having a 'semantic abstraction' in modeling information objects is so high (e.g. for the semantic web, interoperability, reengineering, etc.), that we accept this challenging task, although without taking any particular position in the debate. 
We provide here some examples, which we want to generalize upon when using the 'expresses' relation to model semantic aspects of social reality.

In the most common approach, lexicographers that write dictionaries, glossaries, etc. assume that the meaning of a term is a paraphrase (or 'gloss', or 'definition'). 
Another approach is provided by concept schemes like thesauri and lexicons, which assume that the meaning of a term is a 'concept', encoded as a 'lemma', 'synset', or 'descriptor'.
Still another approach is that of psychologists and cognitive scientists, which often assume that the meaning of an information object is a concept encoded in the mind or cognitive system of an agent. 
A radically different approach is taken by social scientists and semioticians, who usually assume that meanings of an information object are spread across the communication practices in which members of a community use that object.
Another approach that tackles the distributed nature of meaning is assumed by geometrical models of semantics, which assume that the meaning of an InformationObject (e.g. a word) results from the set of informational contexts (e.g. within texts) in which that object is used similarly.
The logical approach to meaning is still different, since it assumes that the meaning of e.g. a term is equivalent to the set of individuals that the term can be applied to; for example, the meaning of 'Ali' is e.g. an individual person called Ali, the meaning of 'Airplane' is e.g. the set of airplanes, etc. 
Finally, an approach taken by structuralist linguistics and frame semantics is that a meaning is the relational context in which an information object can be applied; for example, a meaning of 'Airplane' is situated e.g. in the context ('frame') of passenger airline flights.

These different approaches are not necessarily conflicting, and they mostly talk about different aspects of so-called 'semantics'. They can be summarized and modelled within DOLCE-Ultralite as follows (notice that such list is far from exhaustive):

(1) Informal meaning (as for linguistic or commonsense semantics: a distinction is assumed between (informal) meaning and reference; see isAbout for an alternative pattern on reference)
	- Paraphrase meaning (as for lexicographic semantics). Here it is modelled as the expresses relation between instances of InformationObject and different instances of InformationObject that act as 'paraphrases'
	- Conceptual meaning (as for 'concept scheme' semantics). Here it is modelled as the expresses relation between instances of InformationObject and instances of Concept
	- Relational meaning (as for frame semantics). Here it is modelled as the expresses relation between instances of InformationObject and instances of Description
	- Cognitive meaning (as for 'psychological' semantics). Here it is modelled as the expresses relation between any instance of InformationObject and any different instance of InformationObject that isRealizedBy a mental, cognitive or neural state (depending on which theory of mind is assumed). Such states can be considered here as instances of Process (occurring in the mind, cognitive system, or neural system of an agent)
	- Cultural meaning (as for 'social science' semantics). Here it is modelled as the expresses relation between instances of InformationObject and instances of SocialObject (institutions, cultural paradigms, norms, social practices, etc.)
	- Distributional meaning (as for geometrical models of meaning). Here it is modelled as the expresses relation between any instance of InformationObject and any different instance of InformationObject that isFormallyRepresentedIn some (geometrical) Region (e.g. a vector space)

(2) Formal meaning (as for logic and formal semantics: no distinction is assumed between informal meaning and reference, therefore between 'expresses' and 'isAbout', which can be used interchangeably)
	- Object-level formal meaning (as in the traditional first-order logic semantics). Here it is modelled as the expresses relation between an instance of InformationObject and an instance of Collection that isGroundingFor (in most cases) a Set; isGroundingFor is defined in the ontology: http://www.ontologydesignpatterns.org/ont/dul/IOLite.owl
	- Modal formal meaning (as in possible-world semantics). Here it is modelled as the expresses relation between an instance of InformationObject and an instance of Collection that isGroundingFor a Set, and which isPartOf some different instance of Collection that isGroundingFor a PossibleWorld

This is only a first step to provide a framework, in which one can model different aspects of meaning. A more developed ontology should approach the problem of integrating the different uses of 'expresses', so that different theories, resources, methods can interoperate.""" ;
    rdfs:domain dul:InformationObject ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:SocialObject ;
    rdfs:subPropertyOf dul:associatedWith,
        dul:isAbout ;
    owl:inverseOf dul:isExpressedBy .

dul:isSatisfiedBy a owl:ObjectProperty ;
    rdfs:label "is satisfied by"@en ;
    rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan." ;
    rdfs:domain dul:Description ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Situation ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:satisfies .

owl:Thing a owl:Class ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl> .

sosa:hasSimpleResult a owl:DatatypeProperty ;
    rdfs:label "has simple result"@en ;
    rdfs:comment "The simple value of an Observation or Actuation or act of Sampling."@en ;
    rdfs:isDefinedBy sosa: .

sosa:madeBySensor a owl:ObjectProperty ;
    rdfs:label "made by sensor"@en ;
    rdfs:comment "Relation between an Observation and the Sensor which made the Observation."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf dul:associatedWith .

sosa:observedProperty a owl:ObjectProperty ;
    rdfs:label "observed property"@en ;
    rdfs:comment "Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf dul:associatedWith .

sosa:observes a owl:ObjectProperty ;
    rdfs:label "observes"@en ;
    rdfs:comment "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en ;
    rdfs:isDefinedBy sosa: .

sosa:phenomenonTime a owl:ObjectProperty ;
    rdfs:label "phenomenon time"@en ;
    rdfs:comment "The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subPropertyOf dul:hasRegion .

insight:Intervention_disable_wheel a insight:SimulationIntervention ;
    rdfs:label "disable wheel"@en ;
    insight:catalogId "disable_wheel" ;
    insight:isExperimental false .

insight:Intervention_nominal_replay a insight:SimulationIntervention ;
    rdfs:label "nominal replay"@en ;
    insight:isExperimental false ;
    rdfs:comment "The replay of the recorded setpoints without any cause; always simulated first."@en .

insight:Intervention_override_setpoint a insight:SimulationIntervention ;
    rdfs:label "override setpoint"@en ;
    insight:isExperimental true ;
    rdfs:comment "Prototype in experiments/: the base does not execute the recorded setpoint (a brake or a jerk nobody ordered)."@en .

insight:Intervention_set_friction a insight:SimulationIntervention ;
    rdfs:label "set friction"@en ;
    insight:catalogId "set_friction" ;
    insight:isExperimental false .

insight:Intervention_spawn_scaled_dome a insight:SimulationIntervention ;
    rdfs:label "spawn scaled dome"@en ;
    insight:catalogId "spawn_scaled_dome" ;
    insight:isExperimental false ;
    rdfs:comment "A bump of unknown size: each repetition draws the diameter and height of a dome over the range the robot sets (contracts 1.5)."@en .

insight:Intervention_spawn_static_object a insight:SimulationIntervention ;
    rdfs:label "spawn static object"@en ;
    insight:catalogId "spawn_static_object" ;
    insight:isExperimental false .

insight:SampledValue a owl:Class ;
    rdfs:label "sampled value"@en ;
    rdfs:comment "A value the simulator drew in the best repetition of a run (e.g. the diameter of the dome): a magnitude the LLM does not choose, which the memory leaves open over the catalog's range and the simulation samples. dul:hasDataValue holds the number and insight:quantityName what it measures."@en ;
    rdfs:subClassOf dul:Region .

insight:SegmentAnchor a insight:AnchorKind ;
    rdfs:label "segment anchor"@en ;
    rdfs:comment "The hypothesis names a path segment of the episode."@en .

insight:VerifiedCause a owl:Class ;
    rdfs:label "verified cause"@en ;
    rdfs:comment "The cause the inner simulation accepted for an anomaly case: the event of the accepted hypothesis (dul:hasSetting), described by its mechanism (dul:isDescribedBy), located at its anchors in the episode (dul:hasLocation, dul:hasTimeInterval), verified by a simulation run (insight:verifiedBy), and the cause of the accident (soma:causes). The anomaly case is explained by it (inst:explainedBy)."@en ;
    rdfs:subClassOf dul:Event .

insight:pre_bottle_supported a insight:Precondition ;
    insight:ruleEffect "incoherent" ;
    insight:ruleId "bottle_supported" ;
    insight:ruleStatus "fixed" ;
    rdfs:comment "The support of the bottle covers the start of the anchored interval."@en .

insight:pre_moving_on_segment a insight:Precondition ;
    insight:ruleEffect "incoherent" ;
    insight:ruleId "moving_on_segment" ;
    insight:ruleStatus "fixed" ;
    rdfs:comment "Mean speed on the anchored segment > 0.05 m/s."@en .

insight:reaction_onset a sosa:ObservableProperty ;
    rdfs:label "reaction onset"@en ;
    rdfs:comment "First setpoint event equal to 0 after t_obs (unfiltered) (s)."@en .

insight:rule_bottle_reacquired a insight:ContrastRule ;
    insight:checksProperty insight:bottle_reacquired ;
    insight:ruleEffect "discard" ;
    insight:ruleId "bottle_reacquired" ;
    insight:ruleStatus "to_calibrate" ;
    rdfs:comment "Discards if the bottle is not detected again before the end of the recording."@en .

insight:rule_obstacle_jolt a insight:ContrastRule ;
    insight:checksProperty insight:pitch_rate_peak,
        insight:vertical_accel_peak ;
    insight:ruleEffect "inform" ;
    insight:ruleId "obstacle_jolt" ;
    insight:ruleStatus "to_calibrate" ;
    rdfs:comment "Reports whether the pitch rate or vertical acceleration peaks exceed 3 times their baseline. Never discards unless the contrast task shows it never fails on the 5 recordings with a bump."@en .

insight:rule_person_within_reach a insight:ContrastRule ;
    insight:checksProperty insight:person_distance_min ;
    insight:ruleEffect "discard" ;
    insight:ruleId "person_within_reach" ;
    insight:ruleStatus "fixed" ;
    rdfs:comment "Discards if the person was never closer than 1.5 m (1 m reach plus 0.5 m margin)."@en .

insight:rule_robot_jolt a insight:ContrastRule ;
    insight:checksProperty insight:lateral_accel_peak,
        insight:speed_ratio,
        insight:yaw_change ;
    insight:ruleEffect "discard" ;
    insight:ruleId "robot_jolt" ;
    insight:ruleStatus "to_calibrate" ;
    rdfs:comment "Discards if the lateral peak <= 2 times its baseline, |speed ratio - 1| <= 0.15 and |recorded heading change - r * commanded heading change| < 3 deg, with r as in turn_vs_command."@en .

insight:rule_setpoint_step a insight:ContrastRule ;
    insight:checksProperty insight:setpoint_step ;
    insight:ruleEffect "explain_or_discard" ;
    insight:ruleId "setpoint_step" ;
    insight:ruleStatus "to_calibrate" ;
    rdfs:comment "Explained by memory if the filtered setpoint changes by >= 0.2 m/s within 0.5 s before t_obs; discarded otherwise."@en .

insight:rule_speed_ratio_and_jolt a insight:ContrastRule ;
    insight:checksProperty insight:longitudinal_accel_peak,
        insight:speed_ratio ;
    insight:ruleEffect "discard" ;
    insight:ruleId "speed_ratio_and_jolt" ;
    insight:ruleStatus "to_calibrate" ;
    rdfs:comment "Discards if |speed ratio - 1| <= 0.15 and the longitudinal peak <= 2 times its baseline."@en .

insight:rule_traction_vs_friction a insight:ContrastRule ;
    insight:checksProperty insight:max_sustained_horizontal_accel ;
    insight:ruleEffect "discard" ;
    insight:ruleId "traction_vs_friction" ;
    insight:ruleStatus "fixed" ;
    rdfs:comment "Discards if the sustained horizontal acceleration exceeds 1.1 * mu_max * g: such a floor could not have given that traction."@en .

insight:rule_turn_vs_command a insight:ContrastRule ;
    insight:checksProperty insight:speed_ratio,
        insight:yaw_change,
        insight:yaw_rate_peak ;
    insight:ruleEffect "discard" ;
    insight:ruleId "turn_vs_command" ;
    insight:ruleStatus "to_calibrate" ;
    rdfs:comment "Discards if |recorded heading change - r * commanded heading change| < 3 deg and the yaw rate peak < 0.3 rad/s. r is the episode's own travelled/ordered ratio in free motion (own_ratio_baseline of speed_ratio): under the Webots clock the robot turns, like it advances, only a fraction of what it is ordered."@en .

soma:BodyMovement a owl:Class ;
    rdfs:comment """Motion described in terms of how parts of an Agent's body move.

As such, this concept can be applied only to motions involving some PhysicalAgent, or body parts of a PhysicalAgent.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:Motion .

soma:Collision a owl:Class ;
    rdfs:comment "A contact event of objects bumping into each other such that their movement is affected." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:ProcessType .

soma:ConnectedObject a owl:Class ;
    rdfs:label "Connected object"@en ;
    rdfs:comment "An object that is combined with another object." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:Patient .

soma:DirectedMotion a owl:Class ;
    rdfs:label "Directed motion" ;
    rdfs:comment "A Motion that is considered to be toward a location or along a path. It is not important that the final location or path be the intention of some Agent, but it is considered that the important feature of this Motion is that it has a path and/or destination." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:Motion .

soma:ExecutionState_Active a soma:ExecutionStateRegion,
        owl:NamedIndividual ;
    rdfs:comment "The execution state of an ongoing activity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> .

soma:ExecutionState_Cancelled a soma:ExecutionStateRegion,
        owl:NamedIndividual ;
    rdfs:comment "The execution state of a cancelled activity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> .

soma:ExecutionState_Failed a soma:ExecutionStateRegion,
        owl:NamedIndividual ;
    rdfs:comment "The execution state of a failed activity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> .

soma:ExecutionState_Paused a soma:ExecutionStateRegion,
        owl:NamedIndividual ;
    rdfs:comment "The execution state of a paused activity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> .

soma:ExecutionState_Pending a soma:ExecutionStateRegion,
        owl:NamedIndividual ;
    rdfs:comment "The execution state of a pending activity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> .

soma:ExecutionState_Succeeded a soma:ExecutionStateRegion,
        owl:NamedIndividual ;
    rdfs:comment "The execution state of a succeeded activity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> .

soma:FrictionAttribute a owl:Class ;
    rdfs:label "Friction attribute" ;
    rdfs:comment "The resistance that one surface or object encounters when moving over another." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:PhysicalAttribute .

soma:FunctionalControl a owl:Class ;
    rdfs:label "Functional state"@en ;
    rdfs:comment """Classifies States in which an object restricts the movement of another, at least partially. Usually neither object is construed to be an agent.

Note that this State focuses on how the interaction of, usually non-agentive, objects restricts their motion. This is in contrast to Blockage/Accessibility states where the placement of some objects influences the access to some of them by a third, usually agentive party.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:StateType .

soma:FunctionalDiagnosis a owl:Class ;
    rdfs:label "Functional diagnosis" ;
    rdfs:comment "An internal diagnosis of a system." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:Diagnosis .

soma:FunctionalPart a owl:Class ;
    rdfs:label "Functional part" ;
    rdfs:comment "Parts of an agent or an artifact are considered as functional parts." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:PhysicalBody .

soma:Instrument a owl:Class ;
    rdfs:comment "An object used to carry out the event." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:ResourceRole .

soma:Patient a owl:Class ;
    rdfs:comment "A role classifying an object that undergoes/is the primary object affected by the event." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:EventAdjacentRole .

soma:Reasoner a owl:Class ;
    rdfs:comment """A Reasoner is some Software that can infer new, implicit knowlegde from explicitly stated knowledge.

This definition is broad and we consider any System fitting the above description as reasoners. For example, the following can be seen as Reasoners:
* A simulation, where the explicit knowledge corresponds to the initial situation, and the implicit knowlegde corresponds to the situation that is derived from that by simulating some unfolding processes.
* A machine learning algorithm, e.g., an image classifier: The explicit knowledge is the visual content of a picture (even down to the pixel), the implicit knowledge is the derived classification.
* A logic based rule engine, where initial facts are the explicit knowledge, and derived facts are the implicit knowledge."""@en ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:SoftwareRole .

soma:Reification a owl:Class ;
    rdfs:comment "A description that *describes* a formal entity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:anyURI ;
            owl:onProperty soma:isReificationOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        dul:Description .

soma:ResourceRole a owl:Class ;
    rdfs:label "Resource role"@en ;
    rdfs:comment """A role classifying objects that are useful or even necessary to sustain the unfolding of an event.

Resources are usually not agentive; a different set of roles classifies the agentive participants in actions. Likewise, typically resources do not play causative or goal roles for the event.

Resources are often consumed by their participation in an event, but this need not always be the case. An instrument and capital are examples of resources that are reusable.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:EventAdjacentRole .

soma:Restrictor a owl:Class ;
    rdfs:comment "A role classifying an object used to deny access to some other entity." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:Instrument .

soma:Simulation_Reasoner a owl:Class ;
    rdfs:label "Simulation-based reasoner"@en ;
    rdfs:comment "A Simulation-based Reasoner is a simulation that is used as a reasoner, where the explicit knowledge corresponds to the initial situation, and the implicit knowlegde corresponds to the situation that is derived from that by simulating some unfolding processes."@en ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:Reasoner .

soma:SoftwareDiagnosis a owl:Class ;
    rdfs:label "Software diagnosis" ;
    rdfs:comment "A diagnosis of the software of a system." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:TechnicalDiagnosis .

soma:SoftwareRole a owl:Class ;
    rdfs:label "Software role"@en ;
    rdfs:comment "A Software Role is a Role applying to only Software and encoding the purpose of the Software: Its Role within Interface Patterns (e.g. Client vs. Server), its functionality (e.g. Database vs. Comnputer Game), and so on."@en ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:Role .

soma:State a owl:Class ;
    rdfs:comment """States are stative and homeomeric events.

For stative events, the mereological sum of two instances has the same type as both instances. This is, for example, the state of sitting on a chair, or the process of a pendulum swinging around.

The difference between states and processes is that states are, in addition, homeomeric, and processes are not.  This means that, when considering time slices  of an event, for states, these time slices always have the same type as the state, but for processes this is not the case.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:Event .

soma:StateType a owl:Class ;
    rdfs:label "State type"@en ;
    rdfs:comment "An EventType that classifies States." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:EventType .

soma:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    rdfs:comment "Simple relationship between two actions to express that a variation in the course or outcome of the subject (the affector) would have resulted in a variation in the object (the affectee), e.g., a planning task that sets parameters such as goal position affects the subsequently executed pick-and-place task that uses that parameter." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:subPropertyOf dul:precedes ;
    owl:inverseOf soma:isAffectedBy .

soma:causes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "causes"@en ;
    soma:UsageGuideline """Simple relationship between two actions to express that the object (the reaction) would not have occured if it were not for the subject (the cause), e.g., a Communication Action classified as an Querying Task causes another Communication Task classified as an Answering Task and the latter would not have occured without the former. An example without Agents involved is some domino stone that would not have toppled without the first one toppling.

When Agents are involved, the relation might be seen as an abstraction of the execution of some plan that arises from changing the agents goal that is due to perceiving the cause. However, currently it is unclear how to model such a pattern and therefore not included in SOMA.

This relation is seen as transitive."""@en ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:subPropertyOf soma:affects ;
    owl:inverseOf soma:isReactionTo .

soma:isCausedByEvent a owl:ObjectProperty ;
    rdfs:label "is caused by event" ;
    rdfs:comment "A relation recording that a Transition is the result of some Event." ;
    rdfs:domain dul:Transition ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf dul:includesEvent .

soma:isDirectReactionTo a owl:ObjectProperty ;
    rdfs:label "is direct reaction to"@en ;
    rdfs:comment "Non-transitive version of \"is reaction to\"."@en ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf soma:isReactionTo .

soma:isOccurrenceOf a owl:ObjectProperty ;
    rdfs:label "is occurrence of" ;
    rdfs:comment "A relation between an event and an event type, e.g. 'taking the cup from the table' is an occurence of the motion 'approaching'." ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:range dul:EventType ;
    rdfs:subPropertyOf dul:isClassifiedBy ;
    owl:inverseOf soma:isOccurringIn .

soma:isPlanFor a owl:ObjectProperty ;
    rdfs:label "is plan for"@en ;
    rdfs:comment "A special relation between a Plan and a Task, to indicate that the Plan describes a way to achieve the Task." ;
    rdfs:domain dul:Plan ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:range dul:Task ;
    rdfs:seeAlso "Note that DUL already says Plans can define Tasks, but that relation is used differently: a Plan defines a Task because it contains it as a step." ;
    rdfs:subPropertyOf dul:describes .

soma:isReificationOf a owl:DatatypeProperty ;
    rdfs:label "is reification of" ;
    rdfs:comment "An auxiliary property that is used to generate object individuals, called reifications, from any other Entity, e.g. from relations, classes, data types. These reifications can then be used in DL axioms as any other named individual." ;
    rdfs:domain dul:Description ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf dul:hasDataValue .

<http://www.ease-crc.org/ont/SOMA.owl/manifestsIn> a owl:ObjectProperty ;
    rdfs:label "manifests in" ;
    rdfs:comment "A relationship indicating that a Situation is realized in an Event that actually happened." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:subPropertyOf dul:includesEvent .

ocra:Collaboration a owl:Class ;
    rdfs:label "Collaboration"@en ;
    rdfs:comment """An Event in which two or more Agents share a Goal and share and execute a Plan to achieve the Goal, by interacting and/or delegating to some of them when and where to execute some parts of the plan.




[Note] We use interaction as a general term, an occasion when two or more people or things communicate with or react to each other. For example, during a collaboration, a robot and a human interact when they exchange forces, and also when the robot is sharing its perception about the safety situation (e.g. by voice or lights). One example of non-interaction is when the robot monitores the human’s pose by means of sensors. 

[Note] We use delegation also as a general term, the act of giving a particular job, duty, etc. to someone else. Since in a collaboration all the involved agents share the goal to be achieved, even when an agent delegates part of a plan, we understand that the agent is still responsible for that part of the plan. 

[Note] We do not restrict the definition stating that the pursued goal must be achieved at the end of the collaboration, thus, being general and considering cases in which that is not true. Furthermore, the relationship ‘executesPlan’ is used here as a primitive which means ‘following the sequence of actions in the plan as much as possible’. Hence, we do not consider this notion in the strictest sense, which would be to execute the whole plan. 

[Example] Let’s consider that there is a robot and a human that are collaborating to fill the different compartments of a tray with work pieces. We will say that the collaboration exists as long as: 
The robot and the human share and execute a Plan to fill the tray (e.g. sequence of steps to fill the tray). Note that the plan can be general: e.g. ‘picking some work pieces and placing them on the tray until it is full’. The plan can be more specific: ‘picking the work pieces from the top of a pile of pieces and placing them on the tray from the left to the right and from the closest to the furthest compartment’; 
The robot and the human share the Goal to be achieved by the execution of the shared plan. It can also be general, e.g. ‘all tray’s compartments with a work piece’, or more specific, e.g. ‘each tray’s compartment full with a certain work piece’;
The robot and the human interact and/or delegate to some of them when and where to execute some parts of the plan. Note that the agreement can be flexible: e.g. ‘the part of the plan delegated to an agent must be finished within the next two days’; 

[Rationale] A Collaboration exists if and only if two or more agents share a plan, maintain a shared understanding about it through interaction, and share the goal to be achieved by the plan. Hence, there is an agreement among all the agents on what to do, when, where, why and how to do it, how the execution is distributed, and, if needed, who decides or how to decide (collaborations include supervision and delegation)."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ocra:Collaboration ;
            owl:onProperty dul:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Plan ;
            owl:onProperty ocra:executesPlan ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass [ a owl:Class ;
                    owl:intersectionOf ( dul:Agent [ a owl:Restriction ;
                                owl:allValuesFrom dul:Goal ;
                                owl:onProperty ocra:hasGoal ] [ a owl:Restriction ;
                                owl:allValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( dul:Plan [ a owl:Restriction ;
                                                    owl:onProperty dul:hasComponent ;
                                                    owl:someValuesFrom dul:Goal ] ) ] ;
                                owl:onProperty ocra:hasPlan ] ) ] ;
            owl:onProperty dul:hasParticipant ],
        dul:Event ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( dul:Event [ a owl:Restriction ;
                        owl:allValuesFrom dul:Plan ;
                        owl:onProperty ocra:executesPlan ] [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass [ a owl:Class ;
                                owl:intersectionOf ( dul:Agent [ a owl:Restriction ;
                                            owl:allValuesFrom dul:Goal ;
                                            owl:onProperty ocra:hasGoal ] [ a owl:Restriction ;
                                            owl:allValuesFrom [ a owl:Class ;
                                                    owl:intersectionOf ( dul:Plan [ a owl:Restriction ;
                                                                owl:onProperty dul:hasComponent ;
                                                                owl:someValuesFrom dul:Goal ] ) ] ;
                                            owl:onProperty ocra:hasPlan ] ) ] ;
                        owl:onProperty dul:hasParticipant ] ) ] .

ocra:isGoalOf a owl:ObjectProperty ;
    rdfs:label "is goal of"@en ;
    rdfs:comment "The relation holding between a Goal, and an Agent that desires that Goal."@en ;
    rdfs:domain dul:Goal ;
    rdfs:range dul:Agent ;
    rdfs:subPropertyOf dul:associatedWith .

ocra:isPlanExecutedIn a owl:ObjectProperty ;
    rdfs:label "is plan executed in"@en ;
    rdfs:comment "The relation holding between a Plan, and an Event that executes that plan."@en ;
    rdfs:domain dul:Plan ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf dul:associatedWith .

ocra:isPlanOf a owl:ObjectProperty ;
    rdfs:label "is plan of"@en ;
    rdfs:comment "The relation holding between a Plan, and the Agent that has that Plan to achieve one of its desired Goals."@en ;
    rdfs:domain dul:Plan ;
    rdfs:range dul:Agent ;
    rdfs:subPropertyOf dul:associatedWith .

dul:Abstract a owl:Class ;
    rdfs:label "Abstract"@en ;
    rdfs:comment "Any Entity that cannot be located in space-time. E.g. mathematical entities: formal semantics elements, regions within dimensional spaces, etc." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Entity ;
    owl:disjointWith dul:Event,
        dul:Object .

dul:DesignedArtifact a owl:Class ;
    rdfs:label "Designed artifact"@en,
        "Artefatto progettato"@it ;
    rdfs:comment "A PhysicalArtifact that is also described by a Design. This excludes simple recycling or refunctionalization of natural objects. Most common sense 'artifacts' can be included in this class: cars, lamps, houses, chips, etc." ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:PhysicalArtifact .

dul:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis"@en,
        "Diagnosi"@it ;
    rdfs:comment "A Description of the Situation of a system, usually applied in order to control a normal behaviour, or to explain a notable behavior (e.g. a functional breakdown)." ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Description .

dul:InformationEntity a owl:Class ;
    rdfs:label "Information Entity"@en ;
    rdfs:comment """A piece of information, be it concretely realized or not. It is a catchall class, intended to bypass the ambiguities of many data or text that could denote either a an expression or a concrete realization of that expression.
In a semiotic model, there is no special reason to distinguish between them, however we may want to distinguish between a pure information content (e.g. the 3rd Gymnopedie by Satie), and its possible concrete realizations as a music sheet, a piano execution, the reproduction of the execution, its publishing as a record, etc.).""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Entity .

dul:Parameter a owl:Class ;
    rdfs:label "Parameter"@en,
        "Parametro"@it ;
    rdfs:comment "A Concept that classifies a Region; the difference between a Region and a Parameter is that regions represent sets of observable values, e.g. the height  of a given building, while parameters represent constraints or selections on observable values, e.g. 'VeryHigh'. Therefore, parameters can also be used to constrain regions, e.g. VeryHigh on a subset of values of the Region Height applied to buildings, or to add an external selection criterion , such as measurement units, to regions, e.g. Meter on a subset of values from the Region Length applied to the Region Length applied to roads." ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Concept .

dul:PhysicalArtifact a owl:Class ;
    rdfs:label "Physical artifact"@en,
        "Artefatto fisico"@it ;
    rdfs:comment """Any PhysicalObject that isDescribedBy a Plan .
This axiomatization is weak, but allows to talk of artifacts in a very general sense, i.e. including recycled objects, objects with an intentional functional change, natural objects that are given a certain function, even though they are not modified or structurally designed, etc. PhysicalArtifact(s) are not considered disjoint from PhysicalBody(s), in order to allow a dual classification when needed. E.g.,
FunctionalSubstance(s) are included here as well.
Immaterial (non-physical) artifacts (e.g. texts, ideas, cultural movements, corporations, communities, etc. can be modelled as social objects (see SocialObject), which are all 'artifactual' in the weak sense assumed here.""" ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:PhysicalObject .

dul:PhysicalAttribute a owl:Class ;
    rdfs:label "Physical attribute"@en,
        "Caratteristica fisica"@it ;
    rdfs:comment "Physical value of a physical object, e.g. density, color, etc." ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Region .

dul:PhysicalBody a owl:Class ;
    rdfs:label "Physical body"@en ;
    rdfs:comment "Physical bodies are PhysicalObject(s), for which we tend to neutralize any possible artifactual character. They can have several granularity levels: geological, chemical, physical, biological, etc." ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:PhysicalObject .

dul:PhysicalPlace a owl:Class ;
    rdfs:label "Physical place"@en ;
    rdfs:comment "A physical object that is inherently located; for example, a water area." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:PhysicalObject .

dul:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment """This is a placeholder for events that are considered in their evolution, or anyway not strictly dependent on agents, tasks, and plans. 
See Event class for some thoughts on classifying events. See also 'Transition'.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Event .

dul:Quality a owl:Class ;
    rdfs:label "Quality"@en,
        "QualitÃ "@it ;
    rdfs:comment """Any aspect of an Entity (but not a part of it), which cannot exist without that Entity. For example, the way the surface of a specific PhysicalObject looks like, or the specific light of a place at a certain time, are examples of Quality, while the encoding of a Quality into e.g. a PhysicalAttribute should be modeled as a Region. 
From the design viewpoint, the Quality-Region distinction is useful only when individual aspects of an Entity are considered in a domain of discourse. 
For example, in an automotive context, it would be irrelevant to consider the aspects of car windows for a specific car, unless the factory wants to check a specific window against design parameters (anomaly detection). 
On the other hand, in an antiques context, the individual aspects for a specific piece of furniture are a major focus of attention, and may constitute the actual added value, because the design parameters for old furniture are often not fixed, and may not be viewed as 'anomalies'.""" ;
    rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Entity .

dul:coparticipatesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "co-participates with"@en ;
    rdfs:comment "A relation between two objects participating in a same Event; e.g., 'Vitas and Jimmy are playing tennis'." ;
    rdfs:domain dul:Object ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Object ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:coparticipatesWith ;
    owl:propertyChainAxiom ( dul:isParticipantIn dul:hasParticipant ) .

dul:describes a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:comment """The relation between a Description and an Entity : a Description gives a unity to a Collection of parts (the components), or constituents, by assigning a Role to each of them in the context of a whole Object (the system).
A same Entity can be given different descriptions, for example, an old cradle can be given a unifying Description based on the original aesthetic design, the functionality it was built for, or a new aesthetic functionality in which it can be used as a flower pot.""" ;
    rdfs:domain dul:Description ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isDescribedBy .

dul:follows a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "follows"@en ;
    rdfs:comment """A relation between entities, expressing a 'sequence' schema. 
E.g. 'year 2000 follows 1999', 'preparing coffee' follows 'deciding what coffee to use', 'II World War follows I World War', etc. 
It can be used between tasks, processes or time intervals, and subproperties would fit best in order to distinguish the different uses.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:precedes .

dul:hasDataValue a owl:DatatypeProperty ;
    rdfs:label "has data value"@en ;
    rdfs:comment """A datatype property that encodes values from a datatype for an Entity. 
There are several ways to encode values in DOLCE (Ultralite):

1) Directly assert an xsd:_ value to an Entity by using hasDataValue
2) Assert a Region for an Entity by using hasRegion, and then assert an xsd:_ value to that Region, by using hasRegionDataValue
3) Assert a Quality for an Entity by using hasQuality, then assert a Region for that Quality, and assert an xsd:_ value to that Region, by using hasRegionDataValue
4) When the value is required, but not directly observed, assert a Parameter for an xsd:_ value by using hasParameterDataValue, and then associate the Parameter to an Entity by using isConstraintFor
5) When the value is required, but not directly observed, you can also assert a Parameter for a Region by using parametrizes, and then assert an xsd:_ value to that Region, by using hasRegionDataValue

The five approaches obey different requirements. 
For example, a simple value can be easily asserted by using pattern (1), but if one needs to assert an interval between two values, a Region should be introduced to materialize that interval, as pattern (2) suggests. 
Furthermore, if one needs to distinguish the individual Quality of a value, e.g. the particular nature of the density of a substance, pattern (3) can be used. 
Patterns (4) and (5) should be used instead when a constraint or a selection is modeled, independently from the actual observation of values in the real world.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> .

dul:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location"@en ;
    rdfs:comment """A generic, relative spatial location, holding between any entities. E.g. 'the cat is on the mat', 'Omar is in Samarcanda', 'the wound is close to the femural artery'.
For 'absolute' locations, see SpaceRegion""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isLocationOf .

dul:hasTimeInterval a owl:ObjectProperty ;
    rdfs:label "has time interval"@en ;
    rdfs:comment "The generic relation between events and time intervals."@en ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:TimeInterval ;
    rdfs:subPropertyOf dul:hasRegion ;
    owl:inverseOf dul:isTimeIntervalOf .

dul:includesObject a owl:ObjectProperty ;
    rdfs:label "includes object"@en ;
    rdfs:comment "A relation between situations and objects, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included me)." ;
    rdfs:domain dul:Situation ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Object ;
    rdfs:subPropertyOf dul:isSettingFor ;
    owl:inverseOf dul:isObjectIncludedIn .

dul:includesTime a owl:ObjectProperty ;
    rdfs:label "includes time"@en ;
    rdfs:comment "A relation between situations and time intervals, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: preparing my coffee was held this morning). A data value attached to the time interval typically complements this modelling pattern." ;
    rdfs:domain dul:Situation ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:TimeInterval ;
    rdfs:subPropertyOf dul:isSettingFor ;
    owl:inverseOf dul:isTimeIncludedIn .

dul:isAbout a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:comment """A relation between an information object and an Entity (including information objects). It can be used to talk about entities that are references of proper nouns: the proper noun 'Leonardo da Vinci' isAbout the Person Leonardo da Vinci; as well as to talk about sets of entities that can be described by a common noun: the common noun 'person' isAbout the set of all persons in a domain of discourse, which can be represented in DOLCE-Ultralite as an individual of the class: dul:Collection.
A specific sentence may use common nouns with either a singular or plural reference, or it can even refer to all possible references (e.g. in a lexicographic definition): all those uses are kinds of aboutness.

The isAbout relation is sometimes considered as reflexive, however this is semiotically inaccurate, because information can be about itself ('de dicto' usage, as in 'John is four character long'), but it is typically about something else ('de re' usage, as in 'John loves Mary').
If a reflexivity exists in general, it rather concerns its realisation, which is always associated with an event, e.g. an utterance, which makes the information denoting itself, besides its aboutness. This is implemented in DUL with the dul:realizesSelfInformation property, which is used with local reflexivity in the dul:InformationRealization class.""" ;
    rdfs:domain dul:InformationObject ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isReferenceOf .

dul:isComponentOf a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "is component of"@en ;
    rdfs:comment "The asymmetric isProperPartOf relation without transitivity, holding between an Object (the system) and another (the component), and assuming a Design that structures the Object." ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:isPropertPartOf .

dul:isConceptUsedIn a owl:ObjectProperty ;
    rdfs:label "is concept used in"@en ;
    rdfs:comment "A more generic relation holding between a Description and a Concept. In order to be used, a Concept must be previously definedIn another Description" ;
    rdfs:domain dul:Concept ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Description ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:usesConcept .

dul:isDescribedBy a owl:ObjectProperty ;
    rdfs:label "is described by"@en ;
    rdfs:comment """The relation between an Entity and a Description: a Description gives a unity to a Collection of parts (the components), or constituents, by assigning a Role to each of them in the context of a whole Object (the system).
A same Entity can be given different descriptions, for example, an old cradle can be given a unifying Description based on the original aesthetic design, the functionality it was built for, or a new aesthetic functionality in which it can be used as a flower pot.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-OBJ.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Description ;
    rdfs:subPropertyOf dul:associatedWith .

dul:isLocationOf a owl:ObjectProperty ;
    rdfs:label "is location of"@en ;
    rdfs:comment """A generic, relative localization, holding between any entities. E.g. 'Rome is the seat of the Pope', 'the liver is the location of the tumor'.
For 'absolute' locations, see SpaceRegion""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith .

dul:isObjectIncludedIn a owl:ObjectProperty ;
    rdfs:label "is object included in"@en ;
    rdfs:domain dul:Object ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Situation ;
    rdfs:subPropertyOf dul:hasSetting .

dul:isTimeIncludedIn a owl:ObjectProperty ;
    rdfs:label "is time included in"@en ;
    rdfs:domain dul:TimeInterval ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Situation ;
    rdfs:subPropertyOf dul:hasSetting .

dul:isTimeIntervalOf a owl:ObjectProperty ;
    rdfs:label "is time interval of"@en ;
    rdfs:comment "The generic relation between time intervals and events."@en ;
    rdfs:domain dul:TimeInterval ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf dul:isRegionFor .

dul:sameSettingAs a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is in the same setting as"@en ;
    rdfs:comment "A relation between two entities participating in a same Situation; e.g., 'Our company provides an antivenom service' (the situation is the service, the two entities are the company and the antivenom)."@it ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl" ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:sameSettingAs ;
    owl:propertyChainAxiom ( dul:hasSetting dul:isSettingFor ) .

inst:AnomalyCase a owl:Class ;
    rdfs:label "anomaly case"@en ;
    rdfs:comment "A perceived change the robot could not explain when it happened. The consolidation links it to the event that explains it."@en ;
    rdfs:subClassOf dul:Situation .

insight:Episode a owl:Class ;
    rdfs:label "episode"@en ;
    rdfs:comment "The abstracted episode of an unexplained change: phases, path segments, intervals, the support state, the accident and the evidence. Built from the working memory (DSR) or from a recording."@en ;
    rdfs:subClassOf dul:Situation .

insight:Intervention_apply_external_force a insight:SimulationIntervention ;
    rdfs:label "apply external force"@en ;
    insight:catalogId "apply_external_force" ;
    insight:isExperimental false .

insight:PathSegment a owl:Class ;
    rdfs:label "path segment"@en ;
    rdfs:comment "A stretch of the path the robot drove, counted back from its pose at the fall in pieces of 1 m (Segment_final is the last metre)."@en ;
    rdfs:subClassOf dul:PhysicalPlace .

insight:pre_moving_in_interval a insight:Precondition ;
    insight:ruleEffect "incoherent" ;
    insight:ruleId "moving_in_interval" ;
    insight:ruleStatus "fixed" ;
    rdfs:comment "Mean speed in the anchored interval > 0.05 m/s."@en .

soma:EventAdjacentRole a owl:Class ;
    rdfs:label "Event adjacent role"@en,
        "Thematic role"@en ;
    rdfs:comment """A role classifying a participant in an event.

In linguistics, this is also known as a thematic role.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:Role .

soma:ForceInteraction a owl:Class ;
    rdfs:label "Force interaction" ;
    rdfs:comment "Classifies events in which two entities interact with each other with a reference to force. One of the entities, the agonist, has a tendency to either set the other entity (the antagonist) into motion, or to keep it still under the influence of some other force. The tendency only manifests in case the agonist is the \"stronger entity\"." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:ProcessType .

soma:Motion a owl:Class ;
    rdfs:comment "An EventType that classifies motion Processes.",
        "Motion type" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:ProcessType .

soma:TechnicalDiagnosis a owl:Class ;
    rdfs:label "Technical diagnosis" ;
    rdfs:comment "A functional diagnosis of a technical system." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:FunctionalDiagnosis .

soma:isAffectedBy a owl:ObjectProperty ;
    rdfs:label "is affected by" ;
    rdfs:comment "Simple relationship between two actions to express that a variation in the course or outcome of the object (the affector) would have resulted in a variation in the subject (the affectee), e.g., a planning task that sets parameters such as goal position affects the subsequently executed pick-and-place task that uses that parameter." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:subPropertyOf dul:follows .

soma:isOccurringIn a owl:ObjectProperty ;
    rdfs:label "is occurring in" ;
    rdfs:comment "A relation between an event and an event type, e.g. 'taking the cup from the table' is an occurence of the motion 'approaching'." ;
    rdfs:domain dul:EventType ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf dul:classifies .

soma:isReactionTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is reaction to" ;
    rdfs:comment """Simple relationship between two actions to express that the subject (the reaction) would not have occured if it were not for the object (the cause), e.g., a Communication Action classified as an Answering Task is a reaction to another Communication Task classified as a Query Task and would not have occured without the other. An example without Agents involved would be some domino stone would not have toppled without the first one toppling.

When Agents are involved, the relation might be seen as an abstraction of the execution of some plan that arises from changing the agents goal that is due to perceiving the cause. However, currently it is unclear how to model such a pattern and therefore not included in SOMA.

This relation is seen as transitive."""@en ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf soma:isAffectedBy .

ocra:executesPlan a owl:ObjectProperty ;
    rdfs:label "executes plan"@en ;
    rdfs:comment """The relation holding between an Event, and a Plan that is executed by the Event. 

This relationship is used as a primitive which means ‘following the sequence of actions in the plan as much as possible’."""@en ;
    rdfs:domain dul:Event ;
    rdfs:range dul:Plan ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf ocra:isPlanExecutedIn .

ocra:hasGoal a owl:ObjectProperty ;
    rdfs:label "has goal"@en ;
    rdfs:comment "The relation holding between any Agent, and a Goal desired by the Agent."@en ;
    rdfs:domain dul:Agent ;
    rdfs:range dul:Goal ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf ocra:isGoalOf .

ocra:hasPlan a owl:ObjectProperty ;
    rdfs:label "has plan"@en ;
    rdfs:comment "The relation holding between any Agent, and its Plan to achieve one of its desired Goals."@en ;
    rdfs:domain dul:Agent ;
    rdfs:range dul:Plan ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf ocra:isPlanOf .

dul:Transition a owl:Class ;
    rdfs:label "Transition"@en ;
    rdfs:comment """A transition is a Situation that creates a context for three TimeInterval(s), two additional different Situation(s), one Event, one Process, and at least one Object: the Event is observed as the cause for the transition, one Situation is the state before the transition, the second Situation is the state after the transition, the Process is the invariance under some different transitions (including the one represented here), in which at least one Object is situated. Finally, the time intervals position the situations and the transitional event in time.
This class of situations partly encodes the ontology underlying typical engineering algebras for processes, e.g. Petri Nets. 
A full representation of the transition ontology is outside the expressivity of OWL, because we would need qualified cardinality restrictions,  coreference, property equivalence, and property composition.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dul:isSettingFor ;
            owl:someValuesFrom dul:Process ],
        [ a owl:Restriction ;
            owl:onProperty dul:isSettingFor ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( dul:Situation [ a owl:Restriction ;
                                owl:onProperty dul:precedes ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( dul:Event [ a owl:Restriction ;
                                                    owl:onProperty dul:precedes ;
                                                    owl:someValuesFrom dul:Situation ] ) ] ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty dul:includesObject ;
            owl:someValuesFrom dul:Object ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass dul:Situation ;
            owl:onProperty dul:isSettingFor ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onClass dul:TimeInterval ;
            owl:onProperty dul:includesTime ],
        [ a owl:Restriction ;
            owl:onProperty dul:includesEvent ;
            owl:someValuesFrom dul:Event ],
        dul:Situation .

dul:executesTask a owl:ObjectProperty ;
    rdfs:label "executes task"@en ;
    rdfs:comment "A relation between an action and a task, e.g. 'putting some water in a pot and putting the pot on a fire until the water starts bubbling' executes the task 'boiling'." ;
    rdfs:domain dul:Action ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Task ;
    rdfs:subPropertyOf soma:isOccurrenceOf,
        dul:isClassifiedBy ;
    owl:inverseOf dul:isExecutedIn .

dul:hasProperPart a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has proper part"@en ;
    rdfs:comment "Asymmetric (so including irreflexive) parthood." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl> ;
    rdfs:subPropertyOf dul:hasPart ;
    owl:inverseOf dul:isPropertPartOf .

dul:hasRegion a owl:ObjectProperty ;
    rdfs:label "has region"@en ;
    rdfs:comment "A relation between entities and regions, e.g. 'the number of wheels of that truck is 12', 'the time of the experiment is August 9th, 2004', 'the whale has been localized at 34 degrees E, 20 degrees S'." ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Region ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isRegionFor .

dul:isDefinedIn a owl:ObjectProperty ;
    rdfs:label "is defined in"@en ;
    rdfs:comment "A relation between a Description and a Concept, e.g. a Workflow for a governmental Organization defines the Role 'officer', or 'the Italian Traffic Law defines the role Vehicle'." ;
    rdfs:domain dul:Concept ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Description ;
    rdfs:subPropertyOf dul:isConceptUsedIn .

dul:isEventIncludedIn a owl:ObjectProperty ;
    rdfs:label "is event included in"@en ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Situation ;
    rdfs:subPropertyOf dul:hasSetting .

dul:isExecutedIn a owl:ObjectProperty ;
    rdfs:label "is executed in"@en ;
    rdfs:comment "A relation between an action and a task, e.g. 'putting some water in a pot and putting the pot on a fire until the water starts bubbling' executes the task 'boiling'." ;
    rdfs:domain dul:Task ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Action ;
    rdfs:subPropertyOf soma:isOccurringIn,
        dul:classifies .

dul:isExpressedBy a owl:ObjectProperty ;
    rdfs:label "is expressed by"@en ;
    rdfs:comment """A relation between a dul:SocialObject (the 'meaning') and a dul:InformationObject (the 'expression'). 
For example: 'A Beehive is a structure in which bees are kept, typically in the form of a dome or box.' (Oxford dictionary)'; 'the term Beehive expresses the concept Beehive in my apiculture ontology'.
The intuition for 'meaning' is intended to be very broad. A separate, large comment is included in the encoding of 'expresses', for those who want to investigate more on what kind of meaning can be represented in what form.""" ;
    rdfs:domain dul:SocialObject ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:InformationObject ;
    rdfs:subPropertyOf dul:associatedWith,
        dul:isReferenceOf .

dul:isPartOf a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:TransitiveProperty ;
    rdfs:label "is part of"@en ;
    rdfs:comment "A relation between any entities, e.g. 'brain is a part of the human body'. See dul:hasPart for additional documentation." ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith .

dul:isPropertPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is propert part of"@en ;
    rdfs:comment "http://www.ontologydesignpatterns.org/ont/dul/DUL.owl"@en ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl> ;
    rdfs:seeAlso dul:hasProperPart ;
    rdfs:subPropertyOf dul:isPartOf .

dul:isReferenceOf a owl:ObjectProperty ;
    rdfs:label "is reference of"@en ;
    rdfs:comment """A relation between information objects and any Entity (including information objects). It can be used to talk about e.g. entities are references of proper nouns: the proper noun 'Leonardo da Vinci' isAbout the Person Leonardo da Vinci; as well as to talk about sets of entities that can be described by a common noun: the common noun 'person' isAbout the set of all persons in a domain of discourse, which can be represented in DOLCE-Ultralite as an individual of the class: Collection .
The isReferenceOf relation is irreflexive, differently from its inverse isAbout.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:InformationObject ;
    rdfs:subPropertyOf dul:associatedWith .

dul:isRegionFor a owl:ObjectProperty ;
    rdfs:label "is region for"@en ;
    rdfs:comment "A relation between entities and regions, e.g. 'the color of my car is red'." ;
    rdfs:domain dul:Region ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith .

dul:usesConcept a owl:ObjectProperty ;
    rdfs:label "uses concept"@en ;
    rdfs:comment "A generic relation holding between a Description and a Concept. In order to be used, a Concept must be previously definedIn another Description. This last condition cannot be encoded for object properties in OWL." ;
    rdfs:domain dul:Description ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Concept ;
    rdfs:subPropertyOf dul:associatedWith .

insight:AnchorKind a owl:Class ;
    rdfs:label "anchor kind"@en ;
    rdfs:comment "Kind of episode individual a hypothesis is anchored to."@en ;
    rdfs:subClassOf dul:Concept .

insight:bottle_reacquired a sosa:ObservableProperty ;
    rdfs:label "bottle reacquired"@en ;
    rdfs:comment "Whether the robot->bottle RT edge appears again after t_obs."@en .

insight:lateral_accel_peak a sosa:ObservableProperty ;
    rdfs:label "lateral acceleration peak"@en ;
    rdfs:comment "Max |accelerometer x| in the interval (m/s2)."@en .

insight:longitudinal_accel_peak a sosa:ObservableProperty ;
    rdfs:label "longitudinal acceleration peak"@en ;
    rdfs:comment "Max |accelerometer y| (forward axis) in the interval (m/s2)."@en .

insight:max_sustained_horizontal_accel a sosa:ObservableProperty ;
    rdfs:label "max sustained horizontal acceleration"@en ;
    rdfs:comment "Max before t_obs of the min of 3 consecutive horizontal acceleration samples (m/s2). Measured in simulated time, so independent of the Webots clock."@en .

insight:param_motion_kind a insight:QualitativeParameter ;
    insight:allowedValue "brake",
        "jerk" ;
    insight:parameterName "kind" .

insight:param_obstacle_shape a insight:QualitativeParameter ;
    insight:allowedValue "bump",
        "cable" ;
    insight:parameterName "shape" .

insight:person_distance_min a sosa:ObservableProperty ;
    rdfs:label "minimum person distance"@en ;
    rdfs:comment "Minimum robot-person distance in the interval (m)."@en .

insight:pitch_rate_peak a sosa:ObservableProperty ;
    rdfs:label "pitch rate peak"@en ;
    rdfs:comment "Max |gyroscope x| in the interval (rad/s)."@en .

insight:setpoint_step a sosa:ObservableProperty ;
    rdfs:label "setpoint step"@en ;
    rdfs:comment "Largest change of the filtered forward setpoint (0.2 s moving median of the zero-order hold) within 0.5 s (m/s)."@en .

insight:vertical_accel_peak a sosa:ObservableProperty ;
    rdfs:label "vertical acceleration peak"@en ;
    rdfs:comment "Max |accelerometer z - g| in the interval (m/s2)."@en .

insight:yaw_rate_peak a sosa:ObservableProperty ;
    rdfs:label "yaw rate peak"@en ;
    rdfs:comment "Max |gyroscope z| in the interval (rad/s)."@en .

soma:HardwareDiagnosis a owl:Class ;
    rdfs:label "Hardware diagnosis" ;
    rdfs:comment "A diagnosis of the hardware of a system." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf soma:TechnicalDiagnosis .

soma:ProcessType a owl:Class ;
    rdfs:label "Process type" ;
    rdfs:comment "An EventType that classifies Processes." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA.owl> ;
    rdfs:subClassOf dul:EventType .

soma:StatusFailure a owl:Class ;
    rdfs:comment "A status indicating the failure during some workflow execution." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-WF.owl> ;
    rdfs:subClassOf dul:Region .

dul:hasComponent a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "has component"@en,
        "ha componente"@it ;
    rdfs:comment "The hasProperPart relation without transitivity, holding between an Object (the system) and another (the component), and assuming a Design that structures the Object." ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:hasProperPart ;
    owl:inverseOf dul:isComponentOf .

dul:includesEvent a owl:ObjectProperty ;
    rdfs:label "includes event"@en ;
    rdfs:comment "A relation between situations and events, e.g. 'this morning I've prepared my coffee and had my fingers burnt' (i.e.: the preparation of my coffee this morning included a burning of my fingers)." ;
    rdfs:domain dul:Situation ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf dul:isSettingFor ;
    owl:inverseOf dul:isEventIncludedIn .

dul:isParticipantIn a owl:ObjectProperty ;
    rdfs:label "is participant in"@en ;
    rdfs:comment "A relation between an object and a process, e.g. 'John took part in the discussion', 'a large mass of snow fell during the avalanche', or 'a cook, some sugar, flour, etc. are all present in the cooking of a cake'." ;
    rdfs:domain dul:Object ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Event ;
    rdfs:subPropertyOf dul:associatedWith .

insight:CheckOutcome a owl:Class ;
    rdfs:label "check outcome"@en ;
    rdfs:comment "One episode check (a precondition or a contrast rule) applied to one hypothesis: the check (insight:appliesCheck), the observations of the episode it read (insight:readsObservation), its verdict (insight:checkVerdict) and the comparison with its numbers (rdfs:comment)."@en ;
    rdfs:subClassOf dul:Situation .

insight:Precondition a owl:Class ;
    rdfs:label "precondition"@en ;
    rdfs:comment "Must hold in the episode for the mechanism to make sense; if it fails, the hypothesis is incoherent."@en ;
    rdfs:subClassOf insight:EpisodeCheck .

insight:param_wheel_side a insight:QualitativeParameter ;
    insight:allowedValue "left",
        "right",
        "unknown" ;
    insight:parameterName "side" .

dul:classifies a owl:ObjectProperty ;
    rdfs:label "classifies"@en ;
    rdfs:comment "A relation between a Concept and an Entity, e.g. the Role 'student' classifies a Person 'John'." ;
    rdfs:domain dul:Concept ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isClassifiedBy .

dul:isClassifiedBy a owl:ObjectProperty ;
    rdfs:label "is classified by"@en ;
    rdfs:comment "A relation between a Concept and an Entity, e.g. 'John is considered a typical rude man'; your last concert constitutes the achievement of a lifetime; '20-year-old means she's mature enough'." ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Concept ;
    rdfs:subPropertyOf dul:associatedWith .

dul:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies"@en ;
    rdfs:comment "A relation between a Situation and a Description, e.g. the execution of a Plan satisfies that plan." ;
    rdfs:domain dul:Situation ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Description ;
    rdfs:subPropertyOf dul:associatedWith .

insight:HypothesisGeneration a owl:Class ;
    rdfs:label "hypothesis generation"@en ;
    rdfs:comment "The request to the LLM that proposed the hypotheses of a case: the model, the attempts it took and the batch it ended in."@en ;
    rdfs:seeAlso soma:AbductiveReasoning ;
    rdfs:subClassOf dul:Action .

dul:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "An Event with at least one Agent that isParticipantIn it, and that executes a Task that typically isDefinedIn a Plan, Workflow, Project, etc.",
        "The EASE view: an Action is an Event in which an Agent executes some Task, typically defined by a Workflow, towards the achievement of some Goal." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty dul:executesTask ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Task ;
            owl:onProperty dul:executesTask ],
        [ a owl:Restriction ;
            owl:onProperty dul:hasParticipant ;
            owl:someValuesFrom dul:Agent ],
        dul:Event .

dul:EventType a owl:Class ;
    rdfs:label "Event type"@en ;
    rdfs:comment "A Concept that classifies an Event . An event type describes how an Event should be interpreted, executed, expected, seen, etc., according to the Description that the EventType isDefinedIn (or used in)" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:Event ;
            owl:onProperty dul:classifies ],
        dul:Concept ;
    owl:disjointWith dul:Role .

dul:PhysicalObject a owl:Class ;
    rdfs:label "Physical object"@en ;
    rdfs:comment "Any Object that has a proper space region. The prototypical physical object has also an associated mass, but the nature of its mass can greatly vary based on the epistemological status of the object (scientifically measured, subjectively possible, imaginary)." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:PhysicalObject ;
            owl:onProperty dul:hasPart ],
        dul:Object ;
    owl:disjointWith dul:SocialObject .

dul:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A Concept that classifies an Object" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:Role ;
            owl:onProperty dul:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Object ;
            owl:onProperty dul:classifies ],
        dul:Concept .

dul:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:comment "A relation between an object and a process, e.g. 'John took part in the discussion', 'a large mass of snow fell during the avalanche', or 'a cook, some sugar, flour, etc. are all present in the cooking of a cake'." ;
    rdfs:domain dul:Event ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Object ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isParticipantIn .

dul:hasSetting a owl:ObjectProperty ;
    rdfs:label "has setting"@en ;
    rdfs:comment "A relation between entities and situations, e.g. 'this morning I've prepared my coffee with a new fantastic Arabica', i.e.: (an amount of) a new fantastic Arabica hasSetting the preparation of my coffee this morning." ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Situation ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isSettingFor .

dul:precedes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "precedes"@en ;
    rdfs:comment """A relation between entities, expressing a 'sequence' schema. 
E.g. 'year 1999 precedes 2000', 'deciding what coffee to use' precedes 'preparing coffee', 'World War II follows World War I', 'in the Milan to Rome autoroute, Bologna precedes Florence', etc.
It can then be used between tasks, processes, time intervals, spatially locate objects, situations, etc. 
Subproperties can be defined in order to distinguish the different uses.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith .

sosa:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    rdfs:comment "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subClassOf dul:Event .

sosa:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subClassOf dul:Object .

insight:yaw_change a sosa:ObservableProperty ;
    rdfs:label "yaw change"@en ;
    rdfs:comment "Heading change of the recorded pose over the interval, next to the commanded one: -integral of robot_ref_rot_speed, whose sign is opposite to the executed turn (deg)."@en .

soma:ExecutionStateRegion a owl:Class ;
    rdfs:label "Execution state region" ;
    rdfs:comment "A region containing labels that describe different states in the evolution/completion of a task execution." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/SOMA-ACT.owl> ;
    rdfs:subClassOf dul:Region ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( soma:ExecutionState_Active soma:ExecutionState_Cancelled soma:ExecutionState_Failed soma:ExecutionState_Paused soma:ExecutionState_Pending soma:ExecutionState_Succeeded ) ] .

dul:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment """An EventType that classifies an Action to be executed. 
For example, reaching a destination is a task that can be executed by performing certain actions, e.g. driving a car, buying a train ticket, etc. 
The actions to execute a task can also be organized according to a Plan that is not the same as the one that defines the task (if any). 
For example, reaching a destination could be defined by a plan to get on holidays, while the plan to execute the task can consist of putting some travels into a sequence.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:Task ;
            owl:onProperty dul:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Action ;
            owl:onProperty dul:isExecutedIn ],
        dul:EventType .

insight:EpisodeCheck a owl:Class ;
    rdfs:label "episode check"@en ;
    rdfs:comment "A check of a hypothesis against the episode, before simulating."@en ;
    rdfs:subClassOf dul:Description .

insight:IntervalAnchor a insight:AnchorKind ;
    rdfs:label "interval anchor"@en ;
    rdfs:comment "The hypothesis names a time interval of the episode."@en .

insight:param_push_direction a insight:QualitativeParameter ;
    insight:allowedValue "any",
        "backward",
        "forward",
        "left",
        "right" ;
    insight:parameterName "direction" .

dul:Goal a owl:Class ;
    rdfs:label "Goal"@en ;
    rdfs:comment "The Description of a Situation that is desired by an Agent, and usually associated to a Plan that describes how to actually achieve it" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Description .

dul:InformationObject a owl:Class ;
    rdfs:label "Information object"@en ;
    rdfs:comment "A piece of information, such as a musical composition, a text, a word, a picture, independently from how it is concretely realized.",
        """In SOMA-compliant systems, the way to use InformationObjects to specify extra data about an individual entity is to employ the 'is about' and 'expresses' properties (or their inverses 'is reference of' and 'is expressed by') and to supply a persistent identifier for a realization of the InformationObject.

As a prototypical example, consider an individual called Action_XYZ, about which we have some data for which the meaning is described by Description_ABC. The data would be an individual InformationObject_DEF, and the following property assertions would hold:

InformationObject_DEF 'is about' Action_XYZ
InformationObject_DEF expresses Description_ABC


Usually, an individual InformationObject would be connected to (at least) an InformationRealization individual. For example, suppose there is such an InformationRealization individual, InformationRealization_123. Then, this individual will have data properties describing its format and persistent identifier

InformationRealization_123 hasPersistentIdentifier 'doi'
InformationRealization_123 hasDataFormat 'urdf'""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:InformationEntity,
        dul:SocialObject .

dul:SocialObject a owl:Class ;
    rdfs:label "Social object"@en ;
    rdfs:comment """Any Object that exists only within some communication Event, in which at least one PhysicalObject participates in. 
In other words, all objects that have been or are created in the process of social communication: for the sake of communication (InformationObject), for incorporating new individuals (SocialAgent, Place), for contextualizing or intepreting existing entities (Description, Concept), or for collecting existing entities (Collection).
Being dependent on communication, all social objects need to be expressed by some information object (information objects are self-expressing).""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dul:isExpressedBy ;
            owl:someValuesFrom dul:InformationObject ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:SocialObject ;
            owl:onProperty dul:hasPart ],
        dul:Object .

insight:Hypothesis a owl:Class ;
    rdfs:label "hypothesis"@en ;
    rdfs:comment "A candidate explanation of the accident of an episode, proposed by the LLM: the situation in which a mechanism of the TBox happened (dul:satisfies) at individuals of the episode (insight:anchoredTo), of the kinds the LLM chose (dul:isClassifiedBy an insight:Kind). The memory classifies it with its status (dul:isClassifiedBy an insight:HypothesisStatus) after the checks it applied (insight:checkedBy). One with no mechanism of the TBox carries insight:newMechanismDescription instead."@en ;
    rdfs:subClassOf dul:Situation .

insight:HypothesisStatus a owl:Class ;
    rdfs:label "hypothesis status"@en ;
    rdfs:comment "What the memory decided about a hypothesis before simulating (contract 3, section 4.3)."@en ;
    rdfs:subClassOf dul:Concept .

insight:QualitativeParameter a owl:Class ;
    rdfs:label "qualitative parameter"@en ;
    rdfs:comment "A kind the LLM chooses in words (e.g. a bump or a cable, the side of a wheel); the grounding step turns it into numbers. Magnitudes (size, strength, slipperiness) are not parameters: the grounding covers the whole range the catalog can simulate."@en ;
    rdfs:subClassOf dul:Parameter .

dul:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:comment "Additional comment: a computational agent can be considered as a PhysicalAgent that realizes a certain class of algorithms (that can be considered as instances of InformationObject) that allow to obtain some behaviors that are considered typical of agents in general. For an ontology of computational objects based on DOLCE see e.g. http://www.loa-cnr.it/COS/COS.owl, and http://www.loa-cnr.it/KCO/KCO.owl.",
        "Any agentive Object , either physical (e.g. a whale, a robot, an oak), or social (e.g. a corporation, an institution, a community).",
        """Generally, agents are goal-directed entities that are able to monitor their environment to select and perform efficient means-ends actions that are available in a given situation to achieve an intended goal. Agency, therefore, implies the ability to perceive and to change the environment of the agent. Crucially, it also entails intentionality to represent the goal-state in the future, equifinal variability to be able to achieve the intended goal-state with different actions in different contexts, and rationality of actions in relation to their goal to produce the most efficient action available (Source: https://en.wikipedia.org/wiki/Agency_(psychology)).

While we follow this definition, we do so loosely: We do not require the intentionality to be sourced by the agent. E.g., a running computer program (see Software instance) can be seen as an actor and therefore participate in Actions, e.g. some Communication Action, while its intentionality has been bestowed upon it from the agents who started the program or gave an input (e.g., via a mouse click) to achieve some goal."""@en ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Object .

insight:ContrastRule a owl:Class ;
    rdfs:label "contrast rule"@en ;
    rdfs:comment "Compares the trace a mechanism predicts with the evidence. It can only discard (or explain from memory), never confirm."@en ;
    rdfs:subClassOf insight:EpisodeCheck .

insight:speed_ratio a sosa:ObservableProperty ;
    rdfs:label "speed ratio"@en ;
    rdfs:comment "Path / integral of the setpoint in the interval, divided by the same ratio in Interval_baseline. Relative to the episode itself because of the Webots clock."@en .

insight:SimulationIntervention a owl:Class ;
    rdfs:label "simulation intervention"@en ;
    rdfs:comment "A primitive the inner simulator can apply: an entry of etc/intervention_catalog.json, the nominal replay, or an experimental one."@en ;
    rdfs:subClassOf dul:Description .

insight:SimulationRun a owl:Class ;
    rdfs:label "simulation run"@en ;
    rdfs:comment "The repetitions the inner simulator ran of the compiled cause of one hypothesis, or of the nominal replay, and what its verdict made of them."@en ;
    rdfs:seeAlso soma:Simulating,
        soma:Simulation_Reasoner ;
    rdfs:subClassOf dul:Action .

dul:Plan a owl:Class ;
    rdfs:label "Plan"@en ;
    rdfs:comment "A Description having an explicit Goal, to be achieved by executing the plan" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty soma:isPlanFor ;
            owl:someValuesFrom dul:Task ],
        [ a owl:Restriction ;
            owl:onProperty dul:hasComponent ;
            owl:someValuesFrom dul:Goal ],
        dul:Description .

dul:Region a owl:Class ;
    rdfs:label "Region"@en ;
    rdfs:comment """Any region in a dimensional space (a dimensional space is a maximal Region), which can be used as a value for a quality of an Entity . For example, TimeInterval, SpaceRegion, PhysicalAttribute, Amount, SocialAttribute are all subclasses of Region. 
Regions are not data values in the ordinary knowledge representation sense; in order to get patterns for modelling data, see the properties: representsDataValue and hasDataValue""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:Region ;
            owl:onProperty dul:precedes ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Region ;
            owl:onProperty dul:hasPart ],
        dul:Abstract .

dul:TimeInterval a owl:Class ;
    rdfs:label "Time interval"@en ;
    rdfs:comment "Any Region in a dimensional space that aims at representing time." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:Region .

dul:hasPart a owl:ObjectProperty,
        owl:ReflexiveProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment """A schematic relation between any entities, e.g. 'the human body has a brain as part', '20th century contains year 1923', 'World War II includes the Pearl Harbour event'.

Parthood should assume the basic properties of mereology: transitivity, antisymmetry, and reflexivity (propert Parthood of course misses reflexivity). 
However, antisymmetry is not supported in OWL2 explicitly, therefore DUL has to adopt one of two patterns:
1) dropping asymmetry axioms, while granting reflexivity: this means that symmetry is not enforced, but permitted for the case of reflexivity. Of course, in this way we cannot prevent symmetric usages of hasPart;
2) dropping the reflexivity axiom, and enforce asymmetry: in this case, we would prevent all symmetric usages, but we loose the possibility of enforcing reflexivity, which is commonsensical in parthood.
In DUL, we adopt pattern #1 for partOf, and pattern #2 for properPartOf, which seems a good approximation: due to the lack of inheritance of property characteristics, each asymmetric hasPropertPart assertion would also be a reflexive hasPart assertion (reflexive reduction design pattern).

Subproperties and restrictions can be used to specialize hasPart for objects, events, etc.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith ;
    owl:inverseOf dul:isPartOf .

dul:isSettingFor a owl:ObjectProperty ;
    rdfs:label "is setting for"@en ;
    rdfs:comment "A relation between situations and entities, e.g. 'this morning I've prepared my coffee with a new fantastic Arabica', i.e.: the preparation of my coffee this morning is the setting for (an amount of) a new fantastic Arabica." ;
    rdfs:domain dul:Situation ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    rdfs:subPropertyOf dul:associatedWith .

dul:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment """A Concept is a SocialObject, and isDefinedIn some Description; once defined, a Concept can be used in other Description(s). If a Concept isDefinedIn exactly one Description, see the LocalConcept class.
The classifies relation relates Concept(s) to Entity(s) at some TimeInterval""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:Concept ;
            owl:onProperty dul:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty dul:isDefinedIn ;
            owl:someValuesFrom dul:Description ],
        dul:SocialObject ;
    owl:disjointWith dul:InformationObject,
        dul:Situation .

insight:Kind a owl:Class ;
    rdfs:label "kind"@en ;
    rdfs:comment "One allowed value of a qualitative parameter (e.g. the shape 'bump' of an obstacle): what the LLM may choose in words. build_insight_tbox.py generates one per insight:allowedValue."@en ;
    rdfs:subClassOf dul:Concept .

sosa:ObservableProperty a owl:Class ;
    rdfs:label "Observable Property"@en ;
    rdfs:comment "An observable quality (property, characteristic) of a FeatureOfInterest."@en ;
    rdfs:isDefinedBy sosa: ;
    rdfs:subClassOf dul:Quality .

dul:Object a owl:Class ;
    rdfs:label "Object"@en ;
    rdfs:comment "Any physical, social, or mental object, or a substance. Following DOLCE Full, objects are always participating in some event (at least their own life), and are spatially located." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dul:hasLocation ;
            owl:someValuesFrom dul:Entity ],
        [ a owl:Restriction ;
            owl:onProperty dul:isParticipantIn ;
            owl:someValuesFrom dul:Event ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Object ;
            owl:onProperty dul:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom dul:Role ;
            owl:onProperty dul:isClassifiedBy ],
        dul:Entity .

insight:Mechanism a owl:Class ;
    rdfs:label "mechanism"@en ;
    rdfs:comment "A way in which the carried bottle can fall: what it requires in the episode, what trace it leaves in the recording, and how it is simulated or why it cannot be."@en ;
    rdfs:subClassOf dul:Description .

dul:Description a owl:Class ;
    rdfs:label "Description"@en ;
    rdfs:comment """A Description is a SocialObject that represents a conceptualization. 
It can be thought also as a 'descriptive context' that uses or defines concepts in order to create a view on a 'relational context' (cf. Situation) out of a set of data or observations. 
For example, a Plan is a Description of some actions to be executed by agents in a certain way, with certain parameters; a Diagnosis is a Description that provides an interpretation for a set of observed entities, etc.
Descriptions 'define' or 'use' concepts, and can be 'satisfied' by situations.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf dul:SocialObject ;
    owl:disjointWith dul:InformationObject,
        dul:Situation .

dul:Situation a owl:Class ;
    rdfs:label "Situation"@en ;
    rdfs:comment """A view, consistent with ('satisfying') a Description, on a set of entities. 
It can also be seen as a 'relational context' created by an observer on the basis of a 'frame' (i.e. a Description). 
For example, a PlanExecution is a context including some actions executed by agents according to certain parameters and expected tasks to be achieved from a Plan; a DiagnosedSituation is a context of observed entities that is interpreted on the basis of a Diagnosis, etc.
Situation is also able to represent reified n-ary relations, where isSettingFor is the top-level relation for all binary projections of the n-ary relation. 
If used in a transformation pattern for n-ary relations, the designer should take care of adding (some or all) OWL2 keys, corresponding to binary projections of the n-ary, to a subclass of Situation. Otherwise the 'identification constraint' (Calvanese et al., IJCAI 2001) might be violated.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dul:satisfies ;
            owl:someValuesFrom dul:Description ],
        dul:Entity .

dul:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment """Any physical, social, or mental process, event, or state.

More theoretically, events can be classified in different ways, possibly based on 'aspect' (e.g. stative, continuous, accomplishement, achievement, etc.), on 'agentivity' (e.g. intentional, natural, etc.), or on 'typical participants' (e.g. human, physical, abstract, food, etc.).
Here no special direction is taken, and the following explains why: events are related to observable situations, and they can have different views at a same time.
If a position has to be suggested here anyway, the participant-based classification of events seems the most stable and appropriate for many modelling problems.

(1) Alternative aspectual views

Consider a same event 'rock erosion in the Sinni valley': it can be conceptualized as an accomplishment (what has brought a certain state to occur), as an achievement (the state resulting from a previous accomplishment), as a punctual event (if we collapse the time interval of the erosion into a time point), or as a transition (something that has changed from a state to a different one). 
In the erosion case, we could therefore have good motivations to shift from one aspect to another: a) causation focus, b) effectual focus, c) historical condensation, d) transition (causality).

The different views refer to the same event, but are still different: how to live with this seeming paradox? 
A typical solution e.g. in linguistics (cf. Levin's aspectual classes) and in DOLCE Full (cf. WonderWeb D18 axiomatization) is to classify events based on aspectual differences. But this solution would create different identities for a same event, where the difference is only based on the modeller's attitude.
An alternative solution is suggested here, and exploits the notion of (observable) Situation; a Situation is a view, consistent with a Description, which can be observed of a set of entities. It can also be seen as a 'relational context' created by an observer on the basis of a 'frame'. Therefore, a Situation allows to create a context where each particular view can have a proper identity, while the Event preserves its own identity. 
For example, ErosionAsAccomplishment is a Situation where rock erosion is observed as a process leading to a certain achievement: the conditions (roles, parameters) that suggest such view are stated in a Description, which acts as a 'theory of accomplishments'. Similarly, ErosionAsTransition is a Situation where rock erosion is observed as an event that has changed a state to another: the conditions for such interpretation are stated in a different Description, which acts as a 'theory of state transitions'.
Consider that in no case the actual event is changed or enriched in parts by the aspectual view.

(2) Alternative intentionality views

Similarly to aspectual views, several intentionality views can be provided for a same Event. For example, one can investigate if an avalanche has been caused by immediate natural forces, or if there is any hint of an intentional effort to activate those natural forces.
Also in this case, the Event as such has not different identities, while the causal analysis generates situations with different identities, according to what Description is taken for interpreting the Event. 
On the other hand, if the possible actions of an Agent causing the starting of an avalanche are taken as parts of the Event, then this makes its identity change, because we are adding a part to it. 
Therefore, if intentionality is a criterion to classify events or not, this depends on if an ontology designer wants to consider causality as a relevant dimension for events' identity.

(3) Alternative participant views

A slightly different case is when we consider the basic participants to an Event. In this case, the identity of the Event is affected by the participating objects, because it depends on them. 
For example, if snow, mountain slopes, wind, waves, etc. are considered as an avalanche basic participants, or if we also want to add water, human agents, etc., that makes the identity of an avalanche change.
Anyway, this approach to event classification is based on the designer's choices, and more accurately mirrors lexical or commonsense classifications (see. e.g. WordNet 'supersenses' for verb synsets).

Ultimately, this discussion has no end, because realists will keep defending the idea that events in reality are not changed by the way we describe them, while constructivists will keep defending the idea that, whatever 'true reality' is about, it can't be modelled without the theoretical burden of how we observe and describe it. 
Both positions are in principle valid, but, if taken too radically, they focus on issues that are only partly relevant to the aim of computational ontologies, which assist domain experts in representing a certain portion of reality according to their own assumptions and requirements. 

For this reason, in this ontology version of DOLCE, both events and situations are allowed, together with descriptions (the reason for the inclusion of the D&S framewrok in DOLCE), in order to encode the modelling needs, independently from the position (if any) chosen by the model designer.""" ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-STATE.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom dul:Event ;
            owl:onProperty dul:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty dul:hasTimeInterval ;
            owl:someValuesFrom dul:TimeInterval ],
        [ a owl:Restriction ;
            owl:onProperty dul:hasParticipant ;
            owl:someValuesFrom dul:Object ],
        dul:Entity ;
    owl:disjointWith dul:Object .

dul:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "Anything: real, possible, or imaginary, which some modeller wants to talk about for some purpose." ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-WF.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> .

dul:associatedWith a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "associated with"@en ;
    rdfs:comment """A catch-all object property, useful for alignment and querying purposes.
It is declared as both transitive and symmetric, in order to reason an a maximal closure of associations between individuals.""" ;
    rdfs:domain dul:Entity ;
    rdfs:isDefinedBy <http://www.ease-crc.org/ont/DUL.owl>,
        <http://www.ease-crc.org/ont/SOMA-PROC.owl>,
        <http://www.ease-crc.org/ont/SOMA.owl>,
        <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl> ;
    rdfs:range dul:Entity ;
    owl:inverseOf dul:associatedWith .

