    def __del__(self):
        """Destructor"""

    @QtCore.Slot()
    def compute(self):
        concept_node = self.g.get_node(CONCEPT_NAME)
        if concept_node is None:
            return  # not created yet
        if not self.instances:
            self.init_instances(concept_node)

        now_ms = int(time.time() * 1000)
        relative_position = self.get_relative_position(concept_node)

        if self.print_extra_info:
            console.print(f"[{now_ms}] relative_position -> {relative_position}", style="cyan")

        changed = (not self.has_published_once) or self.has_significant_change(relative_position, self.last_relative_pose)
        if changed:
            if self.update_relative_position(relative_position):
                self.last_relative_pose = relative_position
                self.has_published_once = True
        self.publish_instance_rts()

        if self.stage in (Stage.IDLE, Stage.SHOOTING, Stage.VERIFYING):
            self.log_bearing_check(concept_node, relative_position, now_ms)
            self.serve_photo_mission(concept_node)
        elif self.stage == Stage.TRAINING:
            self.run_training()
        elif self.stage == Stage.INFERRING:
            self.cycle_count += 1
            if self.cycle_count % self.inference_period_cycles == 0:
                self.classify_current_view()

        return True

    def startup_check(self):
        QTimer.singleShot(200, QApplication.instance().quit)

    # Geometric calculations
    def has_significant_change(self, a, b, atol=0.001):
        if len(a) != len(b):
            return True
        return any(abs(x - y) > atol for x, y in zip(a, b))

    def get_relative_position(self, concept_node):
        """Relative position between the robot and CONCEPT_NAME, in the robot's local frame
        (meters). Simulated: simulated_position, i.e. what the simulation estimated, against the
        robot's Webots pose. Real: TODO, needs a CONCEPT_NAME label from ImageSegmentation (not
        trained yet)."""
        relative_position = [0.0, 0.0, 0.0]

        if self.simulated:
            # El concepto se situa donde lo estima este agente: simulated_position al principio,
            # ajustada despues con las detecciones (concept_world_position). Es el objetivo al
            # que se aproxima el robot y el obstaculo que esquiva.
            wp = self.concept_world_position(concept_node)
            if wp is None:
                return self.last_relative_pose

            try:
                robot_pose = self.webots2robocomp_proxy.getObjectPose(self.robot_def)
            except Exception as e:
                console.print(f"Sin pose de Webots ({e}); se mantiene la última RT.", style="bold red")
                return self.last_relative_pose
            relative_position = self.relative_from_world(wp, robot_pose)
        else:
            # TODO: no trained detector for CONCEPT_NAME yet. Wire this up once a real detector
            # exists; until then this branch returns [0,0,0] and never publishes on the real robot.
            segmented_objects = self.imagesegmentation_proxy.getSegmentedObjects(True, False)
            for obj in segmented_objects:
                if obj.label == CONCEPT_NAME:
                    pc = obj.points3D
                    if len(pc.X) > 0:
                        relative_position = [pc.X[0], pc.Y[0], pc.Z[0]]
                    break

        return relative_position

    def relative_from_world(self, world_m, robot_pose):
        """Punto del mundo (metros) en el marco del robot, con la convencion de la RT."""
        # world en metros; getObjectPose devuelve milimetros.
        dx = float(world_m[0]) - robot_pose.position.x / 1000.0
        dy = float(world_m[1]) - robot_pose.position.y / 1000.0
        dz = float(world_m[2]) - robot_pose.position.z / 1000.0

        q = robot_pose.orientation
        theta = math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))
        local_x = -math.sin(theta) * dx + math.cos(theta) * dy
        local_y = -math.cos(theta) * dx - math.sin(theta) * dy

        # Convencion de RoboComp: el avance va en la coordenada y, que es lo que asume
        # follow_target al medir el rumbo como atan2(x, y). Mismo orden que concept_person.
        # La primera componente va negada porque el rumbo publicado respondia al giro con el
        # signo contrario al que espera la ley de control (medido en lazo abierto, 209
        # muestras, 96% consistente). atan2(-x, y) = -atan2(x, y): refleja el sentido de giro
        # y deja el cero donde estaba, o sea que de frente sigue siendo rumbo 0.
        return [-local_y, local_x, dz]

    # ================ Instancias (esquive) ================

    def concept_world_position(self, concept_node):
        """Posicion del concepto en el mundo: la estimacion fusionada si existe, si no
        simulated_position. None sin ninguna de las dos."""
        if "simulated_position" not in concept_node.attrs:
            return None
        wp = [float(v) for v in concept_node.attrs["simulated_position"].value]
        concept = self.instance_by_name(CONCEPT_NAME)
        if concept is not None:
            wp[0], wp[1] = float(concept["xy"][0]), float(concept["xy"][1])
        return wp

    def instance_by_name(self, name):
        return next((i for i in self.instances if i["name"] == name), None)

    def init_instances(self, concept_node):
        """Primera instancia: el concepto, con simulated_position como prior. Si el agente rearranca
        recupera las instancias del grafo por su world_position."""
        if "simulated_position" not in concept_node.attrs:
            return
        source = "world_position" if "world_position" in concept_node.attrs else "simulated_position"
        xy = np.array([float(v) for v in concept_node.attrs[source].value[:2]])
        self.instances.append({"name": CONCEPT_NAME, "xy": xy, "weight": float(self.simulation_prior_weight),
                               "hits": 0, "last_seen": time.time(), "confirmed": True, "last_rt": None})
        for node in self.g.get_nodes_by_type("object"):
            suffix = node.name[len(CONCEPT_NAME) + 1:]
            if node.name.startswith(CONCEPT_NAME + "_") and suffix.isdigit() and "world_position" in node.attrs:
                self.instances.append({"name": node.name, "weight": 1.0, "hits": self.instance_min_hits,
                                       "xy": np.array([float(v) for v in node.attrs["world_position"].value[:2]]),
                                       "last_seen": time.time(), "confirmed": True, "last_rt": None})
        if len(self.instances) > 1:
            console.print(f"Instancias recuperadas del grafo: {[i['name'] for i in self.instances[1:]]}", style="cyan")

    def region_world_point(self, region, depth_m, image, root_to_camera):
        """Centro de una region detectada en el mundo (XY, marco root): profundidad mediana en una
        ventana 5x5 sobre su centro, retroproyectada. None sin profundidad o mas alla del alcance."""
        u, v = (int(round(c)) for c in region["center_uv"])
        window = depth_m[max(v - 2, 0):v + 3, max(u - 2, 0):u + 3]
        d = window[np.isfinite(window) & (window > 0)]
        if d.size == 0:
            return None
        d = float(np.median(d))
        # Lejos el trozo de 16 px abarca demasiado suelo y la profundidad pierde precision.
        if d > self.detection_max_range_m:
            return None
        # Inversa de project_root_point: camara +X avance, +Y izquierda, +Z arriba.
        point_camera = np.array([d, (image.width / 2 - u) * d / image.focalx,
                                 (image.height / 2 - v) * d / image.focaly, 1.0])
        return (root_to_camera @ point_camera)[:2]

    def update_instances(self, points):
        """Asocia cada medida (XY en el mundo) a la instancia mas cercana dentro de
        Instance_association_m y la fusiona (media ponderada); si no hay, abre una candidata. Una
        candidata se confirma con Instance_min_hits vistas y caduca si no se repite a tiempo."""
        now = time.time()
        seen = set()
        for xy in points:
            nearest = min(self.instances, key=lambda i: np.linalg.norm(i["xy"] - xy), default=None)
            if nearest is None or np.linalg.norm(nearest["xy"] - xy) > self.instance_association_m:
                nearest = {"name": None, "xy": xy, "weight": 1.0, "hits": 1, "last_seen": now,
                           "confirmed": False, "last_rt": None}
                self.instances.append(nearest)
                seen.add(id(nearest))
                self.log_instance_event(nearest, "candidata", xy)
            elif id(nearest) in seen:
                continue  # una medida por instancia y vista: dos regiones del mismo bache no cuentan doble
            else:
                seen.add(id(nearest))
                nearest["xy"] = (nearest["xy"] * nearest["weight"] + xy) / (nearest["weight"] + 1.0)
                nearest["weight"] += 1.0
                nearest["hits"] += 1
                nearest["last_seen"] = now
                if nearest["confirmed"]:
                    self.publish_world_position(nearest)
                    self.log_instance_event(nearest, "fusion", xy)
                else:
                    self.log_instance_event(nearest, "vista", xy)

            if not nearest["confirmed"] and nearest["hits"] >= self.instance_min_hits:
                self.confirm_instance(nearest)

        self.instances = [i for i in self.instances
                          if i["confirmed"] or now - i["last_seen"] <= self.instance_candidate_timeout_s]

    def confirm_instance(self, instance):
        """Crea el nodo de una instancia confirmada: tipo object (lo que esquiva concept_robot), con
        el tamaño del concepto y su posicion en el mundo. La RT la publica publish_instance_rts."""
        concept_node = self.g.get_node(CONCEPT_NAME)
        if concept_node is None:
            return
        index = 1
        while self.g.get_node(f"{CONCEPT_NAME}_{index}") is not None:
            index += 1
        name = f"{CONCEPT_NAME}_{index}"

        node = Node(agent_id=self.agent_id, type="object", name=name)
        if "pos_x" in concept_node.attrs:
            node.attrs["pos_x"] = Attribute(float(concept_node.attrs["pos_x"].value), self.agent_id)
            node.attrs["pos_y"] = Attribute(float(concept_node.attrs["pos_y"].value) + 100.0 * index, self.agent_id)
        if "concept_size" in concept_node.attrs:
            node.attrs["concept_size"] = Attribute([float(v) for v in concept_node.attrs["concept_size"].value], self.agent_id)
        node.attrs["world_position"] = Attribute([float(instance["xy"][0]), float(instance["xy"][1]), 0.0], self.agent_id)
        if self.g.insert_node(node) is None:
            console.print(f"No se pudo crear el nodo {name}.", style="bold red")
            return
        instance["name"], instance["confirmed"] = name, True
        console.print(f"Nueva instancia {name} en ({instance['xy'][0]:.2f}, {instance['xy'][1]:.2f}) "
                      f"tras {instance['hits']} vistas", style="bold green")
        self.log_instance_event(instance, "confirmada", instance["xy"])

    def publish_world_position(self, instance):
        """Escribe la estimacion fusionada en el nodo (world_position): consulta y recuperacion al
        rearrancar. Lo que usa el esquive es la RT."""
        node = self.g.get_node(instance["name"])
        if node is None:
            return
        node.attrs["world_position"] = Attribute([float(instance["xy"][0]), float(instance["xy"][1]), 0.0], self.agent_id)
        self.g.update_node(node)

    def publish_instance_rts(self):
        """RT robot -> cada instancia confirmada (salvo el concepto, que va por su camino): la
        posicion en el mundo no cambia, pero el robot si, asi que se recalcula cada ciclo."""
        others = [i for i in self.instances if i["confirmed"] and i["name"] != CONCEPT_NAME]
        if not others or not self.simulated:
            return  # TODO real: pose del robot sin Webots
        robot_node = self.g.get_node("robot")
        if robot_node is None:
            return
        try:
            robot_pose = self.webots2robocomp_proxy.getObjectPose(self.robot_def)
        except Exception:
            return
        for instance in others:
            node = self.g.get_node(instance["name"])
            if node is None:
                continue
            relative = self.relative_from_world([instance["xy"][0], instance["xy"][1], 0.0], robot_pose)
            if instance["last_rt"] is None or self.has_significant_change(relative, instance["last_rt"]):
                self.rt_api.insert_or_assign_edge_RT(robot_node, node.id, relative, [0.0, 0.0, 0.0])
                instance["last_rt"] = relative

    def real_objects(self):
        """Posiciones reales (XY, metros) de Real_def y de sus copias Real_def_1, _2... mientras
        resuelvan. Se piden una vez: los baches no se mueven. {} sin referencia."""
        if self.real_objects_cache is not None or not self.real_def:
            return self.real_objects_cache or {}
        found = {}
        for name in [self.real_def] + [f"{self.real_def}_{k}" for k in range(1, 20)]:
            try:
                pose = self.webots2robocomp_proxy.getObjectPose(name)
            except Exception:
                break
            xy = (pose.position.x / 1000.0, pose.position.y / 1000.0)
            if not all(math.isfinite(v) for v in xy) or not any(xy):
                break  # NaN o ceros: el DEF no existe
            found[name] = xy
        self.real_objects_cache = found
        console.print(f"Referencias reales: {list(found) or 'ninguna'}", style="cyan")
        return found

    def log_instance_event(self, instance, event, measured_xy):
        """Una fila en instances.csv: medida, estimacion de la instancia y error frente al objeto
        real mas cercano."""
        real = self.real_objects()
        nearest_def, error = "", None
        if real:
            nearest_def = min(real, key=lambda k: math.dist(real[k], instance["xy"]))
            error = math.dist(real[nearest_def], instance["xy"])
        path = os.path.join(self.model_dir, "instances.csv")
        new_file = not os.path.exists(path)
        os.makedirs(self.model_dir, exist_ok=True)
        with open(path, "a") as log:
            if new_file:
                log.write("timestamp_ms,instance,event,measured_x,measured_y,estimate_x,estimate_y,hits,real_def,error_m\n")
            log.write(f"{int(time.time() * 1000)},{instance['name'] or ''},{event},{measured_xy[0]:.3f},{measured_xy[1]:.3f},"
                      f"{instance['xy'][0]:.3f},{instance['xy'][1]:.3f},{instance['hits']},{nearest_def},"
                      f"{'' if error is None else f'{error:.3f}'}\n")

    def warn_no_real_reference(self, reason):
        """Avisa una sola vez, no por ciclo: sin referencia real la mision es identica, solo se
        queda sin la pista contra la que medir el error."""
        if self.real_def_warned:
            return
        self.real_def_warned = True
        console.print(f"Sin referencia real (DEF '{self.real_def}'): {reason}. Se sigue sin ella.",
                      style="bold yellow")

    def real_reference(self):
        """Posicion REAL del concepto: la pista contra la que se mide el error de
        simulated_position. None si no hay referencia fiable, nunca ceros.

        El puente devuelve NaN cuando no resuelve el DEF (y ceros en las versiones anteriores),
        asi que las dos cosas se descartan: son ausencia de dato, no una posicion. Devuelve los dos
        marcos porque se compara contra dos cosas: 'world' contra simulated_position (resta
        directa) y 'relative' contra la RT, con su misma convencion."""
        if not self.real_def:
            return None

        try:
            concept_pose = self.webots2robocomp_proxy.getObjectPose(self.real_def)
            robot_pose = self.webots2robocomp_proxy.getObjectPose(self.robot_def)
        except Exception as e:
            self.warn_no_real_reference(f"el puente no contesto ({e})")
            return None

        # getObjectPose devuelve milimetros; el resto del agente trabaja en metros.
        concept_world = [concept_pose.position.x / 1000.0,
                         concept_pose.position.y / 1000.0,
                         concept_pose.position.z / 1000.0]
        robot_world = [robot_pose.position.x / 1000.0,
                       robot_pose.position.y / 1000.0,
                       robot_pose.position.z / 1000.0]

        if not all(math.isfinite(v) for v in concept_world + robot_world):
            self.warn_no_real_reference("DEF sin resolver (pose NaN)")
            return None
        if not any(concept_world) or not any(robot_world):
            self.warn_no_real_reference("DEF sin resolver (pose a cero)")
            return None

        dx = concept_world[0] - robot_world[0]
        dy = concept_world[1] - robot_world[1]
        dz = concept_world[2] - robot_world[2]

        q = robot_pose.orientation
        theta = math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))
        local_x = -math.sin(theta) * dx + math.cos(theta) * dy
        local_y = -math.cos(theta) * dx - math.sin(theta) * dy

        # Mismo orden que la RT, para poder comparar las dos directamente.
        return {"relative": [-local_y, local_x, dz], "world": concept_world}

    def real_reference_attrs(self):
        """La referencia real como atributos del nodo, {} si no hay. Se publica en la MISMA
        escritura que el veredicto para que la muestra sea del mismo instante."""
        real = self.real_reference()
        if real is None:
            return {}
        return {"real_position": [float(v) for v in real["relative"]],
                "real_world_position": [float(v) for v in real["world"]]}

    def update_relative_position(self, relative_position):
        """Update the robot->CONCEPT_NAME RT edge in the DSR. Returns True if it was written.

        Sin rechazo de valores atipicos a proposito: el que habia medía el salto en el marco del
        robot, donde un objeto quieto se desplaza mucho solo porque el robot gira, y bloqueaba la
        RT justo cuando mas falta hace. Cuando haya detector real hara falta uno de verdad, con el
        criterio en el marco del mundo o por velocidad plausible del objetivo."""
        robot_node = self.g.get_node("robot")
        concept_node = self.g.get_node(CONCEPT_NAME)

        if robot_node is None or concept_node is None:
            console.print(f"Robot or {CONCEPT_NAME} node not found in DSR.", style="bold red")
            return False

        if len(relative_position) != 3:
            console.print("Invalid relative position size.", style="bold red")
            return False

        self.rt_api.insert_or_assign_edge_RT(robot_node, concept_node.id, relative_position, [0.0, 0.0, 0.0])
        return True

    # ================ Misión de fotos ================

    def log_bearing_check(self, concept_node, relative_position, now_ms):
        """Compara el rumbo de la RT con el que implica la proyeccion a la camara. Son dos
        caminos independientes: si discrepan en signo, la lateralidad de la RT esta mal."""
        if not self.photo_mission_active():
            return
        if now_ms - self.last_bearing_check_ms < 500:   # 2 Hz, no hace falta mas
            return
        self.last_bearing_check_ms = now_ms

        rt_deg = math.degrees(math.atan2(relative_position[0], relative_position[1]))
        try:
            rgb, depth_m, image = self.get_current_rgbd()
            projection = self.project_simulated_position(concept_node, image)
        except Exception as e:
            console.print(f"[rumbo] RT {rt_deg:+7.1f} | sin proyeccion ({e})", style="yellow")
            return
        # "behind" trae u/v a None: el concepto esta detras de la camara y no hay pixel que medir,
        # que es justo lo que pasa mientras el robot se aleja de espaldas en BACKOFF.
        if projection is None or projection.get("u") is None:
            console.print(f"[rumbo] RT {rt_deg:+7.1f} | sin pixel (concepto fuera del campo)", style="yellow")
            return

        proj_deg = math.degrees(math.atan((projection["u"] - image.width / 2.0) / image.focalx))
        console.print(f"[rumbo] RT {rt_deg:+7.1f} | proyeccion {proj_deg:+7.1f} | "
                      f"dif {((rt_deg - proj_deg + 180) % 360) - 180:+7.1f} | "
                      f"d {math.hypot(relative_position[0], relative_position[1]):.2f} m", style="magenta")

    def photo_mission_active(self):
        """La misión de fotos está en marcha si el TARGET apunta a este concepto y su afordance,
        alcanzada por TARGET -> has_intention, tiene aff_interacting a true."""
        concept_node = self.g.get_node(CONCEPT_NAME)
        if concept_node is None:
            return False

        targets = [e for e in self.g.get_edges_by_type("TARGET") if e.destination == concept_node.id]
        if not targets:
            return False

        for edge in self.g.get_edges_by_type("has_intention"):
            if edge.origin != concept_node.id:
                continue
            affordance = self.g.get_node(edge.destination)
            if affordance is not None and "aff_interacting" in affordance.attrs:
                return bool(affordance.attrs["aff_interacting"].value)
        return False

    def robot_is_stopped(self):
        """Velocidades de referencia del nodo robot a cero: es la parada que hace concept_robot
        en cada paso del giro, y la señal con la que este agente dispara."""
        robot_node = self.g.get_node("robot")
        if robot_node is None:
            return False
        for name in ("robot_ref_adv_speed", "robot_ref_rot_speed"):
            if name not in robot_node.attrs:
                return False
            if abs(robot_node.attrs[name].value) > STOPPED_SPEED_EPSILON:
                return False
        return True

    def cuda_available(self):
        """True si torch ve una GPU. Se importa aqui para no pagar la carga si no hace falta."""
        try:
            import torch
            return torch.cuda.is_available()
        except Exception:
            return False

    def serve_photo_mission(self, concept_node):
        """Atiende la verificación que pide concept_robot, dispara una vez por parada mientras la
        misión está activa, y cierra la tanda cuando la afordance se apaga."""
        active = self.photo_mission_active()

        # La verificacion se contesta una sola vez por mision, antes de que empiece el giro.
        if active and not self.verify_answered and self.read_bool_attr(concept_node, "verify_request"):
            self.stage = Stage.VERIFYING
            # Si todavia no lo tiene en cuadro no contesta: concept_robot sigue girando.
            self.verify_answered = self.verify_concept(concept_node)
            return

        # Solo se dispara con la verificacion contestada Y correcta. Lo primero porque antes del
        # APPROACH el robot esta parado un instante y se colaba una foto con el concepto fuera de
        # cuadro. Lo segundo porque un "fail" dice que el concepto no esta donde se cree: la
        # etiqueta sale de proyectar simulated_position, asi que disparar mete en el dataset una
        # foto etiquetada por un punto que no apunta al concepto.
        # Force_photos salta lo segundo para probar el clasificador: el veredicto sigue grabado.
        if active and self.verify_answered and (self.verify_verdict == "ok" or self.force_photos):
            self.stage = Stage.SHOOTING
            # one photo per stop, even if the stop lasts several cycles
            if self.robot_is_stopped():
                if not self.shot_at_this_stop:
                    self.take_labelled_photo(concept_node)
                    self.shot_at_this_stop = True
            else:
                self.shot_at_this_stop = False

        if not active:
            self.verify_answered = False
            self.verify_verdict = None
            self.verify_waiting_logged = False

        if self.mission_was_active and not active and not self.session_trained:
            console.print(f"Tanda cerrada con {self.photo_counter} fotos guardadas.", style="bold cyan")
            self.stage = Stage.TRAINING
        self.mission_was_active = active

    def expected_size(self, concept_node):
        """Dimension mayor de la huella del concepto, en metros. Se prefiere la medida que publica
        la simulacion sobre el modelo real; Expected_size_m queda como reserva para cuando no
        llegue (causa no espacial, o un inner que no la publique)."""
        if "concept_size" in concept_node.attrs:
            size = [float(v) for v in concept_node.attrs["concept_size"].value]
            if len(size) == 3 and max(size[0], size[1]) > 1e-3:
                return max(size[0], size[1])
        return self.expected_size_m

    def read_bool_attr(self, node, name):
        """Booleano de un atributo del nodo, False si no esta."""
        if name not in node.attrs:
            return False
        return bool(node.attrs[name].value)

    def publish_concept_attrs(self, values):
        """Escribe atributos en el nodo del concepto: es el canal de vuelta a concept_robot."""
        node = self.g.get_node(CONCEPT_NAME)
        if node is None:
            return
        for name, value in values.items():
            node.attrs[name] = Attribute(value, self.agent_id)
        self.g.update_node(node)

    def verify_concept(self, concept_node):
        """Comprueba que el concepto esta de verdad donde dice simulated_position: proyecta el punto,
        segmenta con SAM en ese pixel y mide la mascara.

        Devuelve True solo si ha podido mirar y ha contestado. Si el punto todavia no esta en
        cuadro NO contesta y devuelve False: concept_robot sigue girando y se vuelve a intentar al
        ciclo siguiente. Asi un "fail" significa siempre "lo he visto y no cuadra", nunca "no
        estaba mirando"."""
        rgb, depth_m, image = self.get_current_rgbd()
        if rgb is None or depth_m is None:
            return False

        projection = self.project_simulated_position(concept_node, image)
        if projection is None or projection["behind"] or projection["u"] is None:
            return False

        # Dentro del encuadre con margen, no solo dentro: contestando en cuanto el punto asoma por
        # el borde la mascara sale cortada y la medida no vale. El margen es el radio aparente del
        # concepto, el mismo que usa el etiquetado.
        u, v = int(round(projection["u"])), int(round(projection["v"]))
        r_px = (self.expected_size(concept_node) / 2.0) * image.focalx / max(projection["depth_m"], 1e-3)
        margin = r_px * self.label_margin_factor
        if not (margin <= u <= image.width - margin and margin <= v <= image.height - margin):
            return False

        # Y centrado en horizontal, no solo dentro: entrando por el lateral el punto cae en la
        # esquina de abajo, el suelo se ve rasante y SAM se traga el plano entero en vez del
        # concepto. Centrado, la componente de avance es casi la distancia real y se ve de frente.
        if abs(u - image.width / 2) > image.width / 8:
            return False

        if not self.verify_waiting_logged:
            console.print(f"Concepto en cuadro en ({u}, {v}) a {projection['depth_m']:.2f} m; verificando.", style="cyan")
            self.verify_waiting_logged = True

        diag = {"verify_pixel": [float(u), float(v)]}
        candidates = self.mask_candidates_for_point(concept_node, rgb, depth_m, image, u, v)
        accepted = [c for c in candidates if c["ok"]]
        best = min(accepted, key=lambda c: c["shift_m"]) if accepted else None
        self.save_verification_images(rgb, image, (u, v), candidates, best)
        if best is None:
            self.footprint = None
            diag["verify_result"] = "fail"
            console.print("Verificacion NEGATIVA: ninguna mascara de SAM encaja con el concepto.", style="bold red")
        else:
            # Pasa la validacion: su medida corrige la huella con la que se etiquetan las fotos.
            self.footprint = {k: best[k] for k in ("center_m", "diameter_m", "height_m")}
            diag["verify_result"] = "ok"
            diag["verify_size_m"] = best["diameter_m"]
            diag["verify_height_m"] = best["height_m"]
            diag["verify_shift_m"] = best["shift_m"]
            diag["verify_corrected_position"] = [float(v) for v in best["center_m"]] + [0.0]
            console.print(f"Verificacion OK: diametro {best['diameter_m']:.3f} m, altura {best['height_m']:.3f} m, "
                          f"desplazamiento {best['shift_m']:.3f} m -> huella corregida a "
                          f"({best['center_m'][0]:.3f}, {best['center_m'][1]:.3f})", style="bold green")

        # La verdad va en la misma escritura que el veredicto, y tambien cuando es "fail": son
        # los casos que hay que explicar (creencia desplazada vs. SAM segmentando otra cosa).
        diag.update(self.real_reference_attrs())
        self.verify_verdict = diag["verify_result"]
        self.publish_concept_attrs(diag)
        return True

    def run_sam(self, rgb, u, v):
        """Mascaras de SAM para un clic en (u, v); lista vacia si falla."""
        try:
            if self.sam is None:
                from ultralytics import SAM   # import aqui: tarda y solo hace falta al verificar
                console.print(f"Cargando SAM desde {self.sam_weights}...", style="yellow")
                self.sam = SAM(self.sam_weights)
            # multimask_output no se puede pasar por la llamada publica: Model.predict valida los
            # kwargs contra el esquema de YOLO y lo rechaza. Se queda en una sola mascara, asi que
            # los criterios de abajo la aceptan o la rechazan en vez de elegir entre varias.
            results = self.sam(rgb, points=[[u, v]], labels=[1],
                               device=self.device_name, verbose=False)
        except Exception as e:
            console.print(f"Fallo ejecutando SAM: {e}", style="bold red")
            return []
        if not results or results[0].masks is None:
            return []
        return [(mask > 0).astype(np.uint8) for mask in results[0].masks.data.cpu().numpy()]

    def measure_mask_3d(self, mask_uint8, depth_m, image, root_to_camera):
        """Reconstruye la mascara en 3D (marco root) con la profundidad y la mide: centro en el
        suelo, diametro y altura. None si no hay puntos suficientes con profundidad."""
        # Sin el borde: sus pixeles mezclan la profundidad del objeto con la del fondo.
        vs, us = np.nonzero(cv2.erode(mask_uint8, np.ones((3, 3), np.uint8)))
        d = depth_m[vs, us]
        valid = np.isfinite(d) & (d > 0)
        if valid.sum() < self.verify_min_points:
            return None
        us, vs, d = us[valid].astype(np.float64), vs[valid].astype(np.float64), d[valid].astype(np.float64)

        # Inversa de project_root_point: camara +X avance, +Y izquierda, +Z arriba.
        points_camera = np.stack([d, (image.width / 2 - us) * d / image.focalx,
                                  (image.height / 2 - vs) * d / image.focaly, np.ones_like(d)])
        points_root = (root_to_camera @ points_camera)[:3].T

        # Medidas en ejes de la vista: la parte trasera del objeto queda oculta, asi que el
        # diametro sale del ancho lateral y el centro del borde cercano + radio (huella
        # circular). Percentiles 0.5/99.5: la profundidad trae valores sueltos.
        forward = root_to_camera[:2, 0] / max(np.linalg.norm(root_to_camera[:2, 0]), 1e-6)
        lateral = np.array([-forward[1], forward[0]])
        along, across = points_root[:, :2] @ forward, points_root[:, :2] @ lateral
        across_lo, across_hi = np.percentile(across, [0.5, 99.5])
        diameter = float(across_hi - across_lo)
        center = (np.percentile(along, 0.5) + diameter / 2.0) * forward + (across_lo + across_hi) / 2.0 * lateral
        # Altura desde z = 0 de root, que es el suelo.
        height = float(np.percentile(points_root[:, 2], 98))
        return {"center_m": center, "diameter_m": diameter, "height_m": height, "points": int(valid.sum())}

    def mask_candidates_for_point(self, concept_node, rgb, depth_m, image, u, v):
        """Segmenta con SAM en (u, v), mide cada mascara en 3D y marca "ok" las que pasan los
        criterios de la validacion; lista vacia si SAM falla o falta la pose de la camara."""
        masks = self.run_sam(rgb, u, v)
        if not masks:
            return []

        root_to_camera = self.get_root_to_camera_transform()
        if root_to_camera is None or "simulated_position" not in concept_node.attrs:
            console.print("Sin pose de la camara o sin simulated_position: no se puede medir la mascara.", style="bold red")
            return []
        simulated_xy = np.array([float(c) for c in concept_node.attrs["simulated_position"].value[:2]])

        candidates = []
        for mask_uint8 in masks:
            if mask_uint8.shape != depth_m.shape:
                mask_uint8 = cv2.resize(mask_uint8, (depth_m.shape[1], depth_m.shape[0]),
                                        interpolation=cv2.INTER_NEAREST)
            candidate = {"mask": mask_uint8, "ok": False, "shift_m": float("inf")}
            candidates.append(candidate)

            measure = self.measure_mask_3d(mask_uint8, depth_m, image, root_to_camera)
            if measure is None:
                console.print("  candidata: sin puntos suficientes con profundidad -> descartada", style="cyan")
                continue
            diameter, height = measure["diameter_m"], measure["height_m"]
            shift = float(np.linalg.norm(measure["center_m"] - simulated_xy))

            checks = {
                "diametro": self.verify_diameter_range_m[0] <= diameter <= self.verify_diameter_range_m[1],
                "altura": self.verify_height_range_m[0] <= height <= self.verify_height_range_m[1],
                "desplazamiento": shift <= self.verify_max_shift_m,
            }
            candidate.update(measure)
            candidate.update({"shift_m": shift, "ok": all(checks.values())})

            # concept_size solo como referencia en el log: es lo que se quiere corregir.
            failed = [name for name, passed in checks.items() if not passed]
            console.print(f"  candidata: {measure['points']} puntos, diametro {diameter:.3f} m "
                          f"(simulado {self.expected_size(concept_node):.3f}), altura {height:.3f} m, "
                          f"desplazamiento {shift:.3f} m -> "
                          f"{'aceptada' if candidate['ok'] else 'descartada por ' + ', '.join(failed)}", style="cyan")

        return candidates

    def save_verification_images(self, rgb, image, simulated_uv, candidates, best):
        """Deja en la carpeta de la sesion el apoyo visual de la validacion: el centro simulado
        antes de corregir, y despues el corregido (o las mascaras rechazadas si no pasa)."""
        folder = os.path.join(self.photo_session_dir, "verificacion")
        os.makedirs(folder, exist_ok=True)
        base = cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)
        su, sv = int(round(simulated_uv[0])), int(round(simulated_uv[1]))

        # Antes de corregir: solo el centro de la huella simulada (rojo).
        pre = base.copy()
        cv2.drawMarker(pre, (su, sv), (0, 0, 255), cv2.MARKER_CROSS, 30, 2)
        cv2.putText(pre, "centro simulado", (su + 12, sv - 12), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)
        cv2.imwrite(os.path.join(folder, "pre_correccion.jpg"), pre)

        # Despues: contorno de la mascara aceptada (amarillo) y centro corregido (verde); si no
        # hay aceptada, los contornos rechazados (magenta) para ver que segmento SAM.
        post = base.copy()
        for c in ([best] if best is not None else candidates):
            contours, _ = cv2.findContours(c["mask"], cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            cv2.drawContours(post, contours, -1, (0, 255, 255) if best is not None else (255, 0, 255), 2)
        cv2.drawMarker(post, (su, sv), (0, 0, 255), cv2.MARKER_CROSS, 30, 2)
        if best is None:
            cv2.putText(post, "validacion NEGATIVA", (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 1.0, (255, 0, 255), 2)
            cv2.imwrite(os.path.join(folder, "post_rechazada.jpg"), post)
            return

        corrected = self.project_root_point([best["center_m"][0], best["center_m"][1], 0.0], image)
        if corrected is not None and not corrected["behind"]:
            cu, cv_ = int(round(corrected["u"])), int(round(corrected["v"]))
            cv2.drawMarker(post, (cu, cv_), (0, 255, 0), cv2.MARKER_CROSS, 30, 2)
            cv2.putText(post, "centro corregido", (cu + 12, cv_ + 24), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
        cv2.putText(post, f"diametro {best['diameter_m']:.3f} m  altura {best['height_m']:.3f} m  "
                          f"desplazamiento {best['shift_m']:.3f} m",
                    (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
        cv2.imwrite(os.path.join(folder, "post_correccion.jpg"), post)

    def get_current_rgbd(self):
        """Frame RGB y profundidad en metros del mismo instante, más el struct de imagen con las
        intrínsecas que necesita la proyección."""
        try:
            rgbd = self.camerargbdsimple_proxy.getAll(self.camera_name)
            image, depth = rgbd.image, rgbd.depth
            if not image.image or image.width <= 0 or image.height <= 0:
                return None, None, None

            rgb = np.frombuffer(bytes(image.image), dtype=np.uint8).reshape(image.height, image.width, 3)

            depth_m = None
            if depth.depth and depth.width > 0 and depth.height > 0:
                depth_m = np.frombuffer(bytes(depth.depth), dtype=np.float32).reshape(depth.height, depth.width)
                depth_m = depth_m * depth.depthFactor
                if depth_m.shape != rgb.shape[:2]:
                    depth_m = cv2.resize(depth_m, (rgb.shape[1], rgb.shape[0]), interpolation=cv2.INTER_NEAREST)

            return rgb, depth_m, image
        except Exception as e:
            console.print(f"Fallo leyendo la cámara: {e}", style="bold red")
            return None, None, None

    def get_root_to_camera_transform(self):
        """Compone la montura fija de la zed con la RT viva root->robot: transformada
        root->cámara 4x4 en metros, o None si falta algo en el grafo."""
        robot_node = self.g.get_node("robot")
        root_node = self.g.get_node("root")
        if robot_node is None or root_node is None:
            return None

        rt_edge = self.g.get_edge(root_node.id, robot_node.id, "RT")
        if rt_edge is None or "rt_translation" not in rt_edge.attrs or "rt_quaternion" not in rt_edge.attrs:
            return None

        t = rt_edge.attrs["rt_translation"].value
        translation = [float(t[1]), float(t[0]), float(t[2])]
        qx, qy, qz, qw = rt_edge.attrs["rt_quaternion"].value

        root_to_robot = _homogeneous_transform(_rotation_matrix_from_quaternion(qx, qy, qz, qw), translation)
        robot_to_camera = _homogeneous_transform(
            _rotation_matrix_from_axis_angle(ZED_MOUNT_ROTATION_AXIS, ZED_MOUNT_ROTATION_ANGLE_RAD),
            ZED_MOUNT_OFFSET_M,
        )
        return root_to_robot @ robot_to_camera

    def project_simulated_position(self, concept_node, image):
        """Proyecta simulated_position (marco root, metros) en la imagen. A diferencia de la versión
        de vision_sam devuelve también los puntos que caen fuera del encuadre: el etiquetado
        necesita distinguir "fuera de cuadro" de "no proyectable"."""
        if "simulated_position" not in concept_node.attrs:
            return None
        wp = concept_node.attrs["simulated_position"].value
        return self.project_root_point([float(wp[0]), float(wp[1]), float(wp[2])], image)

    def labelling_footprint(self, concept_node):
        """Huella con la que se etiqueta: la corregida por la validacion si paso, y si no la
        simulada (simulated_position y concept_size). None sin simulated_position."""
        if self.footprint is not None:
            return {"center_m": [float(c) for c in self.footprint["center_m"][:2]],
                    "diameter_m": float(self.footprint["diameter_m"]),
                    "height_m": float(self.footprint["height_m"]), "source": "sam"}
        if "simulated_position" not in concept_node.attrs:
            return None
        wp = concept_node.attrs["simulated_position"].value
        size = [float(v) for v in concept_node.attrs["concept_size"].value] if "concept_size" in concept_node.attrs else []
        return {"center_m": [float(wp[0]), float(wp[1])], "diameter_m": float(self.expected_size(concept_node)),
                "height_m": size[2] if len(size) == 3 else None, "source": "simulacion"}

    def project_root_point(self, point_root_m, image):
        """Proyecta un punto del marco root (metros) en la imagen; None si falta la pose."""
        root_to_camera = self.get_root_to_camera_transform()
        if root_to_camera is None:
            return None

        point_camera = np.linalg.inv(root_to_camera) @ np.array(
            [point_root_m[0], point_root_m[1], point_root_m[2], 1.0])

        # Webots Camera/RangeFinder/Lidar: +X forward, +Y left, +Z up (ROS-style body axes, not OpenGL -Z-forward).
        depth_m = point_camera[0]
        if depth_m <= 0:
            return {"behind": True, "u": None, "v": None, "depth_m": 0.0}

        u = image.width / 2 - image.focalx * (point_camera[1] / depth_m)
        v = image.height / 2 - image.focaly * (point_camera[2] / depth_m)
        return {"behind": False, "u": u, "v": v, "depth_m": depth_m}

    def floor_hit_per_pixel(self, image, root_to_camera):
        """Corta el rayo de cada pixel con el suelo (z = 0 de root): punto XY en root y
        profundidad plana a la que deberia verse; inf donde el rayo no llega al suelo."""
        us, vs = np.meshgrid(np.arange(image.width, dtype=np.float64), np.arange(image.height, dtype=np.float64))
        dirs = np.stack([np.ones_like(us), (image.width / 2 - us) / image.focalx,
                         (image.height / 2 - vs) / image.focaly], axis=-1) @ root_to_camera[:3, :3].T
        origin = root_to_camera[:3, 3]
        with np.errstate(divide="ignore", invalid="ignore"):
            t = np.where(dirs[..., 2] < 0, -origin[2] / dirs[..., 2], np.inf)
        # La componente de avance del rayo en la camara vale 1, asi que t es la profundidad plana.
        floor_xy = origin[:2] + np.where(np.isfinite(t), t, 0.0)[..., None] * dirs[..., :2]
        return floor_xy, t

    def label_mask(self, footprint, depth_m, image, root_to_camera):
        """Mascara de etiqueta: 1 bache, 0 fondo, 255 ignorado. Cada pixel se lleva al suelo y se
        etiqueta por su distancia al centro de la huella. Huella de SAM: bache hasta r - banda e
        ignorado hasta r + banda. Huella simulada (poco fiable): bache solo en el nucleo e ignorado
        hasta r + Verify_max_shift_m, lo maximo que la validacion habria corregido."""
        floor_xy, floor_depth = self.floor_hit_per_pixel(image, root_to_camera)
        dist = np.linalg.norm(floor_xy - np.array(footprint["center_m"]), axis=-1)
        r = footprint["diameter_m"] / 2.0
        if footprint["source"] == "sam":
            bump_r, ignore_r = r - self.label_ignore_band_sam_m, r + self.label_ignore_band_sam_m
        else:
            bump_r, ignore_r = r * self.label_sim_core_fraction, r + self.verify_max_shift_m

        mask = np.zeros((image.height, image.width), np.uint8)
        on_floor = np.isfinite(floor_depth)
        mask[on_floor & (dist <= ignore_r)] = LABEL_IGNORE
        mask[on_floor & (dist <= bump_r)] = LABEL_BUMP
        # Algo delante del suelo (persona, pared) tapa la huella: es fondo, no bache.
        if depth_m is not None:
            occluded = np.isfinite(depth_m) & (depth_m > 0) & (depth_m < floor_depth - OCCLUSION_MARGIN_M)
            mask[occluded & (mask != 0)] = LABEL_BACKGROUND
        return mask

    def take_labelled_photo(self, concept_node):
        """Captura el frame actual con su profundidad y su mascara de etiqueta (huella corregida
        por la validacion o simulada) y anota la foto en annotations.jsonl. El robot está parado."""
        rgb, depth_m, image = self.get_current_rgbd()
        if rgb is None:
            console.print("Disparo descartado: sin imagen de la cámara.", style="bold red")
            return
        footprint = self.labelling_footprint(concept_node)
        root_to_camera = self.get_root_to_camera_transform()
        if footprint is None or root_to_camera is None:
            console.print("Disparo descartado: sin huella o sin pose de la cámara.", style="bold red")
            return

        mask = self.label_mask(footprint, depth_m, image, root_to_camera)
        name = f"{self.photo_counter:03d}"
        paths = {"rgb": f"rgb/{name}.jpg", "mask": f"mask/{name}.png",
                 "depth": None if depth_m is None else f"depth/{name}.npy"}
        for folder in ("rgb", "mask", "depth"):
            os.makedirs(os.path.join(self.photo_session_dir, folder), exist_ok=True)
        if not cv2.imwrite(os.path.join(self.photo_session_dir, paths["rgb"]), cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)):
            console.print(f"Disparo descartado: cv2.imwrite falló en {paths['rgb']}.", style="bold red")
            return
        cv2.imwrite(os.path.join(self.photo_session_dir, paths["mask"]), mask)
        if depth_m is not None:
            np.save(os.path.join(self.photo_session_dir, paths["depth"]), depth_m.astype(np.float16))
        self.photo_counter += 1

        # La etiqueta sale de la huella, o sea de la creencia: la posicion real va en la misma
        # linea para poder detectar despues un dataset mal etiquetado.
        center = self.project_root_point(footprint["center_m"] + [0.0], image)
        record = {"index": name, "timestamp_ms": int(time.time() * 1000), "paths": paths, "footprint": footprint,
                  "center_projection": center,
                  "pixels": {"bache": int((mask == LABEL_BUMP).sum()), "ignorado": int((mask == LABEL_IGNORE).sum())},
                  "root_to_camera": root_to_camera.tolist(),
                  "intrinsics": {"width": image.width, "height": image.height,
                                 "focalx": float(image.focalx), "focaly": float(image.focaly)},
                  "real": self.real_reference()}
        with open(self.annotations_path, "a") as log:
            log.write(json.dumps(record, default=float) + "\n")
        console.print(f"Foto {name}: {record['pixels']['bache']} px de bache, {record['pixels']['ignorado']} "
                      f"ignorados (huella {footprint['source']})",
                      style="green" if record["pixels"]["bache"] else "blue")

    # Concept classifier
    def run_training(self):
        """Entrena en un hilo aparte (tarda minutos y compute() tiene que seguir publicando la RT)
        con las fotos de esta tanda y pasa a clasificar. Un intento por tanda."""
        if self.training_thread is None:
            self.session_trained = True
            # Sin fotos no hay nada que entrenar: se avisa y se queda en reposo
            if not os.path.exists(self.annotations_path):
                console.print("Tanda sin fotos: no se entrena el clasificador.", style="bold yellow")
                self.stage = Stage.IDLE
                return
            self.training_thread = threading.Thread(target=self.train_classifier,
                                                    args=(self.photo_session_dir,), daemon=True)
            self.training_thread.start()
            return
        if self.training_thread.is_alive():
            return
        if self.classifier is not None:
            self.stage = Stage.INFERRING
        else:
            console.print("Entrenamiento fallido para esta tanda; no se reintenta.", style="bold red")
            self.stage = Stage.IDLE

    def load_backbone(self):
        """Carga DINOv3 desde el repo y los pesos locales. Importa aquí dentro para que faltar
        torch/sklearn no impida al agente seguir publicando la RT."""
        import torch

        if self.dinov3_repo not in sys.path:
            sys.path.insert(0, self.dinov3_repo)
        from dinov3.hub.backbones import dinov3_vits16

        device = "cuda" if torch.cuda.is_available() else "cpu"
        backbone = dinov3_vits16(weights=self.dinov3_weights).eval().to(device)
        console.print(f"DINOv3 cargado en {device} (embed_dim={backbone.embed_dim}, patch={backbone.patch_size})", style="green")
        return backbone, device

    def embed_patches(self, rgb_array):
        """Vector de cada trozo de patch_size x patch_size de una imagen RGB (H, W, 3) a
        resolución nativa: array (filas, columnas, embed_dim)."""
        import torch
        from torchvision import transforms

        # w/h need to be multiples of the patch size
        patch = self.backbone.patch_size
        rows, cols = rgb_array.shape[0] // patch, rgb_array.shape[1] // patch
        cropped = np.ascontiguousarray(rgb_array[:rows * patch, :cols * patch, :])

        tensor = transforms.functional.to_tensor(cropped)
        tensor = transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])(tensor)
        with torch.no_grad():
            tokens = self.backbone.forward_features(tensor.unsqueeze(0).to(self.device))["x_norm_patchtokens"]
        return tokens.squeeze(0).cpu().numpy().reshape(rows, cols, -1)

    def cached_patch_features(self, photos_dir, record, rgb):
        """Vectores por trozo de una foto, de la cache si ya estan (dependen del modelo y la resolucion)."""
        folder = os.path.join(photos_dir, "features", f"dinov3_vits16_{rgb.shape[1]}x{rgb.shape[0]}")
        path = os.path.join(folder, f"{record['index']}.npy")
        if os.path.exists(path):
            return np.load(path).astype(np.float32)
        features = self.embed_patches(rgb)
        os.makedirs(folder, exist_ok=True)
        np.save(path, features.astype(np.float16))
        return features

    def patch_labels(self, mask, rows, cols):
        """Etiqueta de cada trozo a partir de la mascara: 1 si al menos Patch_positive_fraction de
        sus pixeles es bache, 0 si todos son fondo, -1 (ignorado) en cualquier otro caso."""
        patch = self.backbone.patch_size
        blocks = mask[:rows * patch, :cols * patch].reshape(rows, patch, cols, patch).swapaxes(1, 2)
        bump_fraction = (blocks == LABEL_BUMP).mean(axis=(2, 3))
        all_background = (blocks == LABEL_BACKGROUND).all(axis=(2, 3))
        labels = np.full((rows, cols), -1, np.int8)
        labels[all_background] = 0
        labels[bump_fraction >= self.patch_positive_fraction] = 1
        return labels

    def train_classifier(self, photos_dir):
        """Regresion logistica sobre los vectores por trozo de DINOv3. Valida dejando fuera una foto
        entera cada vez (los trozos de una misma foto se parecen y darian una precision inflada) y
        guarda modelo, metadatos y metricas en model_dir."""
        try:
            import joblib
            from sklearn.linear_model import LogisticRegression
            from sklearn.metrics import f1_score, roc_auc_score
        except ImportError as e:
            console.print(f"Sin dependencias para entrenar ({e}); el agente sigue publicando la RT.", style="bold red")
            return False

        try:
            self.backbone, self.device = self.load_backbone()
            rng = np.random.default_rng(0)
            with open(os.path.join(photos_dir, "annotations.jsonl")) as f:
                records = [json.loads(line) for line in f if line.strip()]

            photos = []
            for record in records:
                rgb = cv2.cvtColor(cv2.imread(os.path.join(photos_dir, record["paths"]["rgb"])), cv2.COLOR_BGR2RGB)
                mask = cv2.imread(os.path.join(photos_dir, record["paths"]["mask"]), cv2.IMREAD_UNCHANGED)
                features = self.cached_patch_features(photos_dir, record, rgb)
                labels = self.patch_labels(mask, features.shape[0], features.shape[1])
                # Todos los positivos y un maximo de negativos por foto: hay cientos por cada positivo.
                pos, neg = np.flatnonzero(labels.ravel() == 1), np.flatnonzero(labels.ravel() == 0)
                neg = rng.choice(neg, min(len(neg), self.train_negatives_per_image), replace=False)
                photos.append({"record": record, "features": features, "labels": labels, "mask": mask,
                               "train_idx": np.concatenate([pos, neg])})

            with_bump = sum(int((p["labels"] == 1).any()) for p in photos)
            if len(photos) < 2 or with_bump == 0:
                console.print(f"Fotos insuficientes para entrenar ({len(photos)} fotos, {with_bump} con bache).", style="bold red")
                self.backbone = None
                return False
            console.print(f"Entrenando con {len(photos)} fotos ({with_bump} con bache).", style="cyan")

            def fit(subset):
                x = np.concatenate([p["features"].reshape(-1, p["features"].shape[-1])[p["train_idx"]] for p in subset])
                y = np.concatenate([p["labels"].ravel()[p["train_idx"]] for p in subset])
                return LogisticRegression(max_iter=2000, class_weight="balanced").fit(x, y)

            # leave-one-image-out: cada foto se puntua con un modelo que no la ha visto
            scores, truth, per_photo = [], [], []
            for i, held in enumerate(photos):
                train = photos[:i] + photos[i + 1:]
                if not any((p["labels"] == 1).any() for p in train):
                    continue
                prob = self.patch_probabilities(fit(train), held["features"])
                labelled = held["labels"] >= 0
                scores.append(prob[labelled])
                truth.append(held["labels"][labelled])
                has_bump = bool((held["labels"] == 1).any())
                detection = self.detect_in_map(prob)
                error_px = None
                if has_bump and detection is not None:
                    vs, us = np.nonzero(held["mask"] == LABEL_BUMP)
                    error_px = float(np.hypot(detection["center_uv"][0] - us.mean(), detection["center_uv"][1] - vs.mean()))
                per_photo.append({"index": held["record"]["index"], "has_bump": has_bump,
                                  "p_max": float(prob.max()), "detected": detection is not None,
                                  "center_error_px": error_px})

            scores, truth = np.concatenate(scores), np.concatenate(truth)
            predicted = scores >= self.detection_threshold
            image_hits = [p["has_bump"] == p["detected"] for p in per_photo]
            errors = [p["center_error_px"] for p in per_photo if p["center_error_px"] is not None]
            metrics = {
                "photos": len(photos), "photos_with_bump": with_bump,
                "patches": {"positive": int((truth == 1).sum()), "negative": int((truth == 0).sum()),
                            "auc": float(roc_auc_score(truth, scores)) if len(set(truth)) == 2 else None,
                            "f1": float(f1_score(truth, predicted, zero_division=0))},
                "image_accuracy": float(np.mean(image_hits)) if image_hits else None,
                "center_error_px_median": float(np.median(errors)) if errors else None,
                "per_photo": per_photo,
            }
            console.print(f"Leave-one-image-out: AUC por trozo {metrics['patches']['auc']}, F1 {metrics['patches']['f1']:.3f}, "
                          f"acierto por imagen {metrics['image_accuracy']}, error del centro (mediana) "
                          f"{metrics['center_error_px_median']} px", style="bold green")

            self.classifier = fit(photos)
            os.makedirs(self.model_dir, exist_ok=True)
            joblib.dump(self.classifier, os.path.join(self.model_dir, "logreg.joblib"))
            with open(os.path.join(self.model_dir, "meta.json"), "w") as f:
                json.dump({"backbone": "dinov3_vits16", "weights": self.dinov3_weights,
                           "patch_size": self.backbone.patch_size,
                           "grid": list(photos[0]["features"].shape[:2]),
                           "detection_threshold": self.detection_threshold,
                           "patch_positive_fraction": self.patch_positive_fraction}, f, indent=1)
            with open(os.path.join(self.model_dir, "metrics.json"), "w") as f:
                json.dump(metrics, f, indent=1)
            console.print(f"Clasificador guardado en {self.model_dir}/", style="green")
            return True

        except Exception as e:
            console.print(f"Fallo entrenando el clasificador: {e}", style="bold red")
            self.backbone = None
            self.classifier = None
            return False

    def patch_probabilities(self, classifier, features):
        """Mapa (filas, columnas) con la probabilidad de bache de cada trozo."""
        rows, cols, dim = features.shape
        return classifier.predict_proba(features.reshape(-1, dim))[:, 1].reshape(rows, cols)

    def detect_regions(self, prob):
        """Todas las regiones conexas sobre el umbral (una por bache en vista), de mayor a menor
        pico, con su caja y su centro ponderado por probabilidad, en pixeles."""
        if prob.max() < self.detection_threshold:
            return []
        patch = self.backbone.patch_size
        count, labels = cv2.connectedComponents((prob >= self.detection_threshold).astype(np.uint8))
        regions = []
        for k in range(1, count):
            rows, cols = np.nonzero(labels == k)
            weights = prob[rows, cols]
            peak = int(np.argmax(weights))
            regions.append({"p_max": float(weights[peak]),
                            "peak_uv": [(cols[peak] + 0.5) * patch, (rows[peak] + 0.5) * patch],
                            "center_uv": [float(((cols + 0.5) * weights).sum() / weights.sum() * patch),
                                          float(((rows + 0.5) * weights).sum() / weights.sum() * patch)],
                            "box_uv": [int(cols.min() * patch), int(rows.min() * patch),
                                       int((cols.max() + 1) * patch), int((rows.max() + 1) * patch)],
                            "touches_border": bool(rows.min() == 0 or cols.min() == 0 or
                                                   rows.max() == prob.shape[0] - 1 or cols.max() == prob.shape[1] - 1)})
        return sorted(regions, key=lambda r: -r["p_max"])

    def detect_in_map(self, prob):
        """Deteccion principal: la region que contiene el pico. None si nada supera el umbral."""
        regions = self.detect_regions(prob)
        return regions[0] if regions else None

    def refine_with_sam(self, rgb, depth_m, image, center_uv):
        """Clic de SAM en el centro de la deteccion y medida 3D de su mascara. Se acepta si
        diametro y altura estan a +-Detection_size_tolerance de la huella con la que se entreno."""
        root_to_camera = self.get_root_to_camera_transform()
        concept_node = self.g.get_node(CONCEPT_NAME)
        reference = None if concept_node is None else self.labelling_footprint(concept_node)
        if depth_m is None or root_to_camera is None or reference is None:
            return {"sam": "sin_datos"}
        masks = self.run_sam(rgb, int(center_uv[0]), int(center_uv[1]))
        if not masks:
            return {"sam": "sin_mascara"}
        mask = masks[0]
        if mask.shape != depth_m.shape:
            mask = cv2.resize(mask, (depth_m.shape[1], depth_m.shape[0]), interpolation=cv2.INTER_NEAREST)
        measure = self.measure_mask_3d(mask, depth_m, image, root_to_camera)
        if measure is None:
            return {"sam": "sin_profundidad", "mask": mask}

        tolerance = self.detection_size_tolerance
        ok = abs(measure["diameter_m"] - reference["diameter_m"]) <= tolerance * reference["diameter_m"]
        if reference["height_m"]:
            ok = ok and abs(measure["height_m"] - reference["height_m"]) <= tolerance * reference["height_m"]
        return {"sam": "aceptada" if ok else "rechazada", "mask": mask, **measure}

    def classify_current_view(self):
        """Mapa de probabilidad del frame actual, deteccion, refinado opcional con SAM y una fila
        en inference.csv (con la posicion real proyectada, para medir aciertos despues)."""
        try:
            rgb, depth_m, image = self.get_current_rgbd()
            if rgb is None:
                return

            prob = self.patch_probabilities(self.classifier, self.embed_patches(rgb))
            regions = self.detect_regions(prob)
            detection = regions[0] if regions else None
            refined = {"sam": "no_usado"}
            if detection is not None and self.inference_sam_refine:
                refined = self.refine_with_sam(rgb, depth_m, image, detection["center_uv"])
            self.locate_regions(regions, refined, depth_m, image)

            real = self.real_reference()
            real_uv = None
            if real is not None:
                projection = self.project_root_point(real["world"], image)
                if projection is not None and not projection["behind"]:
                    real_uv = [projection["u"], projection["v"]]

            if detection is None:
                console.print(f"Vista actual: sin bache (p_max={prob.max():.3f})", style="blue")
            else:
                console.print(f"Vista actual: bache en ({detection['center_uv'][0]:.0f}, {detection['center_uv'][1]:.0f}) "
                              f"p_max={detection['p_max']:.3f}, SAM {refined['sam']}", style="bold green")
                if self.inference_save_heatmaps:
                    self.save_heatmap(rgb, prob, detection, refined, real_uv)

            def fmt(values):
                return "," if values is None else f"{values[0]:.1f},{values[1]:.1f}"
            path = os.path.join(self.model_dir, "inference.csv")
            new_file = not os.path.exists(path)
            with open(path, "a") as log:
                if new_file:
                    log.write("timestamp_ms,detected,p_max,center_u,center_v,box_u0,box_v0,box_u1,box_v1,"
                              "sam,sam_diameter_m,sam_height_m,sam_x,sam_y,real_u,real_v,real_world_x,real_world_y\n")
                box = ",,," if detection is None else ",".join(str(v) for v in detection["box_uv"])
                sam_values = ",,," if "diameter_m" not in refined else (
                    f"{refined['diameter_m']:.3f},{refined['height_m']:.3f},"
                    f"{refined['center_m'][0]:.3f},{refined['center_m'][1]:.3f}")
                real_world = "," if real is None else f"{real['world'][0]:.3f},{real['world'][1]:.3f}"
                log.write(f"{int(time.time() * 1000)},{int(detection is not None)},{prob.max():.4f},"
                          f"{fmt(None if detection is None else detection['center_uv'])},{box},{refined['sam']},"
                          f"{sam_values},{fmt(real_uv)},{real_world}\n")

        except Exception as e:
            console.print(f"Fallo clasificando la vista actual: {e}", style="bold red")

    def locate_regions(self, regions, refined, depth_m, image):
        """Lleva cada region detectada al mundo y actualiza las instancias. Se descartan las que
        tocan el borde (el bache sale cortado y su centro desplazado) y, si SAM refina la principal,
        la que rechaza; si la acepta se usa su centro medido."""
        root_to_camera = self.get_root_to_camera_transform()
        if depth_m is None or root_to_camera is None:
            return
        points = []
        for k, region in enumerate(regions):
            if region["touches_border"]:
                continue
            if k == 0 and refined["sam"] == "rechazada":
                continue
            if k == 0 and refined["sam"] == "aceptada":
                points.append(np.array(refined["center_m"][:2], dtype=np.float64))
                continue
            xy = self.region_world_point(region, depth_m, image, root_to_camera)
            if xy is not None:
                points.append(xy)
        if points:
            self.update_instances(points)

    def save_heatmap(self, rgb, prob, detection, refined, real_uv):
        """Mapa de probabilidad superpuesto al frame: caja y centro de la deteccion (verde),
        contorno de SAM (amarillo si se acepta, magenta si no) y posicion real (rojo)."""
        folder = os.path.join(self.model_dir, "heatmaps")
        os.makedirs(folder, exist_ok=True)
        patch = self.backbone.patch_size
        heat = cv2.resize((prob * 255).astype(np.uint8), (prob.shape[1] * patch, prob.shape[0] * patch),
                          interpolation=cv2.INTER_NEAREST)
        frame = cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)
        region = frame[:heat.shape[0], :heat.shape[1]]
        frame[:heat.shape[0], :heat.shape[1]] = cv2.addWeighted(region, 0.6, cv2.applyColorMap(heat, cv2.COLORMAP_JET), 0.4, 0)

        u0, v0, u1, v1 = detection["box_uv"]
        cv2.rectangle(frame, (u0, v0), (u1, v1), (0, 255, 0), 2)
        cu, cv_ = (int(c) for c in detection["center_uv"])
        cv2.drawMarker(frame, (cu, cv_), (0, 255, 0), cv2.MARKER_CROSS, 30, 2)
        if "mask" in refined:
            contours, _ = cv2.findContours(refined["mask"], cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            cv2.drawContours(frame, contours, -1, (0, 255, 255) if refined["sam"] == "aceptada" else (255, 0, 255), 2)
        if real_uv is not None:
            cv2.drawMarker(frame, (int(real_uv[0]), int(real_uv[1])), (0, 0, 255), cv2.MARKER_TILTED_CROSS, 20, 2)
        cv2.putText(frame, f"p_max {detection['p_max']:.3f}  SAM {refined['sam']}", (20, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (255, 255, 255), 2)
        cv2.imwrite(os.path.join(folder, f"{int(time.time() * 1000)}.jpg"), frame)
