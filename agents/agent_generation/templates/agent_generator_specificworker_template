class Stage:
    """Etapas del agente: lo que hace en cada compute(), ademas de publicar su RT."""
    IDLE = "idle"              # concept exists, no mission yet
    SHOOTING = "shooting"      # mission started, shot when mission is running: triggered at each robot stop
    TRAINING = "training"      # photos taken, training classifier
    VERIFYING = "verifying"    # checking with SAM that the concept is where the simulation says
    INFERRING = "inferring"    # classifier ready: classifier view every N cycles


def _rotation_matrix_from_axis_angle(axis, angle):
    """Rodrigues: matriz de rotacion 3x3 a partir de eje y angulo."""
    axis = np.array(axis, dtype=np.float64)
    axis = axis / np.linalg.norm(axis)
    x, y, z = axis
    c, s = np.cos(angle), np.sin(angle)
    C = 1 - c
    return np.array([
        [x * x * C + c,     x * y * C - z * s, x * z * C + y * s],
        [y * x * C + z * s, y * y * C + c,     y * z * C - x * s],
        [z * x * C - y * s, z * y * C + x * s, z * z * C + c],
    ])


def _rotation_matrix_from_quaternion(qx, qy, qz, qw):
    """Matriz de rotacion 3x3 a partir de un cuaternion (x, y, z, w)."""
    n = np.sqrt(qx * qx + qy * qy + qz * qz + qw * qw)
    if n < 1e-9:
        return np.eye(3)
    qx, qy, qz, qw = qx / n, qy / n, qz / n, qw / n
    return np.array([
        [1 - 2 * (qy * qy + qz * qz), 2 * (qx * qy - qz * qw),     2 * (qx * qz + qy * qw)],
        [2 * (qx * qy + qz * qw),     1 - 2 * (qx * qx + qz * qz), 2 * (qy * qz - qx * qw)],
        [2 * (qx * qz - qy * qw),     2 * (qy * qz + qx * qw),     1 - 2 * (qx * qx + qy * qy)],
    ])


def _homogeneous_transform(rotation_3x3, translation_3):
    """Transformada homogenea 4x4 a partir de una rotacion 3x3 y una traslacion."""
    t = np.eye(4)
    t[:3, :3] = rotation_3x3
    t[:3, 3] = translation_3
    return t


class SpecificWorker(GenericWorker):
    """Keeps a live robot->{{concept_name}} RT edge, the same way concept_person does for
    "person". Does no affordance/state-machine management: whatever agent created the
    CONCEPT_NAME node owns that; this agent's only job is geometry, while the node exists."""

    def __init__(self, proxy_map, configData, startup_check=False):
        super(SpecificWorker, self).__init__(proxy_map, configData)
        self.Period = configData["Period"]["Compute"]

        self.concept_def = CONCEPT_NAME.upper()
        self.robot_def = "shadow"
        self.simulated = configData["Simulated"]

        self.print_extra_info = False
        self.last_relative_pose = [0.0, 0.0, 0.0]
        self.has_published_once = False  # force the very first RT write, don't rely on read noise

        # photos mission, concept_robot stops, this agent captures and labels
        self.camera_name = configData["Camera_name"]
        self.expected_size_m = configData["Expected_size_m"]
        self.label_margin_factor = configData["Label_margin_factor"]
        self.stage = Stage.IDLE
        self.sam = None
        self.sam_weights = configData["Sam_weights"]
        self.verify_size_tolerance = configData["Verify_size_tolerance"]
        self.verify_depth_sigma_max = configData["Verify_depth_sigma_max"]
        self.verify_distance_tolerance = configData["Verify_distance_tolerance"]
        self.verify_answered = False
        self.verify_waiting_logged = False
        self.last_bearing_check_ms = 0    # limita el diagnostico de rumbo a 2 Hz
        self.device_name = "cuda" if self.cuda_available() else "cpu"
        self.mission_was_active = False
        self.shot_at_this_stop = False
        self.photo_counter = 0
        self.session_trained = False
        self.photo_session_dir = os.path.abspath(
            os.path.join(configData["Photo_save_dir"], str(int(time.time() * 1000))))
        os.makedirs(self.photo_session_dir, exist_ok=True)
        self.photo_log_path = os.path.join(self.photo_session_dir, "shots.csv")
        with open(self.photo_log_path, "w") as log:
            log.write("label,u,v,depth_m,path\n")
        console.print(f"Fotos de esta sesión en: {self.photo_session_dir}", style="cyan")

        # concept classifier: trained on the fly with the photos of the mission
        self.dinov3_repo = configData["Dinov3_repo"]
        self.dinov3_weights = configData["Dinov3_weights"]
        self.inference_period_cycles = configData["Inference_period_cycles"]
        self.model_dir = "model"
        self.backbone = None
        self.classifier = None
        self.cycle_count = 0

        if startup_check:
            self.startup_check()
        else:
            self.rt_api = rt_api(self.g)

            self.timer.timeout.connect(self.compute)
            self.timer.start(self.Period)

    def __del__(self):
        """Destructor"""

    @QtCore.Slot()
    def compute(self):
        concept_node = self.g.get_node(CONCEPT_NAME)
        if concept_node is None:
            return  # not created yet

        now_ms = int(time.time() * 1000)
        relative_position = self.get_relative_position(concept_node)

        if self.print_extra_info:
            console.print(f"[{now_ms}] relative_position -> {relative_position}", style="cyan")

        changed = (not self.has_published_once) or self.has_significant_change(relative_position, self.last_relative_pose)
        if changed:
            if self.update_relative_position(relative_position):
                self.last_relative_pose = relative_position
                self.has_published_once = True
                self.publish_real_position()

        if self.stage in (Stage.IDLE, Stage.SHOOTING, Stage.VERIFYING):
            self.log_bearing_check(concept_node, relative_position, now_ms)
            self.serve_photo_mission(concept_node)
        elif self.stage == Stage.TRAINING:
            self.run_training()
        elif self.stage == Stage.INFERRING:
            self.cycle_count += 1
            if self.cycle_count % self.inference_period_cycles == 0:
                self.classify_current_view()

        return True

    def startup_check(self):
        QTimer.singleShot(200, QApplication.instance().quit)

    # Geometric calculations
    def has_significant_change(self, a, b, atol=0.001):
        if len(a) != len(b):
            return True
        return any(abs(x - y) > atol for x, y in zip(a, b))

    def get_relative_position(self, concept_node):
        """Relative position between the robot and CONCEPT_NAME, in the robot's local frame
        (meters). Simulated: world_position, i.e. what the simulation estimated, against the
        robot's Webots pose. Real: TODO, needs a CONCEPT_NAME label from ImageSegmentation (not
        trained yet)."""
        relative_position = [0.0, 0.0, 0.0]

        if self.simulated:
            # El concepto se situa donde lo estimo la simulacion, no donde esta de verdad: es lo
            # que este agente "cree" y es el objetivo al que se aproxima el robot.
            if "world_position" not in concept_node.attrs:
                return self.last_relative_pose
            wp = concept_node.attrs["world_position"].value

            try:
                robot_pose = self.webots2robocomp_proxy.getObjectPose(self.robot_def)
            except Exception as e:
                console.print(f"Sin pose de Webots ({e}); se mantiene la última RT.", style="bold red")
                return self.last_relative_pose

            # world_position va en metros; getObjectPose devuelve milimetros.
            dx = float(wp[0]) - robot_pose.position.x / 1000.0
            dy = float(wp[1]) - robot_pose.position.y / 1000.0
            dz = float(wp[2]) - robot_pose.position.z / 1000.0

            q = robot_pose.orientation
            theta = math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))
            local_x = -math.sin(theta) * dx + math.cos(theta) * dy
            local_y = -math.cos(theta) * dx - math.sin(theta) * dy

            # Convencion de RoboComp: el avance va en la coordenada y, que es lo que asume
            # follow_target al medir el rumbo como atan2(x, y). Mismo orden que concept_person.
            # La primera componente va negada porque el rumbo publicado respondia al giro con el
            # signo contrario al que espera la ley de control (medido en lazo abierto, 209
            # muestras, 96% consistente). atan2(-x, y) = -atan2(x, y): refleja el sentido de giro
            # y deja el cero donde estaba, o sea que de frente sigue siendo rumbo 0.
            relative_position = [-local_y, local_x, dz]
        else:
            # TODO: no trained detector for CONCEPT_NAME yet. Wire this up once a real detector
            # exists; until then this branch returns [0,0,0] and never publishes on the real robot.
            segmented_objects = self.imagesegmentation_proxy.getSegmentedObjects(True, False)
            for obj in segmented_objects:
                if obj.label == CONCEPT_NAME:
                    pc = obj.points3D
                    if len(pc.X) > 0:
                        relative_position = [pc.X[0], pc.Y[0], pc.Z[0]]
                    break

        return relative_position

    def publish_real_position(self):
        """Publica en el nodo del concepto su posicion relativa REAL, con la misma convencion que
        la RT. No la lee nadie: sirve para medir contra ella el error de world_position y de la
        proyeccion cuando algo no cuadra."""
        try:
            concept_pose = self.webots2robocomp_proxy.getObjectPose(self.concept_def)
            robot_pose = self.webots2robocomp_proxy.getObjectPose(self.robot_def)
        except Exception:
            return

        dx = (concept_pose.position.x - robot_pose.position.x) / 1000.0
        dy = (concept_pose.position.y - robot_pose.position.y) / 1000.0
        dz = (concept_pose.position.z - robot_pose.position.z) / 1000.0

        q = robot_pose.orientation
        theta = math.atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y * q.y + q.z * q.z))
        local_x = -math.sin(theta) * dx + math.cos(theta) * dy
        local_y = -math.cos(theta) * dx - math.sin(theta) * dy

        node = self.g.get_node(CONCEPT_NAME)
        if node is None:
            return
        # Mismo orden que la RT, para poder comparar las dos directamente.
        node.attrs["real_position"] = Attribute([float(-local_y), float(local_x), float(dz)], self.agent_id)
        self.g.update_node(node)

    def update_relative_position(self, relative_position):
        """Update the robot->CONCEPT_NAME RT edge in the DSR. Returns True if it was written.

        Sin rechazo de valores atipicos a proposito: el que habia medía el salto en el marco del
        robot, donde un objeto quieto se desplaza mucho solo porque el robot gira, y bloqueaba la
        RT justo cuando mas falta hace. Cuando haya detector real hara falta uno de verdad, con el
        criterio en el marco del mundo o por velocidad plausible del objetivo."""
        robot_node = self.g.get_node("robot")
        concept_node = self.g.get_node(CONCEPT_NAME)

        if robot_node is None or concept_node is None:
            console.print(f"Robot or {CONCEPT_NAME} node not found in DSR.", style="bold red")
            return False

        if len(relative_position) != 3:
            console.print("Invalid relative position size.", style="bold red")
            return False

        self.rt_api.insert_or_assign_edge_RT(robot_node, concept_node.id, relative_position, [0.0, 0.0, 0.0])
        return True

    # ================ Misión de fotos ================

    def log_bearing_check(self, concept_node, relative_position, now_ms):
        """Compara el rumbo de la RT con el que implica la proyeccion a la camara. Son dos
        caminos independientes: si discrepan en signo, la lateralidad de la RT esta mal."""
        if not self.photo_mission_active():
            return
        if now_ms - self.last_bearing_check_ms < 500:   # 2 Hz, no hace falta mas
            return
        self.last_bearing_check_ms = now_ms

        rt_deg = math.degrees(math.atan2(relative_position[0], relative_position[1]))
        try:
            rgb, depth_m, image = self.get_current_rgbd()
            projection = self.project_world_position(concept_node, image)
        except Exception as e:
            console.print(f"[rumbo] RT {rt_deg:+7.1f} | sin proyeccion ({e})", style="yellow")
            return
        # "behind" trae u/v a None: el concepto esta detras de la camara y no hay pixel que medir,
        # que es justo lo que pasa mientras el robot se aleja de espaldas en BACKOFF.
        if projection is None or projection.get("u") is None:
            console.print(f"[rumbo] RT {rt_deg:+7.1f} | sin pixel (concepto fuera del campo)", style="yellow")
            return

        proj_deg = math.degrees(math.atan((projection["u"] - image.width / 2.0) / image.focalx))
        console.print(f"[rumbo] RT {rt_deg:+7.1f} | proyeccion {proj_deg:+7.1f} | "
                      f"dif {((rt_deg - proj_deg + 180) % 360) - 180:+7.1f} | "
                      f"d {math.hypot(relative_position[0], relative_position[1]):.2f} m", style="magenta")

    def photo_mission_active(self):
        """La misión de fotos está en marcha si el TARGET apunta a este concepto y su afordance,
        alcanzada por TARGET -> has_intention, tiene aff_interacting a true."""
        concept_node = self.g.get_node(CONCEPT_NAME)
        if concept_node is None:
            return False

        targets = [e for e in self.g.get_edges_by_type("TARGET") if e.destination == concept_node.id]
        if not targets:
            return False

        for edge in self.g.get_edges_by_type("has_intention"):
            if edge.origin != concept_node.id:
                continue
            affordance = self.g.get_node(edge.destination)
            if affordance is not None and "aff_interacting" in affordance.attrs:
                return bool(affordance.attrs["aff_interacting"].value)
        return False

    def robot_is_stopped(self):
        """Velocidades de referencia del nodo robot a cero: es la parada que hace concept_robot
        en cada paso del giro, y la señal con la que este agente dispara."""
        robot_node = self.g.get_node("robot")
        if robot_node is None:
            return False
        for name in ("robot_ref_adv_speed", "robot_ref_rot_speed"):
            if name not in robot_node.attrs:
                return False
            if abs(robot_node.attrs[name].value) > STOPPED_SPEED_EPSILON:
                return False
        return True

    def cuda_available(self):
        """True si torch ve una GPU. Se importa aqui para no pagar la carga si no hace falta."""
        try:
            import torch
            return torch.cuda.is_available()
        except Exception:
            return False

    def serve_photo_mission(self, concept_node):
        """Atiende la verificación que pide concept_robot, dispara una vez por parada mientras la
        misión está activa, y cierra la tanda cuando la afordance se apaga."""
        active = self.photo_mission_active()

        # La verificacion se contesta una sola vez por mision, antes de que empiece el giro.
        if active and not self.verify_answered and self.read_bool_attr(concept_node, "verify_request"):
            self.stage = Stage.VERIFYING
            # Si todavia no lo tiene en cuadro no contesta: concept_robot sigue girando.
            self.verify_answered = self.verify_concept(concept_node)
            return

        # Solo se dispara despues de que la verificacion haya contestado: antes del APPROACH el
        # robot esta parado un instante y se colaba una foto con el concepto fuera de cuadro.
        if active and self.verify_answered:
            self.stage = Stage.SHOOTING
            # one photo per stop, even if the stop lasts several cycles
            if self.robot_is_stopped():
                if not self.shot_at_this_stop:
                    self.take_labelled_photo(concept_node)
                    self.shot_at_this_stop = True
            else:
                self.shot_at_this_stop = False

        if not active:
            self.verify_answered = False
            self.verify_waiting_logged = False

        if self.mission_was_active and not active and not self.session_trained:
            console.print(f"Tanda cerrada con {self.photo_counter} fotos guardadas.", style="bold cyan")
            self.stage = Stage.TRAINING
        self.mission_was_active = active

    def expected_size(self, concept_node):
        """Dimension mayor de la huella del concepto, en metros. Se prefiere la medida que publica
        la simulacion sobre el modelo real; Expected_size_m queda como reserva para cuando no
        llegue (causa no espacial, o un inner que no la publique)."""
        if "concept_size" in concept_node.attrs:
            size = [float(v) for v in concept_node.attrs["concept_size"].value]
            if len(size) == 3 and max(size[0], size[1]) > 1e-3:
                return max(size[0], size[1])
        return self.expected_size_m

    def read_bool_attr(self, node, name):
        """Booleano de un atributo del nodo, False si no esta."""
        if name not in node.attrs:
            return False
        return bool(node.attrs[name].value)

    def publish_concept_attrs(self, values):
        """Escribe atributos en el nodo del concepto: es el canal de vuelta a concept_robot."""
        node = self.g.get_node(CONCEPT_NAME)
        if node is None:
            return
        for name, value in values.items():
            node.attrs[name] = Attribute(value, self.agent_id)
        self.g.update_node(node)

    def verify_concept(self, concept_node):
        """Comprueba que el concepto esta de verdad donde dice world_position: proyecta el punto,
        segmenta con SAM en ese pixel y mide la mascara.

        Devuelve True solo si ha podido mirar y ha contestado. Si el punto todavia no esta en
        cuadro NO contesta y devuelve False: concept_robot sigue girando y se vuelve a intentar al
        ciclo siguiente. Asi un "fail" significa siempre "lo he visto y no cuadra", nunca "no
        estaba mirando"."""
        rgb, depth_m, image = self.get_current_rgbd()
        if rgb is None or depth_m is None:
            return False

        projection = self.project_world_position(concept_node, image)
        if projection is None or projection["behind"] or projection["u"] is None:
            return False

        # Dentro del encuadre con margen, no solo dentro: contestando en cuanto el punto asoma por
        # el borde la mascara sale cortada y la medida no vale. El margen es el radio aparente del
        # concepto, el mismo que usa el etiquetado.
        u, v = int(round(projection["u"])), int(round(projection["v"]))
        r_px = (self.expected_size(concept_node) / 2.0) * image.focalx / max(projection["depth_m"], 1e-3)
        margin = r_px * self.label_margin_factor
        if not (margin <= u <= image.width - margin and margin <= v <= image.height - margin):
            return False

        # Y centrado en horizontal, no solo dentro: entrando por el lateral el punto cae en la
        # esquina de abajo, el suelo se ve rasante y SAM se traga el plano entero en vez del
        # concepto. Centrado, la componente de avance es casi la distancia real y se ve de frente.
        if abs(u - image.width / 2) > image.width / 8:
            return False

        if not self.verify_waiting_logged:
            console.print(f"Concepto en cuadro en ({u}, {v}) a {projection['depth_m']:.2f} m; verificando.", style="cyan")
            self.verify_waiting_logged = True

        diag = {"verify_pixel": [float(u), float(v)]}
        best = self.best_mask_for_point(concept_node, rgb, depth_m, image, u, v, projection["depth_m"])
        if best is None:
            diag["verify_result"] = "fail"
            console.print("Verificacion NEGATIVA: ninguna mascara de SAM encaja con el concepto.", style="bold red")
        else:
            diag["verify_result"] = "ok"
            diag["verify_size_m"] = best["size_m"]
            diag["verify_depth_m"] = best["z_med"]
            diag["verify_depth_sigma"] = best["sigma"]
            console.print(f"Verificacion OK: tamaño {best['size_m']:.3f} m, profundidad "
                          f"{best['z_med']:.2f} m, sigma {best['sigma']:.3f}", style="bold green")

        self.publish_concept_attrs(diag)
        return True

    def best_mask_for_point(self, concept_node, rgb, depth_m, image, u, v, z_expected):
        """Segmenta con SAM en (u, v) y devuelve la candidata que mejor encaja con el concepto, o
        None si ninguna pasa los tres criterios. Con multimask_output SAM da hasta tres mascaras
        del mismo punto (parte / objeto / grupo) y el criterio es quien elige entre ellas."""
        try:
            if self.sam is None:
                from ultralytics import SAM   # import aqui: tarda y solo hace falta al verificar
                console.print(f"Cargando SAM desde {self.sam_weights}...", style="yellow")
                self.sam = SAM(self.sam_weights)
            # multimask_output no se puede pasar por la llamada publica: Model.predict valida los
            # kwargs contra el esquema de YOLO y lo rechaza. Se queda en una sola mascara, asi que
            # los criterios de abajo la aceptan o la rechazan en vez de elegir entre varias.
            results = self.sam(rgb, points=[[u, v]], labels=[1],
                               device=self.device_name, verbose=False)
        except Exception as e:
            console.print(f"Fallo ejecutando SAM: {e}", style="bold red")
            return None

        if not results or results[0].masks is None:
            return None

        expected = self.expected_size(concept_node)
        accepted = []
        for mask in results[0].masks.data.cpu().numpy():
            mask_uint8 = (mask > 0).astype(np.uint8)
            if mask_uint8.shape != depth_m.shape:
                mask_uint8 = cv2.resize(mask_uint8, (depth_m.shape[1], depth_m.shape[0]),
                                        interpolation=cv2.INTER_NEAREST)
            inside = depth_m[mask_uint8 > 0]
            inside = inside[np.isfinite(inside) & (inside > 0)]
            if inside.size < 20:
                continue

            # Mediana y no media: la profundidad trae ceros y valores sueltos muy lejanos.
            z_med = float(np.median(inside))
            sigma = float(np.std(inside))
            # Caja de area minima, no la alineada con los ejes: la proyeccion de un objeto en el
            # suelo visto de lado aparece girada en la imagen, y la caja vertical que la envuelve
            # llega a ser raiz(2) veces mas ancha que el objeto.
            points = cv2.findNonZero(mask_uint8)
            if points is None:
                continue
            (_, (w_px, h_px), _) = cv2.minAreaRect(points)
            size_m = max(w_px, h_px) * z_med / float(image.focalx)

            size_off = abs(size_m - expected) / expected
            dist_off = abs(z_med - z_expected) / max(z_expected, 1e-3)
            ok = (size_off <= self.verify_size_tolerance
                  and sigma <= self.verify_depth_sigma_max
                  and dist_off <= self.verify_distance_tolerance)

            console.print(f"  candidata: tamaño {size_m:.3f} m (desvio {size_off:.0%}), "
                          f"z {z_med:.2f} m (desvio {dist_off:.0%}), sigma {sigma:.3f} -> "
                          f"{'aceptada' if ok else 'descartada'}", style="cyan")
            if ok:
                accepted.append({"size_m": size_m, "z_med": z_med, "sigma": sigma, "size_off": size_off})

        if not accepted:
            return None
        return min(accepted, key=lambda c: c["size_off"])

    def get_current_rgbd(self):
        """Frame RGB y profundidad en metros del mismo instante, más el struct de imagen con las
        intrínsecas que necesita la proyección."""
        try:
            rgbd = self.camerargbdsimple_proxy.getAll(self.camera_name)
            image, depth = rgbd.image, rgbd.depth
            if not image.image or image.width <= 0 or image.height <= 0:
                return None, None, None

            rgb = np.frombuffer(bytes(image.image), dtype=np.uint8).reshape(image.height, image.width, 3)

            depth_m = None
            if depth.depth and depth.width > 0 and depth.height > 0:
                depth_m = np.frombuffer(bytes(depth.depth), dtype=np.float32).reshape(depth.height, depth.width)
                depth_m = depth_m * depth.depthFactor
                if depth_m.shape != rgb.shape[:2]:
                    depth_m = cv2.resize(depth_m, (rgb.shape[1], rgb.shape[0]), interpolation=cv2.INTER_NEAREST)

            return rgb, depth_m, image
        except Exception as e:
            console.print(f"Fallo leyendo la cámara: {e}", style="bold red")
            return None, None, None

    def get_root_to_camera_transform(self):
        """Compone la montura fija de la zed con la RT viva root->robot: transformada
        root->cámara 4x4 en metros, o None si falta algo en el grafo."""
        robot_node = self.g.get_node("robot")
        root_node = self.g.get_node("root")
        if robot_node is None or root_node is None:
            return None

        rt_edge = self.g.get_edge(root_node.id, robot_node.id, "RT")
        if rt_edge is None or "rt_translation" not in rt_edge.attrs or "rt_quaternion" not in rt_edge.attrs:
            return None

        t = rt_edge.attrs["rt_translation"].value
        translation = [float(t[1]), float(t[0]), float(t[2])]
        qx, qy, qz, qw = rt_edge.attrs["rt_quaternion"].value

        root_to_robot = _homogeneous_transform(_rotation_matrix_from_quaternion(qx, qy, qz, qw), translation)
        robot_to_camera = _homogeneous_transform(
            _rotation_matrix_from_axis_angle(ZED_MOUNT_ROTATION_AXIS, ZED_MOUNT_ROTATION_ANGLE_RAD),
            ZED_MOUNT_OFFSET_M,
        )
        return root_to_robot @ robot_to_camera

    def project_world_position(self, concept_node, image):
        """Proyecta world_position (marco root, metros) en la imagen. A diferencia de la versión
        de vision_sam devuelve también los puntos que caen fuera del encuadre: el etiquetado
        necesita distinguir "fuera de cuadro" de "no proyectable"."""
        if "world_position" not in concept_node.attrs:
            return None
        wp = concept_node.attrs["world_position"].value
        point_root_m = [float(wp[0]), float(wp[1]), float(wp[2])]

        root_to_camera = self.get_root_to_camera_transform()
        if root_to_camera is None:
            return None

        point_camera = np.linalg.inv(root_to_camera) @ np.array(
            [point_root_m[0], point_root_m[1], point_root_m[2], 1.0])

        # Webots Camera/RangeFinder/Lidar: +X forward, +Y left, +Z up (ROS-style body axes, not OpenGL -Z-forward).
        depth_m = point_camera[0]
        if depth_m <= 0:
            return {"behind": True, "u": None, "v": None, "depth_m": 0.0}

        u = image.width / 2 - image.focalx * (point_camera[1] / depth_m)
        v = image.height / 2 - image.focaly * (point_camera[2] / depth_m)
        return {"behind": False, "u": u, "v": v, "depth_m": depth_m}

    def label_for_projection(self, projection, image):
        """Etiqueta del disparo según dónde cae el concepto: dentro del encuadre con margen ->
        positivo, detrás o fuera -> negativo, a caballo del borde -> None, porque una foto con el
        concepto cortado no es ni un positivo claro ni un negativo limpio."""
        if projection["behind"]:
            return "sin_bache"

        # margin calculated based on the expected size of the concept and the focal length of the camera
        r_px = (self.expected_size_m / 2.0) * image.focalx / max(projection["depth_m"], 1e-3)
        margin = r_px * self.label_margin_factor

        u, v = projection["u"], projection["v"]
        if margin <= u <= image.width - margin and margin <= v <= image.height - margin:
            return "con_bache"
        if u < -margin or u > image.width + margin or v < -margin or v > image.height + margin:
            return "sin_bache"
        return None

    def take_labelled_photo(self, concept_node):
        """Captura el frame actual, lo etiqueta proyectando world_position y lo guarda en la
        carpeta de su etiqueta. El robot está parado y asentado cuando se llama."""
        rgb, _, image = self.get_current_rgbd()
        if rgb is None:
            console.print("Disparo descartado: sin imagen de la cámara.", style="bold red")
            return

        projection = self.project_world_position(concept_node, image)
        if projection is None:
            console.print("Disparo descartado: no se pudo proyectar world_position.", style="bold red")
            return

        label = self.label_for_projection(projection, image)
        if label is None:
            console.print("Disparo descartado: el concepto cae en el borde del encuadre.", style="yellow")
            return

        folder = os.path.join(self.photo_session_dir, label)
        os.makedirs(folder, exist_ok=True)
        path = os.path.join(folder, f"{label}_{self.photo_counter}.jpg")

        # RGB ???
        if not cv2.imwrite(path, cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR)):
            console.print(f"Disparo descartado: cv2.imwrite falló en {path}.", style="bold red")
            return
        self.photo_counter += 1

        u_txt = "" if projection["u"] is None else f"{projection['u']:.1f}"
        v_txt = "" if projection["v"] is None else f"{projection['v']:.1f}"
        console.print(f"{label} en ({u_txt}, {v_txt}) a {projection['depth_m']:.2f} m -> {path}",
                      style="green" if label.startswith("con_") else "blue")
        with open(self.photo_log_path, "a") as log:
            log.write(f"{label},{u_txt},{v_txt},{projection['depth_m']:.3f},{path}\n")

    # Concept classifier
    def run_training(self):
        """Entrena con las fotos que este agente acaba de tomar y pasa a clasificar. Un intento
        por tanda: si falla, se queda sin clasificador pero sigue publicando la RT."""
        self.session_trained = True
        if self.train_classifier(self.photo_session_dir):
            self.stage = Stage.INFERRING
        else:
            console.print("Entrenamiento fallido para esta tanda; no se reintenta.", style="bold red")
            self.stage = Stage.IDLE

    def load_backbone(self):
        """Carga DINOv3 desde el repo y los pesos locales. Importa aquí dentro para que faltar
        torch/sklearn no impida al agente seguir publicando la RT."""
        import torch

        if self.dinov3_repo not in sys.path:
            sys.path.insert(0, self.dinov3_repo)
        from dinov3.hub.backbones import dinov3_vits16

        device = "cuda" if torch.cuda.is_available() else "cpu"
        backbone = dinov3_vits16(weights=self.dinov3_weights).eval().to(device)
        console.print(f"DINOv3 cargado en {device} (embed_dim={backbone.embed_dim}, patch={backbone.patch_size})", style="green")
        return backbone, device

    def embed_image(self, rgb_array):
        """Token CLS de una imagen RGB (H, W, 3) a resolución nativa."""
        import torch
        from torchvision import transforms

        # w/h need to be multiples of the patch size
        # DINOv3 will crop the image to the largest multiple of patch_size
        patch = self.backbone.patch_size
        h = (rgb_array.shape[0] // patch) * patch
        w = (rgb_array.shape[1] // patch) * patch
        cropped = rgb_array[:h, :w, :]

        tensor = transforms.functional.to_tensor(cropped)
        tensor = transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])(tensor)
        with torch.no_grad():
            cls = self.backbone(tensor.unsqueeze(0).to(self.device))
        return cls.squeeze(0).cpu().numpy()

    def train_classifier(self, photos_dir):
        try:
            from PIL import Image
            from sklearn.linear_model import LogisticRegression
            from sklearn.model_selection import LeaveOneOut, cross_val_predict
            from sklearn.metrics import accuracy_score, confusion_matrix
        except ImportError as e:
            console.print(f"Sin dependencias para entrenar ({e}); el agente sigue publicando la RT.", style="bold red")
            return False

        try:
            self.backbone, self.device = self.load_backbone()

            features, labels = [], []
            for label, folder in ((1, "con_bache"), (0, "sin_bache")):
                for path in sorted(glob.glob(os.path.join(photos_dir, folder, "*.jpg"))):
                    features.append(self.embed_image(np.array(Image.open(path).convert("RGB"))))
                    labels.append(label)

            if len(set(labels)) < 2 or len(labels) < 4:
                console.print(f"Fotos insuficientes para entrenar ({len(labels)}).", style="bold red")
                self.backbone = None
                return False

            features, labels = np.array(features), np.array(labels)
            console.print(f"Embeddings: {features.shape} ({int(sum(labels))} con_bache, {int(len(labels) - sum(labels))} sin_bache)", style="cyan")

            # leave-one-out validation (not many photos)
            clf = LogisticRegression(max_iter=2000)
            predicted = cross_val_predict(clf, features, labels, cv=LeaveOneOut())
            console.print(f"Leave-one-out accuracy: {accuracy_score(labels, predicted) * 100:.1f}%", style="bold green")
            console.print(f"Matriz de confusión (filas=real, cols=predicho):\n{confusion_matrix(labels, predicted)}")

            clf.fit(features, labels)
            self.classifier = clf

            os.makedirs(self.model_dir, exist_ok=True)
            import joblib
            joblib.dump(clf, os.path.join(self.model_dir, "logreg.joblib"))
            console.print(f"Clasificador guardado en {self.model_dir}/logreg.joblib", style="green")
            return True

        except Exception as e:
            console.print(f"Fallo entrenando el clasificador: {e}", style="bold red")
            self.backbone = None
            self.classifier = None
            return False

    def classify_current_view(self):
        """Clasifica el frame actual de la cámara y deja el resultado en consola y en CSV."""
        try:
            rgb, _, _ = self.get_current_rgbd()
            if rgb is None:
                return

            probabilities = self.classifier.predict_proba(self.embed_image(rgb).reshape(1, -1))[0]
            label = "con_bache" if probabilities[1] >= 0.5 else "sin_bache"

            console.print(f"Vista actual: {label} (p={probabilities[1]:.3f})",
                          style="bold green" if label == "con_bache" else "bold blue")

            with open(os.path.join(self.model_dir, "inference.csv"), "a") as log:
                log.write(f"{int(time.time() * 1000)},{label},{probabilities[1]:.4f}\n")

        except Exception as e:
            console.print(f"Fallo clasificando la vista actual: {e}", style="bold red")
