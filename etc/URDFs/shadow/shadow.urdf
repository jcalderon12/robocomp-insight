<?xml version="1.0"?>
<!-- URDF de Shadow generado a partir de Shadow.proto (Webots R2023b) y BodyMesh.proto.
     Se mantienen los ejes de Webots tal cual (z arriba, la base avanza por +y, las ruedas
     estan sobre el eje x). Unidades: metros, radianes, kg. -->
<robot name="shadow">

  <material name="body_grey"><color rgba="0.871 0.867 0.855 1.0"/></material>
  <material name="black_lens"><color rgba="0.02 0.02 0.03 1.0"/></material>
  <material name="black_housing"><color rgba="0.04 0.04 0.05 1.0"/></material>
  <material name="tire"><color rgba="0.12 0.12 0.12 1.0"/></material>
  <material name="caster_grey"><color rgba="0.25 0.25 0.25 1.0"/></material>

  <!-- ===================== BASE ===================== -->
  <!-- Proyeccion en el suelo (el Robot de Webots esta a z = 0.033) -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <mass value="50"/>
      <inertia ixx="0.418086" iyy="0.166204" izz="0.55459" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="meshes/shadow.stl"/>
      </geometry>
      <material name="body_grey"/>
    </visual>
    <!-- boundingObject del proto -->
    <collision>
      <origin xyz="0 0 0.38" rpy="0 0 0"/>
      <geometry><box size="0.44 0.46 0.76"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.17 1.03" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.61"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- ===================== RUEDAS MOTRICES ===================== -->
  <!-- Radio 0.1, ancho 0.05, masa 2 kg, eje de giro (-1 0 0), anchor (+-0.259, 0, 0.067) -->
  <link name="wheel_left">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.0054167" izz="0.0054167" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="tire"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="-0.259 0 0.067" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="100" velocity="30"/>
  </joint>

  <link name="wheel_right">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01" iyy="0.0054167" izz="0.0054167" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
      <material name="tire"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0.259 0 0.067" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="100" velocity="30"/>
  </joint>

  <!-- ===================== RUEDAS LOCAS (BallJoint -> 3 joints continuos) ===================== -->
  <!-- URDF no tiene joint esferico: se emula con roll/pitch/yaw encadenados. Esfera r=0.04, masa 0.2 -->
  <link name="caster_front_roll"><inertial><mass value="0.001"/><inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="caster_front_pitch"><inertial><mass value="0.001"/><inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="caster_front">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000128" iyy="0.000128" izz="0.000128" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
  </link>
  <joint name="caster_front_roll_joint" type="continuous">
    <parent link="base_link"/><child link="caster_front_roll"/>
    <origin xyz="0 0.18 0.007" rpy="0 0 0"/><axis xyz="1 0 0"/>
  </joint>
  <joint name="caster_front_pitch_joint" type="continuous">
    <parent link="caster_front_roll"/><child link="caster_front_pitch"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="caster_front_yaw_joint" type="continuous">
    <parent link="caster_front_pitch"/><child link="caster_front"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <link name="caster_back_roll"><inertial><mass value="0.001"/><inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="caster_back_pitch"><inertial><mass value="0.001"/><inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="caster_back">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000128" iyy="0.000128" izz="0.000128" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.04"/></geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.04"/></geometry>
    </collision>
  </link>
  <joint name="caster_back_roll_joint" type="continuous">
    <parent link="base_link"/><child link="caster_back_roll"/>
    <origin xyz="0 -0.18 0.007" rpy="0 0 0"/><axis xyz="1 0 0"/>
  </joint>
  <joint name="caster_back_pitch_joint" type="continuous">
    <parent link="caster_back_roll"/><child link="caster_back_pitch"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="caster_back_yaw_joint" type="continuous">
    <parent link="caster_back_pitch"/><child link="caster_back"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== IMU (Accelerometer + Gyro en el origen del robot) ===================== -->
  <link name="imu"/>
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ZED (Camera 1280x720, fov 1.9198 + RangeFinder "zed-ranger") ===================== -->
  <link name="zed"/>
  <joint name="base_link_to_zed" type="fixed">
    <parent link="base_link"/>
    <child link="zed"/>
    <origin xyz="0 -0.075 0.945" rpy="0 0 1.57"/>
  </joint>
  <!-- RangeFinder hijo de la camara, misma pose -->
  <link name="zed_ranger"/>
  <joint name="zed_to_zed_ranger" type="fixed">
    <parent link="zed"/>
    <child link="zed_ranger"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== RICOH THETA: 2 camaras 960x960, fov 3.14, cilindricas ===================== -->
  <!-- camera_360_2: rotation 0 0 1 -pi/2 -->
  <link name="camera_360_2"/>
  <joint name="base_link_to_camera_360_2" type="fixed">
    <parent link="base_link"/>
    <child link="camera_360_2"/>
    <origin xyz="0 -0.17 1.275" rpy="0 0 -1.5707953"/>
  </joint>

  <!-- camera_360_1: rotation 0 0 -1 -pi/2  (= +pi/2 sobre z). Lleva las dos lentes (+-0.0115 en x local) -->
  <link name="camera_360_1">
    <visual>
      <origin xyz="0.0115 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0105"/></geometry>
      <material name="black_lens"/>
    </visual>
    <visual>
      <origin xyz="-0.0115 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0105"/></geometry>
      <material name="black_lens"/>
    </visual>
  </link>
  <joint name="base_link_to_camera_360_1" type="fixed">
    <parent link="base_link"/>
    <child link="camera_360_1"/>
    <origin xyz="0 -0.17 1.275" rpy="0 0 1.5708053"/>
  </joint>

  <!-- ===================== HELIOS (RS-Helios H32F70), montado invertido ===================== -->
  <!-- Webots: rotation 1 1 0 pi  ==  Rz(+90) * Rx(180)  ->  rpy = (pi, 0, pi/2) -->
  <link name="helios">
    <visual>
      <origin xyz="-0.0125 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
      <material name="black_housing"/>
    </visual>
  </link>
  <joint name="base_link_to_helios" type="fixed">
    <parent link="base_link"/>
    <child link="helios"/>
    <origin xyz="0 -0.155 1.075" rpy="3.14159265359 0 1.5707963268"/>
  </joint>

  <!-- ===================== BPEARL (invertido) ===================== -->
  <!-- Webots: rotation -1 -1 0 pi  ->  misma matriz que helios: rpy = (pi, 0, pi/2) -->
  <link name="bpearl">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="black_housing"/>
    </visual>
  </link>
  <joint name="base_link_to_bpearl" type="fixed">
    <parent link="base_link"/>
    <child link="bpearl"/>
    <origin xyz="0 0.14 0.67" rpy="3.14159265359 0 1.5707963268"/>
  </joint>

</robot>
