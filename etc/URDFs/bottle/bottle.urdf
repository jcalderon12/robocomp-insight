<?xml version="1.0"?>
<robot name="bottle">
    <material name="blue">
        <color rgba="0 0.3 0.7 1"/>
    </material>
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="bottle.stl" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="bottle.stl" scale="1 1 1"/>
            </geometry>
        </collision>
        <!-- The MedicineBottle of the Webots world: its Physics has the default density (1000 kg/m^3),
             so Webots derives 0.183 kg from the bounding cylinders. The inertia is that of this mesh
             (its centre of mass is the origin) at that mass; Webots gives 1.69e-4 and 5.48e-5. -->
        <inertial>
            <mass value="0.183"/>
            <inertia ixx="1.664e-4" ixy="0.0" ixz="0.0" iyy="1.664e-4" iyz="0.0" izz="5.45e-5"/>
            <origin xyz="0 0 0"/>
        </inertial>
    </link>
</robot>